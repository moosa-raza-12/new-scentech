<script>
window.__kvInterrupterProducts = {};
{% for block in section.blocks %}
  {% if block.type == 'interrupter' %}
    (function(){
      var prods = [];
      {% if block.settings.cta_product_1 != blank %}
        {% assign _ip = all_products[block.settings.cta_product_1] %}
        {% if _ip != blank %}
        prods.push({ id:'{{ _ip.id }}', handle:'{{ _ip.handle }}', variantId:'{{ _ip.selected_or_first_available_variant.id }}', variantPrice:'{{ _ip.selected_or_first_available_variant.price }}', compareAtPrice:'{{ _ip.selected_or_first_available_variant.compare_at_price }}', title:{{ _ip.title | json }}, image:'{{ _ip.featured_image | image_url: width: 600 }}', inventoryDate:'{{ _ip.metafields.custom.inventory_stock_date }}', inventoryQty:{{ _ip.selected_or_first_available_variant.inventory_quantity | default: 0 }} });
        {% endif %}
      {% endif %}
      {% if block.settings.cta_product_2 != blank %}
