{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --product-grid: auto / minmax(0, 1fr);
    --product-gallery-media-list-grid: auto / auto-flow {% if section.settings.mobile_carousel_control == 'free_scroll' %}{% if section.settings.mobile_media_size == 'expanded' %}84vw{% else %}73vw{% endif %}{% else %}100%{% endif %};
    --product-gallery-media-list-gap: {% if section.settings.mobile_media_size == 'expanded' %}var(--spacing-0-5){% else %}var(--grid-gutter){% endif %};
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      --section-spacing-block-start: {% if section.settings.mobile_media_size == 'expanded' %}0px{% else %}var(--container-gutter){% endif %};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
    {%- assign media_ratio = section.settings.desktop_media_width | divided_by: 50.0 -%}
      --product-grid: auto / minmax(0, {{ media_ratio }}fr) minmax(0, {{ 2.0 | minus: media_ratio }}fr);
      --product-gallery-media-list-grid: {% if section.settings.desktop_media_layout contains 'grid' %}auto-flow dense / repeat(2, minmax(0, 1fr)){% else %}auto / auto-flow 100%{% endif %};
      --product-gallery-media-list-gap: calc(var(--grid-gutter) / 2);
    }

  {%- if section.settings.desktop_media_layout == 'grid_highlight' -%}
    #shopify-section-{{ section.id }} .product-gallery__media-list > :not([hidden]) {
      grid-column: span 2;
    }

    #shopify-section-{{ section.id }} .product-gallery__media-list > :not([hidden]) ~ *:not(.product-gallery__media--expand) {
      grid-column: span 1;
    }
  {%- endif -%}
  }

  @media screen and (min-width: 1400px) {
    #shopify-section-{{ section.id }} {
      --product-gallery-media-list-gap: var(--grid-gutter);
    }
  }
</style>

{{- 'product-block.css' | asset_url | stylesheet_tag: preload: true -}}

<div {% render 'section-properties', tight: true %}>
  {%- capture product_form_id -%}featured-product-form-{{ section.id }}{%- endcapture -%}

  <product-rerender id="featured-product-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender>
    <div class="product">
      {%- if section.settings.product != blank -%}
        {%- if section.settings.product.media.size > 0 -%}
          {%- render 'product-gallery', product: section.settings.product, product_form_id: product_form_id -%}
        {%- endif -%}

        {%- render 'product-info', 
          product: section.settings.product, 
          product_form_id: product_form_id, 
          update_url: false,
          context: 'featured_product'
        -%}
      {%- else -%}
        <product-gallery form="placeholder-{{ section.id }}" class="product-gallery {% if section.settings.mobile_carousel_control contains 'dots' %}product-gallery--mobile-dots{% endif %} {% if section.settings.desktop_media_layout contains 'grid' %}product-gallery--desktop-grid{% else %}product-gallery--desktop-carousel{% endif %} {% if section.settings.desktop_media_layout == 'carousel_thumbnails_left' %}product-gallery--desktop-thumbnails-left{% endif %} {% if section.settings.mobile_media_size == 'expanded' %}product-gallery--mobile-expanded{% endif %}">
          <div class="product-gallery__ar-wrapper">
            <div class="product-gallery__media-list-wrapper">

              <media-carousel desktop-mode="{{ section.settings.desktop_media_layout }}" adaptive-height class="product-gallery__media-list {% if section.settings.mobile_media_size == 'expanded' %}full-bleed{% else %}bleed{% endif %} scroll-area md:unbleed">
                <div class="product-gallery__media {% if section.settings.mobile_carousel_control != 'free_scroll' %}snap-center{% endif %}">
                  {{- 'product-1' | placeholder_svg_tag: 'placeholder rounded' -}}
                </div>
              </media-carousel>
            </div>
          </div>
        </product-gallery>

        <safe-sticky class="product-info">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'vendor' -%}
                <div class="product-info__vendor" {{ block.shopify_attributes }}>{{- 'general.on_boarding.product_vendor' | t -}}</div>

              {%- when 'title' -%}
                <h2 class="product-info__title {{ block.settings.heading_tag }}" {{ block.shopify_attributes }}>{{ 'general.on_boarding.product_title' | t }}</h2>

              {%- when 'price' -%}
                <div class="product-info__price">
                  <price-list class="price-list price-list--lg">
                    <sale-price class="text-lg">{{ 4000 | money }}</sale-price>
                  </price-list>
                </div>

    
                {%- when 'product_link_picker' -%}
      <div class="product-switch-wrapper" data-current-product="{{ all_products[block.settings.product_1].handle }}">
        <div class="product-switch" {{ block.shopify_attributes }}>
          <a href="#" 
            class="switch-option active"
            data-target-product="{{ all_products[block.settings.product_1].handle }}">
            <span>{{ block.settings.label_1 | default: 'Bike' }}</span>
            {% if block.settings.subtitle_1 != blank %}
              <span class="switch-subtitle">{{ block.settings.subtitle_1 }}</span>
            {% endif %}
          </a>

          <a href="#" 
            class="switch-option"
            data-target-product="{{ all_products[block.settings.product_2].handle }}">
            <span>{{ block.settings.label_2 | default: 'Bike+' }}</span>
            {% if block.settings.subtitle_2 != blank %}
              <span class="switch-subtitle">{{ block.settings.subtitle_2 }}</span>
            {% endif %}
          </a>

          <div class="switch-slider"></div>
        </div>
      </div>

      <div class="product-switcher-container" data-active-product="{{ all_products[block.settings.product_1].handle }}">
        <div class="product-option" data-product="{{ all_products[block.settings.product_1].handle }}">
          {%- render 'product-content', product: all_products[block.settings.product_1] -%}
        </div>
        
        <div class="product-option" data-product="{{ all_products[block.settings.product_2].handle }}">
          {%- render 'product-content', product: all_products[block.settings.product_2] -%}
        </div>
      </div>

                {%- when 'compare_models' -%}
  <div class="compare-models-wrapper" {{ block.shopify_attributes }}>
    <button 
      type="button"
      id="compare-btn-{{ block.id }}"
      class="compare-trigger-link"
      aria-label="Compare models">
      <span>{{ block.settings.button_text | default: 'Compare Models' }}</span>
    </button>

    <div id="compare-modal-{{ block.id }}" class="compare-modal" style="display: none;" aria-hidden="true">
      <div class="compare-modal__backdrop"></div>
      <div class="compare-modal__content">
        <button class="compare-modal__close" aria-label="Close modal" type="button">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        
        <div class="compare-modal__header">
          <h2 class="h3">{{ block.settings.modal_title | default: 'Compare Models' }}</h2>
        </div>
        
        <div class="compare-modal__grid">
          <div class="compare-column">
            <div class="product-header">
              <h3 class="product-title">{{ block.settings.model1_title | default: 'Model 1' }}</h3>
              <p class="product-subtitle">{{ block.settings.model1_subtitle }}</p>
            </div>

            {% if block.settings.model1_main_image != blank %}
              <div class="product-image">
                <img 
                  src="{{ block.settings.model1_main_image | image_url: width: 300 }}"
                  alt="{{ block.settings.model1_title | default: 'Model 1' }}"
                  loading="lazy">
              </div>
            {% endif %}

            {% if block.settings.model1_price != blank or block.settings.model1_price_detail != blank %}
              <div class="product-pricing">
                {% if block.settings.model1_price != blank %}
                  <div class="price-main">{{ block.settings.model1_price }}</div>
                {% endif %}
                {% if block.settings.model1_price_detail != blank %}
                  <div class="price-detail">{{ block.settings.model1_price_detail }}</div>
                {% endif %}
              </div>
            {% endif %}

            <div class="feature-rows">
              {% for i in (1..8) %}
                {% assign icon_key = 'model1_feature' | append: i | append: '_icon' %}
                {% assign title_key = 'model1_feature' | append: i | append: '_title' %}
                {% assign desc_key = 'model1_feature' | append: i | append: '_description' %}
                
                {% if block.settings[title_key] != blank or block.settings[desc_key] != blank %}
                  <div class="feature-row">
                    {% if block.settings[icon_key] != blank %}
                      <div class="feature-icon">
                        <img 
                          src="{{ block.settings[icon_key] | image_url: width: 60 }}" 
                          alt="Feature icon"
                          width="40" 
                          height="40">
                      </div>
                    {% endif %}
                    
                    <div class="feature-content">
                      {% if block.settings[title_key] != blank %}
                        <h4 class="feature-title">{{ block.settings[title_key] }}</h4>
                      {% endif %}
                      {% if block.settings[desc_key] != blank %}
                        <p class="feature-description">{{ block.settings[desc_key] }}</p>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <div class="compare-column">
            <div class="product-header">
              <h3 class="product-title">{{ block.settings.model2_title | default: 'Model 2' }}</h3>
              <p class="product-subtitle">{{ block.settings.model2_subtitle }}</p>
            </div>

            {% if block.settings.model2_main_image != blank %}
              <div class="product-image">
                <img 
                  src="{{ block.settings.model2_main_image | image_url: width: 300 }}"
                  alt="{{ block.settings.model2_title | default: 'Model 2' }}"
                  loading="lazy">
              </div>
            {% endif %}

            {% if block.settings.model2_price != blank or block.settings.model2_price_detail != blank %}
              <div class="product-pricing">
                {% if block.settings.model2_price != blank %}
                  <div class="price-main">{{ block.settings.model2_price }}</div>
                {% endif %}
                {% if block.settings.model2_price_detail != blank %}
                  <div class="price-detail">{{ block.settings.model2_price_detail }}</div>
                {% endif %}
              </div>
            {% endif %}

            <div class="feature-rows">
              {% for i in (1..8) %}
                {% assign icon_key = 'model2_feature' | append: i | append: '_icon' %}
                {% assign title_key = 'model2_feature' | append: i | append: '_title' %}
                {% assign desc_key = 'model2_feature' | append: i | append: '_description' %}
                
                {% if block.settings[title_key] != blank or block.settings[desc_key] != blank %}
                  <div class="feature-row">
                    {% if block.settings[icon_key] != blank %}
                      <div class="feature-icon">
                        <img 
                          src="{{ block.settings[icon_key] | image_url: width: 60 }}" 
                          alt="Feature icon"
                          width="40" 
                          height="40">
                      </div>
                    {% endif %}
                    
                    <div class="feature-content">
                      {% if block.settings[title_key] != blank %}
