          {% if section.blocks.size > 0 %}
              {%- comment -%}
                Build exclusion list of product handles used in interrupter blocks.
                Only single-product interrupters exclude their product from the grid.
                Bundle interrupters (>= 2 products) keep showing their products in the
                grid as well, so each scent in the bundle remains individually purchasable.
              {%- endcomment -%}
              {% assign kv_intr_excluded = '' %}
              {% for block in section.blocks %}
                {% if block.type == 'interrupter' and block.settings.enabled %}
                  {% assign kv_intr_product_count = 0 %}
