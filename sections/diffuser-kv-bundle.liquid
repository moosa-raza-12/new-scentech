                        </svg>                          
                          <span>{{ section.settings.progress_empty_text | default: "Learn more about our diffusers" }}</span>
                      </div>
                  </div>
  
                </div>
              </div>
            </div>
          </div>
      </div>

      {%- comment -%} Promotional Banner {%- endcomment -%}
      {% if section.settings.promo_banner_enabled %}
      <div class="kv-promo-banner" {% if section.settings.promo_banner_image %}style="background-image: url({{ section.settings.promo_banner_image | image_url: width: 1920 }});"{% endif %}>
        <div class="kv-promo-banner-inner">
          <p class="kv-promo-banner-text">
            {% if section.settings.promo_banner_bold_text != blank %}
              <strong>{{ section.settings.promo_banner_bold_text }}</strong>
            {% endif %}
           {{ section.settings.promo_banner_text }}
          </p>
        </div>
      </div>
      {% endif %}
      
      <div class="kv-bundle-collection">
          <div class="kv-bundle-collection-inner">
          {% if section.blocks.size > 0 %}
              {%- comment -%} Tab Navigation {%- endcomment -%}
              <div class="kv-bundle-tabs">
              <button class="kv-bundle-tab" data-tab="all" style="display:none;">
                  All <span id="kv-total-count"> 0</span>
              </button>
              {% for block in section.blocks %}
                  {% if block.settings.collection != blank %}
                  {% assign collection = collections[block.settings.collection] %}
                  <button class="kv-bundle-tab{% if forloop.first %} active{% endif %}" data-tab="{{ block.id }}">
                      {{ collection.title }}
                  </button>
                  {% endif %}
              {% endfor %}
              </div>
  
            {%- comment -%} All Products Tab (hidden) {%- endcomment -%}
            <div class="kv-bundle-tab-content" data-content="all" style="display:none !important;">
            <div class="kv-bundle-products-grid">
                {% assign total_products = 0 %}
                {% assign kv_card_index = 0 %}
                {% assign kv_rendered_interrupters_desktop = '' %}
                {% assign kv_rendered_interrupters_mobile = '' %}

                {%- comment -%} Interrupter blocks (before first product) {%- endcomment -%}
                {% for intr in section.blocks %}
                  {% if intr.type == 'interrupter' and intr.settings.enabled %}
                    {% assign intr_token = '|' | append: intr.id | append: '|' %}

                    {% if intr.settings.show_on_desktop and intr.settings.position_desktop == kv_card_index %}
                      {% unless kv_rendered_interrupters_desktop contains intr_token %}
                        <div
                          class="kv-bundle-interrupter-card kv-bundle-interrupter-card--desktop{% if intr.settings.desktop_layout == 'stacked' %} kv-bundle-interrupter-card--stacked{% endif %}{% if intr.settings.desktop_layout != 'stacked' and intr.settings.image_position == 'right' %} kv-bundle-interrupter-card--image-right{% endif %}"
                          style="--kv-interrupter-bg: {{ intr.settings.background_color }}; --kv-interrupter-border: {{ intr.settings.border_color }}; --kv-interrupter-radius: {{ intr.settings.border_radius }}px; --kv-interrupter-padding: {{ intr.settings.padding }}px; --kv-interrupter-title-color: {{ intr.settings.title_color }}; --kv-interrupter-title-size: {{ intr.settings.title_size }}px; --kv-interrupter-text-color: {{ intr.settings.text_color }}; --kv-interrupter-text-size: {{ intr.settings.text_size }}px; --kv-interrupter-cta-bg: {{ intr.settings.cta_bg }}; --kv-interrupter-cta-text: {{ intr.settings.cta_text_color }}; --kv-interrupter-cta-border: {{ intr.settings.cta_border_color }}; --kv-interrupter-cta-radius: {{ intr.settings.cta_radius }}px; --kv-interrupter-image-width: {{ intr.settings.image_width_percent }}%; --kv-interrupter-image-fit: {{ intr.settings.image_fit }}; --kv-interrupter-image-height-desktop: {{ intr.settings.image_height_desktop }}px; --kv-interrupter-image-height-mobile: {{ intr.settings.image_height_mobile }}px; --kv-interrupter-badge-bg: {{ intr.settings.badge_bg }}; --kv-interrupter-badge-text: {{ intr.settings.badge_text_color }};"
                          {{ intr.shopify_attributes }}
                        >
                          <div class="kv-bundle-interrupter-media">
                            {% if intr.settings.image != blank %}
                              <img
                                src="{{ intr.settings.image | image_url: width: 900 }}"
                                alt="{{ intr.settings.heading | escape }}"
                                loading="lazy"
                                width="900"
                                height="900"
                              >
                            {% endif %}
                            {% if intr.settings.badge_text != blank %}
                              <div class="kv-bundle-interrupter-badge">{{ intr.settings.badge_text }}</div>
                            {% endif %}
                          </div>
                          {% assign intr_atc_product = all_products[intr.settings.cta_product] %}
                          <div class="kv-bundle-interrupter-content">
                            {% if intr.settings.heading != blank %}
                              <div class="kv-bundle-interrupter-title">{{ intr.settings.heading }}  <button class="kv-bundle-product-info-icon kv-scent-info-btn"
                              type="button"
                              aria-label="View details"
                              data-product-id="{{ intr_atc_product.id }}"
                              data-product-title="{{ intr_atc_product.title | escape }}"
                              data-product-description="{{ intr_atc_product.metafields.custom.scent_popup_description | default: intr_atc_product.description | strip_html | strip | escape }}"
                              data-product-details="{{ intr_atc_product.metafields.custom.scent_details | escape }}"
                              data-product-image="{% if intr_atc_product.metafields.custom.scent_image %}{{ intr_atc_product.metafields.custom.scent_image | image_url: width: 1200 }}{% elsif intr_atc_product.featured_image %}{{ intr_atc_product.featured_image | image_url: width: 1200 }}{% endif %}"
                              data-product-variant="{{ intr_atc_product.metafields.custom.quantity_value | default: intr_atc_product.variants.first.title | escape }}"
                              data-product-badge="{{ intr_atc_product.metafields.custom.collection_card_badge | escape }}">
                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M7 13.125C10.3827 13.125 13.125 10.3827 13.125 7C13.125 3.61726 10.3827 0.875 7 0.875C3.61726 0.875 0.875 3.61726 0.875 7C0.875 10.3827 3.61726 13.125 7 13.125Z" stroke="#160000" stroke-width="0.875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M6.99121 4.375C6.99121 4.375 6.99317 4.375 6.99559 4.375C6.998 4.375 6.99996 4.375 6.99996 4.375" stroke="#160000" stroke-width="0.875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M7 6.125V9.625" stroke="#160000" stroke-width="0.875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button> </div>
                            {% endif %}
                            {% if intr.settings.description != blank %}
                              <div class="kv-bundle-interrupter-text">{{ intr.settings.description }}</div>
                            {% endif %}
                            {% if intr.settings.show_cta and intr.settings.cta_label != blank and intr.settings.cta_product != blank %}
                              {% if intr_atc_product != blank %}
                                <button class="kv-bundle-interrupter-cta kv-interrupter-add-to-cart" type="button"
                                  data-product-id="{{ intr_atc_product.id }}"
                                  data-product-handle="{{ intr_atc_product.handle }}"
                                  data-variant-id="{{ intr_atc_product.selected_or_first_available_variant.id }}"
                                  data-variant-price="{{ intr_atc_product.selected_or_first_available_variant.price }}"
                                  data-variant-compare-at-price="{{ intr_atc_product.selected_or_first_available_variant.compare_at_price }}"
                                  data-product-title="{{ intr_atc_product.title | escape }}"
                                  data-product-image="{{ intr_atc_product.featured_image | image_url: width: 600 }}"
                                  data-inventory-date="{{ intr_atc_product.metafields.custom.inventory_stock_date }}"
                                  data-inventory-quantity="{{ intr_atc_product.selected_or_first_available_variant.inventory_quantity | default: 0 }}"
                                  data-quantity="{{ intr.settings.cta_default_quantity | default: 1 }}">
                                  {{ intr.settings.cta_label }}
                                </button>
                              {% endif %}
                            {% endif %}
                          </div>
