            }
          }
        } catch (error) {
          // Silently fail if date parsing has issues
          console.error('Error parsing product inventory date:', error);
        }
        
        itemDiv.innerHTML = `
          <img src="${product.image.replace('width=600', 'width=160')}" alt="${product.title}" class="kv-mini-cart-item-image">
          <div class="kv-mini-cart-item-details">
            <div class="kv-mini-cart-item-title">${product.title}</div>
            <div class="kv-mini-cart-item-price">${priceDisplay}</div>
            ${subtotalDisplay}
            ${inventoryDateDisplay}
          </div>
          <div class="kv-mini-cart-item-qty-controls">
              <button class="kv-mini-cart-qty-btn kv-mini-cart-qty-decrease" data-index="${index}" type="button" aria-label="Decrease quantity">−</button>
              <span class="kv-mini-cart-qty-value">${product.quantity}</span>
              <button class="kv-mini-cart-qty-btn kv-mini-cart-qty-increase" data-index="${index}" type="button" aria-label="Increase quantity">+</button>
