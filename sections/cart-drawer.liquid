<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  /* Quantity +/- button handler for kv-cart (event-delegated so it survives AJAX DOM replacement) */
  (function() {
    var drawer = document.getElementById('cart-drawer');
    if (!drawer) return;
    drawer.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-kv-qty-action]');
      if (!btn) return;
      var wrap = btn.closest('.kv-cart__qty-wrap');
      if (!wrap) return;
      var input = wrap.querySelector('input[is="quantity-input"]');
      if (!input) return;
      var current = parseInt(input.value) || 1;
      if (btn.getAttribute('data-kv-qty-action') === 'decrease') {
        if (current <= 1) {
          /* Remove item from cart when quantity goes to 0 */
          var lineKey = input.getAttribute('data-line-key');
          if (lineKey) {
            fetch('/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ id: lineKey, quantity: 0 })
            })
            .then(function(r) { return r.json(); })
            .then(function() {
              document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            });
          }
          return;
        }
        input.quantity = current - 1;
      } else {
        input.quantity = current + 1;
      }
      input.dispatchEvent(new Event('change', { bubbles: true }));
    });

    /* AJAX add-to-cart for "Add Something Extra" cards */
    drawer.addEventListener('submit', function(e) {
      var form = e.target.closest('.kv-extra__card-form');
      if (!form) return;
      e.preventDefault();
      var addBtn = form.querySelector('.kv-extra__card-add-btn');
      if (!addBtn || addBtn.disabled) return;
      addBtn.disabled = true;
      addBtn.textContent = 'Adding…';

      var formData = new FormData(form);
      var body = JSON.stringify({
        id: Number(formData.get('id')),
        quantity: Number(formData.get('quantity'))
      });

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: body
      })
      .then(function(r) { return r.json(); })
      .then(function() {
        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      })
      .catch(function() {
        addBtn.disabled = false;
        addBtn.textContent = '+ Add';
      });
    });

    /* ---- Swiper slider for "Add Something Extra" ----
       Robust version: the cart-drawer's inner HTML is replaced wholesale on every
       AJAX cart update (qty +/-, add, remove, etc.), so we cannot rely on a closure
       reference to the previous Swiper instance — that element is detached.

       Strategy:
         1. Use the live `.kv-extra__swiper` element's own state (`.swiper` property +
            `swiper-initialized` class) as the source of truth.
         2. Re-init whenever a NEW `.kv-extra__swiper` element appears in the drawer
            (via mutation `addedNodes`) — this ignores Swiper's own internal mutations.
         3. Also re-check on `cart:refresh`, on qty button clicks, and on native
            `quantity-input` `change` events so every cart update is covered.
    */
    var SWIPER_OPTS = {
      slidesPerView: 'auto',
      spaceBetween: 10,
      grabCursor: true,
      slideClass: 'kv-extra__card',
      wrapperClass: 'kv-extra__track',
      resistance: true,
      resistanceRatio: 0.85,
      observer: false,
      observeParents: false,
      observeSlideChildren: false,
      slidesPerGroup: 1,
      speed: 400,
      touchRatio: 1,
      threshold: 5
    };

    function ensureSwiper() {
      var container = drawer.querySelector('.kv-extra__swiper');
      if (!container) return;

      /* If this exact element already has a live Swiper, nothing to do. */
      if (container.swiper && container.classList.contains('swiper-initialized')) {
        try { container.swiper.update(); } catch (e) {}
        return;
      }

      /* Defensively kill a stale instance attached to a detached element. */
      if (container.swiper) {
        try { container.swiper.destroy(true, true); } catch (e) {}
      }

      try {
        new Swiper(container, SWIPER_OPTS);
      } catch (e) {
        console.error('kv-extra swiper init error:', e);
      }
    }

    /* Defer to next frame so the new DOM has finished being inserted/laid out. */
    var pendingFrame = null;
    function scheduleEnsure() {
      if (pendingFrame) return;
      pendingFrame = requestAnimationFrame(function() {
        pendingFrame = null;
        ensureSwiper();
      });
    }

    scheduleEnsure();

    /* Re-init only when a fresh `.kv-extra__swiper` element is INSERTED.
       This ignores attribute/class/style mutations that Swiper makes to itself,
       so the observer never re-triggers itself in a loop. */
    var drawerObserver = new MutationObserver(function(mutations) {
      for (var i = 0; i < mutations.length; i++) {
        var added = mutations[i].addedNodes;
        for (var j = 0; j < added.length; j++) {
          var node = added[j];
          if (node.nodeType !== 1) continue;
          if (
            (node.classList && node.classList.contains('kv-extra__swiper')) ||
            (node.querySelector && node.querySelector('.kv-extra__swiper'))
          ) {
            scheduleEnsure();
            return;
          }
        }
      }
    });
    drawerObserver.observe(drawer, { childList: true, subtree: true });

    /* Re-check whenever the drawer is opened. */
    var attrObserver = new MutationObserver(function() {
      if (drawer.hasAttribute('open') || drawer.classList.contains('is-open')) {
        scheduleEnsure();
      }
    });
    attrObserver.observe(drawer, { attributes: true, attributeFilter: ['open', 'class', 'aria-hidden'] });

    /* Manual cart:refresh events dispatched by our own handlers above. */
    document.addEventListener('cart:refresh', scheduleEnsure);
    document.documentElement.addEventListener('cart:refresh', scheduleEnsure);

    /* The standard Impact qty +/- flow does NOT emit cart:refresh — it just lets
       <quantity-input> hit /cart/change.js and then <cart-drawer> swaps its inner
       HTML. Hook into the events that lead to that swap so we re-init on the next
       tick after the new HTML is in place. */
    drawer.addEventListener('click', function(e) {
      if (e.target.closest('[data-kv-qty-action]')) {
        /* The DOM swap happens after the network round-trip; poll a few times. */
        setTimeout(scheduleEnsure, 250);
        setTimeout(scheduleEnsure, 800);
      }
    });
    drawer.addEventListener('change', function(e) {
      var t = e.target;
      if (t && t.matches && t.matches('input[is="quantity-input"]')) {
        setTimeout(scheduleEnsure, 250);
        setTimeout(scheduleEnsure, 800);
      }
    });

  })();
</script>

<script>
  /* Protection toggle — both buttons always visible, checkbox only controls
     which cart attributes are sent (protection on/off) */
  (function() {
    var drawer = document.getElementById('cart-drawer');
    if (!drawer) return;

    function initProtectionToggle() {
      var checkbox = drawer.querySelector('#kv-protection-checkbox');
      if (!checkbox) return;

      checkbox.addEventListener('change', function() {
        /* Update cart attribute so the checkout knows whether protection is selected */
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: { 'Protection': checkbox.checked ? 'Yes' : 'No' } })
        });
      });
    }

    initProtectionToggle();

    /* Re-init after AJAX cart refresh */
    var protectionObserver = new MutationObserver(function() {
      setTimeout(initProtectionToggle, 200);
    });
    protectionObserver.observe(drawer, { childList: true, subtree: true });
  })();
</script>

<script>
  /* Dynamic Protection Display — Update protection toggle and prices based on cart value */
  (function() {
    var drawer = document.getElementById('cart-drawer');
    if (!drawer) return;

    function updateProtectionDisplay() {
      var wrapper = drawer.querySelector('.kv-cart__checkout-buttons');
      if (!wrapper) return;

      var lowCartThreshold = parseInt(wrapper.getAttribute('data-low-cart-threshold')) || 0;
      var protectionPrice = parseInt(wrapper.getAttribute('data-protection-price')) || 0;
      var lowCartPrice = parseInt(wrapper.getAttribute('data-low-cart-price')) || 0;
      var lowCartVariantId = wrapper.getAttribute('data-low-cart-variant-id');
      
      var protectionTitle = wrapper.getAttribute('data-protection-title') || '';
      var lowCartTitle = wrapper.getAttribute('data-low-cart-title') || '';
      var protectionDesc = wrapper.getAttribute('data-protection-desc') || '';
      var lowCartDesc = wrapper.getAttribute('data-low-cart-desc') || '';

      /* Fetch current cart to check total */
      fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          var isLowCart = lowCartVariantId && cart.total_price < lowCartThreshold;
          var activePrice = isLowCart ? lowCartPrice : protectionPrice;
          var activeTitle = isLowCart ? lowCartTitle : protectionTitle;
          var activeDesc = isLowCart ? lowCartDesc : protectionDesc;

          /* Update protection toggle elements */
          var titleEl = drawer.querySelector('#kv-protection-title');
          var priceEl = drawer.querySelector('#kv-protection-price');
          var descEl = drawer.querySelector('#kv-protection-desc');

          if (titleEl) titleEl.textContent = activeTitle;
          if (descEl) descEl.textContent = activeDesc;
          
          /* Format price */
          if (priceEl && activePrice) {
            var formattedPrice = Shopify.formatMoney(activePrice, window.theme.moneyFormat || '${{amount}}');
            priceEl.textContent = formattedPrice;
          }

          /* Update checkout button price */
          var priceWithProtection = drawer.querySelector('#kv-price-with-protection');
          var originalPriceWithProtection = drawer.querySelector('#kv-original-price-with-protection');
          
          if (priceWithProtection) {
            var totalWithProtection = cart.total_price + activePrice;
            var formattedTotal = Shopify.formatMoney(totalWithProtection, window.theme.moneyFormat || '${{amount}}');
            priceWithProtection.textContent = formattedTotal;
          }
          
          if (originalPriceWithProtection && cart.total_discount > 0) {
            var originalTotalWithProtection = cart.original_total_price + activePrice;
            var formattedOriginalTotal = Shopify.formatMoney(originalTotalWithProtection, window.theme.moneyFormat || '${{amount}}');
            originalPriceWithProtection.textContent = formattedOriginalTotal;
          }
        })
        .catch(function(err) {
          console.error('Error updating protection display:', err);
        });
    }

    /* Update on drawer open */
    var attrObserver = new MutationObserver(function() {
      if (drawer.hasAttribute('open') || drawer.classList.contains('is-open')) {
        setTimeout(updateProtectionDisplay, 100);
      }
    });
    attrObserver.observe(drawer, { attributes: true, attributeFilter: ['open', 'class', 'aria-hidden'] });

    /* Update after cart changes */
    document.addEventListener('cart:refresh', function() {
      setTimeout(updateProtectionDisplay, 300);
    });
    document.documentElement.addEventListener('cart:refresh', function() {
      setTimeout(updateProtectionDisplay, 300);
    });

    /* Initial update */
    setTimeout(updateProtectionDisplay, 200);
  })();
</script>

<script>
  /* Checkout buttons — Secure Checkout adds protection product (or low cart product if under threshold) then redirects,
     Checkout Without Protection just redirects to checkout */
  (function() {
    var drawer = document.getElementById('cart-drawer');
    if (!drawer) return;

    function initCheckoutButtons() {
      var btnSecure  = drawer.querySelector('#kv-checkout-secure');
      var btnWithout = drawer.querySelector('#kv-checkout-without');
      var wrapper    = drawer.querySelector('.kv-cart__checkout-buttons');
      var protectionVariantId = wrapper ? wrapper.getAttribute('data-protection-variant-id') : null;
      var lowCartVariantId = wrapper ? wrapper.getAttribute('data-low-cart-variant-id') : null;
      var lowCartThreshold = wrapper ? parseInt(wrapper.getAttribute('data-low-cart-threshold')) : 0;

      if (btnSecure && !btnSecure.dataset.kvBound) {
        btnSecure.dataset.kvBound = '1';
        btnSecure.addEventListener('click', function() {
          btnSecure.disabled = true;

          /* First fetch the cart to check total and what's already in it */
          fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .then(function(cart) {
              /* Determine which product to add based on cart total */
              var variantToAdd = null;
              var variantToRemove = null;
              
              if (lowCartVariantId && cart.total_price < lowCartThreshold) {
                /* Cart is under threshold, use low cart product */
                variantToAdd = lowCartVariantId;
                /* If cart is under threshold, remove protection product if it exists */
                variantToRemove = protectionVariantId;
              } else if (protectionVariantId) {
                /* Cart is above threshold or no low cart product set, use protection product */
                variantToAdd = protectionVariantId;
                /* If cart is above threshold, remove low cart product if it exists */
                variantToRemove = lowCartVariantId;
              }

              if (!variantToAdd) {
                /* No product configured, go straight to checkout */
                window.location.href = '/checkout';
                return;
              }

              /* Check what's currently in the cart */
              var targetItemInCart = cart.items.find(function(item) {
                return String(item.variant_id) === String(variantToAdd);
              });
              
              var wrongItemInCart = variantToRemove ? cart.items.find(function(item) {
                return String(item.variant_id) === String(variantToRemove);
              }) : null;

              /* Create a promise chain for cart operations */
              var cartOperations = Promise.resolve();

              /* First, remove the wrong protection product if it's in cart */
              if (wrongItemInCart) {
                cartOperations = cartOperations.then(function() {
                  return fetch('/cart/change.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ id: wrongItemInCart.key, quantity: 0 })
                  });
                });
              }

              /* Then, add the correct protection product if not already in cart */
              if (!targetItemInCart) {
                cartOperations = cartOperations.then(function() {
                  return fetch('/cart/add.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ id: Number(variantToAdd), quantity: 1 })
                  });
                });
              }

              /* Finally, redirect to checkout */
              cartOperations.then(function() {
                window.location.href = '/checkout';
              }).catch(function() {
                /* Fallback: redirect anyway */
                window.location.href = '/checkout';
              });
            })
            .catch(function() {
              /* Fallback: redirect anyway */
              window.location.href = '/checkout';
            });
        });
      }

      if (btnWithout && !btnWithout.dataset.kvBound) {
        btnWithout.dataset.kvBound = '1';
        btnWithout.addEventListener('click', function() {
          btnWithout.disabled = true;

          /* Check if either the protection or low cart product is in the cart and remove it */
          fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .then(function(cart) {
              var itemsToRemove = [];
              
              /* Check for protection product */
              if (protectionVariantId) {
                var protectionItem = cart.items.find(function(item) {
                  return String(item.variant_id) === String(protectionVariantId);
                });
                if (protectionItem) itemsToRemove.push(protectionItem.key);
              }
              
              /* Check for low cart product */
              if (lowCartVariantId) {
                var lowCartItem = cart.items.find(function(item) {
                  return String(item.variant_id) === String(lowCartVariantId);
                });
                if (lowCartItem) itemsToRemove.push(lowCartItem.key);
              }

              if (itemsToRemove.length > 0) {
                /* Remove items sequentially */
                var removePromises = itemsToRemove.map(function(key) {
                  return fetch('/cart/change.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ id: key, quantity: 0 })
                  });
                });
                return Promise.all(removePromises).then(function() {
                  window.location.href = '/checkout';
                });
              } else {
                window.location.href = '/checkout';
              }
            })
            .catch(function() {
              window.location.href = '/checkout';
            });
        });
      }
    }

    initCheckoutButtons();

    /* Re-init after AJAX cart refresh (DOM replacement) */
    var checkoutObserver = new MutationObserver(function() {
      setTimeout(initCheckoutButtons, 200);
    });
    checkoutObserver.observe(drawer, { childList: true, subtree: true });
  })();
</script>

<script>
  /* Scent modal for cart drawer — reuses kv-bundle-section's #kv-scent-modal,
     or creates an identical one when the bundle section isn't on the page */
  (function() {
    var openedFromCart = false;

    /* Ensure the modal + overlay exist (bundle section may or may not be present) */
    function ensureModal() {
      var modal   = document.getElementById('kv-scent-modal');
      var overlay = document.getElementById('kv-scent-modal-overlay');
      if (modal && overlay) return { modal: modal, overlay: overlay };

      /* Build same HTML as kv-bundle-section.liquid */
      overlay = document.createElement('div');
      overlay.className = 'kv-scent-modal-overlay';
      overlay.id = 'kv-scent-modal-overlay';

      modal = document.createElement('div');
      modal.className = 'kv-scent-modal';
      modal.id = 'kv-scent-modal';
      modal.setAttribute('aria-hidden', 'true');
      modal.innerHTML =
        '<button class="kv-scent-modal-close" type="button" aria-label="Close">' +
          '<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">' +
            '<path d="M10.8426 0.196845C10.9333 0.105994 11.0342 0.0479495 11.1452 0.0227129C11.2612 -0.00757098 11.3772 -0.00757098 11.4932 0.0227129C11.6091 0.0479495 11.7125 0.105994 11.8033 0.196845C11.889 0.28265 11.947 0.383596 11.9773 0.499685C12.0076 0.615773 12.0076 0.731861 11.9773 0.84795C11.947 0.964038 11.889 1.06498 11.8033 1.15079L1.15949 11.8032C1.07376 11.889 0.972892 11.947 0.856897 11.9773C0.740902 12.0076 0.624907 12.0076 0.508912 11.9773C0.392916 11.947 0.289529 11.889 0.198751 11.8032C0.107972 11.7174 0.0474526 11.6164 0.017193 11.5003C-0.00802338 11.3842 -0.00550175 11.2681 0.0247579 11.1521C0.0550175 11.036 0.113015 10.935 0.198751 10.8492L10.8426 0.196845ZM11.8033 10.8492C11.889 10.935 11.9445 11.036 11.9697 11.1521C12 11.2681 12 11.3842 11.9697 11.5003C11.9445 11.6164 11.889 11.7174 11.8033 11.8032C11.7176 11.894 11.6142 11.9521 11.4932 11.9773C11.3772 12.0076 11.2612 12.0076 11.1452 11.9773C11.0292 11.947 10.9283 11.889 10.8426 11.8032L0.198751 1.15079C0.113015 1.06498 0.0550175 0.964038 0.0247579 0.84795C-0.000458479 0.731861 -0.000458479 0.615773 0.0247579 0.499685C0.0550175 0.383596 0.113015 0.28265 0.198751 0.196845C0.284486 0.105994 0.385352 0.0479495 0.501347 0.0227129C0.617342 -0.00757098 0.733337 -0.00757098 0.849332 0.0227129C0.970371 0.0479495 1.07376 0.105994 1.15949 0.196845L11.8033 10.8492Z" fill="white"/>' +
          '</svg>' +
        '</button>' +
        '<div class="kv-scent-modal-image"><img src="" alt="" id="kv-scent-modal-img"></div>' +
        '<div class="kv-scent-modal-content">' +
          '<div class="kv-scent-modal-content-header">' +
            '<div class="kv-scent-modal-content-header-inner">' +
            '<div class="kv-scent-modal-tags">' +
              '<span class="kv-scent-modal-tag" id="kv-scent-modal-variant"></span>' +
              '<span class="kv-scent-modal-tag kv-scent-modal-tag-special" id="kv-scent-modal-badge"></span>' +
            '</div>' +
            '<h2 class="kv-scent-modal-title" id="kv-scent-modal-title"></h2>' +
            '<p class="kv-scent-modal-description" id="kv-scent-modal-description"></p>' +
          '</div>' +
          '</div>' +
          '<div class="kv-scent-modal-details">' +
            '<h3>Scent Details</h3>' +
            '<div class="kv-scent-modal-details-content" id="kv-scent-modal-details"></div>' +
            '<button class="kv-scent-modal-add" type="button" id="kv-scent-modal-add">+ Add</button>' +
          '</div>' +
        '</div>';

      document.body.appendChild(overlay);
      document.body.appendChild(modal);

      /* Bind close handlers for the freshly-created modal */
      modal.querySelector('.kv-scent-modal-close').addEventListener('click', closeModal);
      overlay.addEventListener('click', closeModal);

      return { modal: modal, overlay: overlay };
    }

    function closeModal() {
      var modal   = document.getElementById('kv-scent-modal');
      var overlay = document.getElementById('kv-scent-modal-overlay');
      if (modal)   modal.classList.remove('active');
      if (overlay) overlay.classList.remove('active');
      document.body.style.overflow = '';

      /* Restore Add button for bundle-section usage */
      var addBtn = document.getElementById('kv-scent-modal-add');
      if (addBtn) addBtn.style.display = '';

      openedFromCart = false;
    }

    function openModal(btn) {
      var els     = ensureModal();
      var modal   = els.modal;
      var overlay = els.overlay;

      var title   = btn.getAttribute('data-product-title') || '';
      var desc    = btn.getAttribute('data-product-description') || '';
      var details = btn.getAttribute('data-product-details') || '';
      var image   = btn.getAttribute('data-product-image') || '';
      var variant = btn.getAttribute('data-product-variant') || '';
      var badge   = btn.getAttribute('data-product-badge') || '';

      /* Populate the modal (same IDs as kv-bundle-section) */
      var elTitle   = document.getElementById('kv-scent-modal-title');
      var elDesc    = document.getElementById('kv-scent-modal-description');
      var elDetails = document.getElementById('kv-scent-modal-details');
      var elImg     = document.getElementById('kv-scent-modal-img');
      var elVariant = document.getElementById('kv-scent-modal-variant');
      var elBadge   = document.getElementById('kv-scent-modal-badge');
      var elAdd     = document.getElementById('kv-scent-modal-add');

      if (elTitle)   elTitle.textContent = title;
      if (elDesc)    elDesc.textContent = desc;
      if (elDetails) elDetails.innerHTML = details ? details.replace(/\n/g, '<br>') : '';
      if (elVariant) elVariant.textContent = variant;

      if (elBadge) {
        elBadge.textContent = badge;
        elBadge.style.display = badge ? '' : 'none';
      }

      if (elImg) {
        if (image) {
          elImg.src = image;
          elImg.alt = title;
          elImg.parentElement.style.display = 'block';
        } else {
          elImg.parentElement.style.display = 'none';
        }
      }

      /* Hide Add button — not needed inside cart */
      if (elAdd) elAdd.style.display = 'none';

      openedFromCart = true;
      overlay.classList.add('active');
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    /* Intercept clicks/mousedowns/touchstart on the scent modal so they
       never reach the cart drawer's focus-trap "allowOutsideClick" handler */
    function interceptEvent(e) {
      if (!openedFromCart) return;
      var modal   = document.getElementById('kv-scent-modal');
      var overlay = document.getElementById('kv-scent-modal-overlay');
      var hitModal   = modal   && (modal === e.target   || modal.contains(e.target));
      var hitOverlay = overlay && overlay === e.target;

      if (hitModal || hitOverlay) {
        e.stopImmediatePropagation();
        if (e.type === 'click' && (hitOverlay || e.target.closest('.kv-scent-modal-close'))) {
          closeModal();
        }
      }
    }
    document.addEventListener('click',      interceptEvent, true);
    document.addEventListener('mousedown',  interceptEvent, true);
    document.addEventListener('touchstart', interceptEvent, true);

    /* Open handler — capture phase so we fire BEFORE the bundle section's
       own handler (which has the kv-minicart guard that blocks opening) */
    document.addEventListener('click', function(e) {
      var infoBtn = e.target.closest('.kv-scent-info-btn');
      if (!infoBtn) return;
      if (!infoBtn.closest('#cart-drawer')) return;

      e.preventDefault();
      e.stopImmediatePropagation();
      openModal(infoBtn);
    }, true);

  })();
</script>

<script>
  /* Force reload when navigating back from checkout page */
  (function() {
    /* Use the Performance Navigation API to detect if page was loaded via back button */
    if (window.performance && window.performance.navigation) {
      /* Check if page was loaded via back/forward navigation (type 2) */
      if (window.performance.navigation.type === 2) {
        /* User came back via browser back button, force reload */
        window.location.reload();
      }
    }

    /* Also use the newer PerformanceNavigationTiming API as fallback */
    if (window.performance && window.performance.getEntriesByType) {
      var navEntries = window.performance.getEntriesByType('navigation');
      if (navEntries.length > 0 && navEntries[0].type === 'back_forward') {
        /* User came back via browser back button, force reload */
        window.location.reload();
      }
    }

    /* Listen for pageshow event (fires when page is loaded from cache) */
    window.addEventListener('pageshow', function(event) {
      /* If page is loaded from cache (bfcache), reload it */
      if (event.persisted) {
        window.location.reload();
      }
    });

    /* Store a flag before navigating to checkout */
    document.addEventListener('click', function(e) {
      var checkoutBtn = e.target.closest('#kv-checkout-secure, #kv-checkout-without');
      if (checkoutBtn) {
        /* Set flag in sessionStorage before going to checkout */
        try {
          sessionStorage.setItem('kv_from_checkout', 'true');
        } catch (err) {
          /* Ignore if sessionStorage is not available */
        }
      }
    });

    /* Check if we came back from checkout and force reload */
    try {
      if (sessionStorage.getItem('kv_from_checkout') === 'true') {
        /* Clear the flag */
        sessionStorage.removeItem('kv_from_checkout');
        /* Force reload if not already reloading */
        if (!sessionStorage.getItem('kv_reloaded')) {
          sessionStorage.setItem('kv_reloaded', 'true');
          window.location.reload();
        } else {
          /* Clean up reload flag */
          sessionStorage.removeItem('kv_reloaded');
        }
      }
    } catch (err) {
      /* Ignore if sessionStorage is not available */
    }
  })();
</script>

<script>
  function getAmsterdamToday() {
    var now = new Date();
    var ams = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
    if (ams.getHours() > 22 || (ams.getHours() === 22 && ams.getMinutes() >= 59)) {
      ams.setDate(ams.getDate() + 1);
    }
    ams.setHours(0, 0, 0, 0);
    return ams;
  }

  function getShippingDate() {
    var today = getAmsterdamToday();
    var day = today.getDay();
    if (day === 0) today.setDate(today.getDate() + 1);
    if (day === 6) today.setDate(today.getDate() + 2);
    return today;
  }

  /* Read more / Read less toggle for cart drawer pre-order notice */
  (function() {
    document.addEventListener('click', function(e) {
      var toggle = e.target.closest('.kv-cart__preorder-toggle');
      if (!toggle) return;
      e.preventDefault();
      var infoBlock = toggle.closest('.kv-cart__preorder-notice-info');
      if (!infoBlock) return;
      var collapsed = infoBlock.querySelector('.kv-cart__preorder-collapsed');
      var expanded = infoBlock.querySelector('.kv-cart__preorder-expanded');
      if (toggle.dataset.action === 'expand') {
        collapsed.style.display = 'none';
        expanded.style.display = '';
      } else {
        collapsed.style.display = '';
        expanded.style.display = 'none';
      }
    });

    var kvCountryCode = '{{ localization.country.iso_code }}';
    var kvDeliveryDays = {
      nl: {{ settings.delivery_days_nl | default: 1 }},
      be: {{ settings.delivery_days_be | default: 1 }},
      de: {{ settings.delivery_days_de | default: 2 }},
      euMin: {{ settings.delivery_days_eu_min | default: 3 }},
      euMax: {{ settings.delivery_days_eu_max | default: 4 }},
      rowMin: {{ settings.delivery_days_row_min | default: 6 }},
      rowMax: {{ settings.delivery_days_row_max | default: 10 }}
    };
    var kvEuCountries = ['AT','BG','HR','CY','CZ','DK','EE','FI','FR','GR','HU','IE','IT','LV','LT','LU','MT','PL','PT','RO','SK','SI','ES','SE'];
    var kvMonthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];

    function getMarketDeliveryDays() {
      switch (kvCountryCode) {
        case 'NL': return { min: kvDeliveryDays.nl, max: kvDeliveryDays.nl };
        case 'BE': return { min: kvDeliveryDays.be, max: kvDeliveryDays.be };
        case 'DE': return { min: kvDeliveryDays.de, max: kvDeliveryDays.de };
        default:
          if (kvEuCountries.indexOf(kvCountryCode) !== -1) {
            return { min: kvDeliveryDays.euMin, max: kvDeliveryDays.euMax };
          }
          return { min: kvDeliveryDays.rowMin, max: kvDeliveryDays.rowMax };
      }
    }

    function formatDeliveryRange(baseDate, minDays, maxDays) {
      var startDate = new Date(baseDate);
      startDate.setDate(startDate.getDate() + minDays);
      var endDate = new Date(baseDate);
      endDate.setDate(endDate.getDate() + maxDays);
      if (minDays === maxDays) {
        return startDate.getDate() + ' ' + kvMonthNames[startDate.getMonth()];
      } else if (startDate.getMonth() === endDate.getMonth()) {
        return startDate.getDate() + ' - ' + endDate.getDate() + ' ' + kvMonthNames[endDate.getMonth()];
      } else {
        return startDate.getDate() + ' ' + kvMonthNames[startDate.getMonth()] + ' - ' + endDate.getDate() + ' ' + kvMonthNames[endDate.getMonth()];
      }
    }

    function updateInstockDates() {
      var instockDatesEl = document.getElementById('kv-cart-instock-dates');
      if (!instockDatesEl) return;
      var days = getMarketDeliveryDays();
      instockDatesEl.textContent = formatDeliveryRange(getShippingDate(), days.min, days.max);
    }

    function updatePreorderDates() {
      var preorderDatesEl = document.getElementById('kv-cart-preorder-dates');
      if (!preorderDatesEl) return;
      var notice = preorderDatesEl.closest('.kv-cart__preorder-notice');
      if (!notice) return;
      var stockDateStr = notice.getAttribute('data-preorder-stock-date');
      if (!stockDateStr) return;
      var stockDate = new Date(stockDateStr);
      if (isNaN(stockDate.getTime())) return;
      var days = getMarketDeliveryDays();
      preorderDatesEl.textContent = formatDeliveryRange(stockDate, days.min, days.max);
    }

    function updateAllDates() {
      updateInstockDates();
      updatePreorderDates();
    }

    updateAllDates();

    document.addEventListener('cart:refresh', function() {
      setTimeout(updateAllDates, 300);
    });
    document.documentElement.addEventListener('cart:refresh', function() {
      setTimeout(updateAllDates, 300);
    });

    var drawer = document.querySelector('cart-drawer');
    if (drawer) {
      var datesObserver = new MutationObserver(function() {
        setTimeout(updateAllDates, 100);
      });
      datesObserver.observe(drawer, { childList: true, subtree: true });
    }
  })();
</script>