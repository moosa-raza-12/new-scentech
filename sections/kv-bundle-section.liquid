<script>
(function () {
  function updateStickyHeight() {
    var sticky = document.querySelector('.kv-bundle-items-sticky');
    if (!sticky) {
      document.documentElement.style.setProperty('--kv-sticky-height', '0px');
      return;
    }
    var h = sticky.offsetHeight || 0;
    document.documentElement.style.setProperty('--kv-sticky-height', h + 'px');
  }
  function attachObserver() {
    var sticky = document.querySelector('.kv-bundle-items-sticky');
    if (!sticky) { return setTimeout(attachObserver, 250); }
    updateStickyHeight();
    if ('ResizeObserver' in window) {
      new ResizeObserver(updateStickyHeight).observe(sticky);
    }
    if ('MutationObserver' in window) {
      new MutationObserver(updateStickyHeight).observe(sticky, { childList: true, subtree: true, characterData: true });
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachObserver);
  } else {
    attachObserver();
  }
  window.addEventListener('load', updateStickyHeight);
  window.addEventListener('resize', updateStickyHeight);
  window.addEventListener('orientationchange', updateStickyHeight);
})();
</script>

<script>
(function () {
  var DEFAULT_DISCOUNT_MESSAGE_TEMPLATE = '"{code}" is active. {percent}% discount applied at checkout';

  function readCookie(name) {
    try {
      var cookies = document.cookie ? document.cookie.split(';') : [];
      for (var i = 0; i < cookies.length; i++) {
        var c = cookies[i].replace(/^\s+/, '');
        if (c.indexOf(name + '=') === 0) {
          return decodeURIComponent(c.substring(name.length + 1));
        }
      }
    } catch (e) {}
    return null;
  }

  function getDiscountCodeFromUrl() {
    try {
      var pathMatch = window.location.pathname.match(/\/discount\/([^\/\?#]+)/i);
      if (pathMatch && pathMatch[1]) {
        return decodeURIComponent(pathMatch[1]);
      }
      var search = window.location.search || '';
      if (search) {
        var params = new URLSearchParams(search);
        var fromQuery = params.get('discount') || params.get('discount_code');
        if (fromQuery) return fromQuery;
      }
    } catch (e) {}
    return null;
  }

  function getDiscountCodeFromCookie() {
    var directKeys = ['discount_code', 'discount', 'cart_discount'];
    for (var i = 0; i < directKeys.length; i++) {
      var v = readCookie(directKeys[i]);
      if (v) return v;
    }

    try {
      var cookies = document.cookie ? document.cookie.split(';') : [];
      for (var j = 0; j < cookies.length; j++) {
        var c = cookies[j].replace(/^\s+/, '');
        var eq = c.indexOf('=');
        var name = eq >= 0 ? c.substring(0, eq) : c;
        var nameMatch = name.match(/^(?:discount_code|discount|cart_discount)[-_](.+)$/i);
        if (nameMatch && nameMatch[1]) {
          return decodeURIComponent(nameMatch[1]);
        }
      }
    } catch (e) {}

    return null;
  }

  function getActiveDiscount() {
    var code = getDiscountCodeFromUrl() || getDiscountCodeFromCookie();
    if (!code) return null;
    code = String(code).trim();
    if (!code) return null;
    var match = code.match(/(\d+)\s*$/);
    if (!match) return null;
    var percent = parseInt(match[1], 10);
    if (!percent || isNaN(percent)) return null;
    return { code: code.toUpperCase(), percent: percent };
  }

  function buildMessage(template, discount) {
    var tpl = (template && String(template).trim()) || DEFAULT_DISCOUNT_MESSAGE_TEMPLATE;
    return tpl
      .replace(/\{code\}/g, discount.code)
      .replace(/\{percent\}/g, discount.percent);
  }

  function applyDiscountMessaging() {
    var promoBanner = document.querySelector('.kv-promo-banner-discount');
    var promoText = document.querySelector('.kv-promo-banner-discount-text');
    var belowAtc = document.querySelector('.kv-below-atc-discount');
    var belowAtcText = document.querySelector('.kv-below-atc-discount-text');

    var discount = getActiveDiscount();

    if (!discount) {
      if (promoBanner) promoBanner.style.display = 'none';
      if (belowAtc) belowAtc.style.display = 'none';
      return;
    }

    if (promoBanner) {
      var promoTpl = promoBanner.getAttribute('data-discount-template');
      if (promoText) promoText.textContent = buildMessage(promoTpl, discount);
      promoBanner.style.display = '';
    }

    if (belowAtc) {
      var belowTpl = belowAtc.getAttribute('data-discount-template');
      if (belowAtcText) belowAtcText.textContent = buildMessage(belowTpl, discount);
      belowAtc.style.display = '';
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyDiscountMessaging);
  } else {
    applyDiscountMessaging();
  }
})();
</script>