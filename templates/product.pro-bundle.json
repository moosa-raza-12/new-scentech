{"sections":{"main":{"type":"main-product","blocks":{"liquid_icb7Ce":{"type":"liquid","settings":{"liquid":"<style>\n  .info-wrapper {\n    display: inline-flex;\n    align-items: center;\n    font-family: inherit;\n    font-size: 14px;\n    margin: 5px 0;\n    position: relative; \/* Belangrijk voor positionering tooltip *\/\n    border-radius: 6px;\n    padding: 10px 14px;\n    background-color: #162518;\n    color: #ffffff;\n    line-height: 1.2;\n  }\n\n  .info-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    margin-left: 10px;\n    width: 20px;\n    height: 20px;\n    border: 1.5px solid #ffffff;\n    border-radius: 50%;\n    cursor: pointer;\n    flex-shrink: 0;\n    position: relative;\n    z-index: 11;\n  }\n\n  .info-i {\n    color: #ffffff !important;\n    font-family: serif !important;\n    font-size: 13px !important;\n    font-weight: bold !important;\n    line-height: 1 !important;\n    pointer-events: none; \/* Zorgt dat klik altijd op de cirkel landt *\/\n  }\n\n  .info-tooltip {\n    visibility: hidden;\n    opacity: 0;\n    position: absolute;\n    bottom: calc(100% + 15px);\n    left: 50%;\n    transform: translateX(-50%);\n    background-color: #162518;\n    color: #ffffff;\n    border: 1px solid rgba(255, 255, 255, 0.3);\n    padding: 15px;\n    border-radius: 8px;\n    width: 260px;\n    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);\n    font-size: 13px;\n    line-height: 1.5;\n    z-index: 9999;\n    transition: opacity 0.2s ease, visibility 0.2s ease;\n    pointer-events: none; \/* Voorkomt dat tooltip de muis blokkeert *\/\n  }\n\n  \/* Tooltip pijltje *\/\n  .info-tooltip::after {\n    content: \"\";\n    position: absolute;\n    top: 100%;\n    left: 50%;\n    margin-left: -8px;\n    border-width: 8px;\n    border-style: solid;\n    border-color: #162518 transparent transparent transparent;\n  }\n\n  \/* Hover & Active Logica *\/\n  .info-icon:hover ~ .info-tooltip,\n  .info-icon.active ~ .info-tooltip {\n    visibility: visible;\n    opacity: 1;\n  }\n\n  \/* Zorg dat vette tekst in de tooltip ook wit is *\/\n  .info-tooltip b, .info-tooltip strong {\n    color: #ffffff !important;\n  }\n<\/style>\n\n<div class=\"info-wrapper\">\n  <span>\n    {% assign title = product.metafields.custom.scent_duration_title %}\n    {{ title | default: \"Één geurtje gaat gemiddeld 1 maand mee\" | escape }}\n  <\/span>\n\n  <div class=\"info-icon\" id=\"scentech-info-icon\" onclick=\"toggleTooltip(event, this)\">\n    <span class=\"info-i\">i<\/span>\n  <\/div>\n\n  <div class=\"info-tooltip\" id=\"scentech-tooltip\">\n    {% if product and product.metafields.custom.scent_duration_body != blank %}\n      {{ product.metafields.custom.scent_duration_body | metafield_tag }}\n    {% else %}\n      Bij een gemiddelde geurintensiteit verbruikt onze Smart Aroma Diffuser pro <b>0,08 ml per uur<\/b>. Eén ScentPod van 50 ml gaat dan <b>625 uur mee<\/b> – dat is ruim 2 maanden bij 10 uur gebruik per dag.\n    {% endif %}\n  <\/div>\n<\/div>\n\n<script>\n  function toggleTooltip(event, el) {\n    event.stopPropagation(); \/\/ Stopt het sluiten door de document-click\n    const isActive = el.classList.contains('active');\n    \n    \/\/ Reset alle icons\n    document.querySelectorAll('.info-icon').forEach(icon => icon.classList.remove('active'));\n    \n    \/\/ Toggle de huidige\n    if (!isActive) {\n      el.classList.add('active');\n    }\n  }\n\n  \/\/ Sluiten als je buiten de tooltip klikt\n  document.addEventListener('click', function(e) {\n    if (!e.target.closest('.info-wrapper')) {\n      document.querySelectorAll('.info-icon').forEach(icon => icon.classList.remove('active'));\n    }\n  });\n<\/script>"}},"klaviyo_reviews_average_rating_pR3Je8":{"type":"shopify:\/\/apps\/klaviyo-reviews\/blocks\/average-rating\/db20e365-d984-4ac4-9655-e1588d951ca9","settings":{"product":"{{product}}"}},"title":{"type":"title","settings":{"heading_tag":"h3"}},"price":{"type":"price","settings":{