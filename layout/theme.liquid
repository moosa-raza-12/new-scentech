<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">
 {%- liquid
      assign __set_scent = false
      assign __remove_scent = false

      if template.name == 'page' and template.suffix == 'v2-diffuser-overflow'
        assign __set_scent = true
      elsif template.name == 'page' and template.suffix == 'diffuser-overflow-v1'
        assign __set_scent = true
      elsif template.name == 'collection' and template.suffix == 'returning-customer'
        assign __set_scent = true
      endif

      if template.name == 'collection' and template.suffix == blank
        assign __remove_scent = true
      elsif template.name == 'collection' and template.suffix == 'offer-page'
        assign __remove_scent = true
      endif
    -%}

    {%- if template.name == 'collection' and template.suffix == 'offer-page' -%}
      <script type="text/javascript" src="https://cdn.506.io/eg/script.js?shop={{ shop.permanent_domain }}{% if customer %}&id={{ customer.id | escape_once }}&order_count={{ customer.orders_count | escape_once }}&total_spent={{ customer.total_spent | escape_once }}&tags={{ customer.tags | join: "," | url_encode }}{% endif %}"></script>
    {%- endif -%}

    {%- if __set_scent -%}
      <script>
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: { 'scent': 'true' } })
        }).catch(function(e) { console.error('Error setting scent attribute:', e); });
      </script>
    {%- elsif __remove_scent -%}
      <script>
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: { 'scent': '' } })
        }).catch(function(e) { console.error('Error removing scent attribute:', e); });
      </script>
    {%- endif -%}
  </head>
  
<body
  class="
    {% if settings.show_page_transition %}page-transition{% endif %}
    {% if settings.zoom_image_on_hover %} zoom-image--enabled{% endif %}
    {% if request.page_type == 'product' %}
      product-template{% if template.suffix != blank %} product-template--{{ template.suffix | handle }}{% else %} product-template--default{% endif %}
      {% if template.suffix contains 'diffuser' or template.suffix contains 'bundle' or template.suffix contains 'bundles' %} diffuser{% endif %}
    {% endif %}
  ">
    {%- render 'shadow-dom-templates' -%}

    <a href="#main" class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}

      {%- if settings.cart_type == 'popover' -%}
        <cart-notification-drawer open-from="bottom" class="quick-buy-drawer drawer"></cart-notification-drawer>
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' -%}
      {%- section 'account-banner' -%}
    {%- endif -%}

    <main role="main" id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
      IMPLEMENTATION NOTE: due to the very complex logic of margin/padding collapsing in Impact, the footer group is
      added into the main element to ensure that dynamic sections added into the footer group are properly laid out.
      {%- endcomment -%}
      {%- if request.page_type != 'password' -%}
        {%- unless (template.name == 'collection' and template.suffix == 'returning-customer')
          or (template.name == 'page' and template.suffix == 'diffuser-overflow-v1')
          or (template.name == 'page' and template.suffix == 'v2-diffuser-overflow') -%}
          {%- sections 'footer-group' -%}
        {%- endunless -%}
      {%- endif -%}

      {%- if (template.name == 'page' and template.suffix == 'diffuser-overflow-v1')
          or (template.name == 'page' and template.suffix == 'v2-diffuser-overflow') -%}
        <style>
          .shopify-section-group--footer-group,
          footer,
          #footer,
          [id*="footer"],
          [class*="footer"] {
            display: none !important;
          }
        </style>
      {%- endif -%}

         {% if template contains 'blog' or template contains 'article' %}
  <style>
    #shopify-chat {
      display: none !important;
    }
  </style>
{% endif %}
<style>
    body.diffuser .product-info__buy-buttons .buy-buttons-container .button[type=submit], body .product-quick-add .button {
    color: #160000;
    background: #f5f5f3;
    border: 1px solid #160000;
}

body.diffuser .product-info__block-item .promo-banner, .product-quick-add .sticky-promo-banner {
    background: #160000;
}

body.diffuser .product-info__block-item .promo-banner .promo-banner__title, .product-quick-add .sticky-promo-banner .sticky-promo-banner__title{
    color: #fff;
}

body.diffuser .product-info__block-item .promo-banner  .promo-banner__subtitle, .product-quick-add .sticky-promo-banner .sticky-promo-banner__subtitle{
    color: #fff;
}

body.diffuser .product-info__block-item .promo-banner  svg, .product-quick-add .sticky-promo-banner svg {
    stroke: #fff;
}
  </style>
<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

    </main>
       <script async src="https://cdn.sufio.com/infoweb/scripts/vat.js" id="sufio-vat-script"></script>
    <script>
      document.getElementById("sufio-vat-script").onload = function() {
        SufioVAT.init({
            customerEmail: {{ customer.email | json }},
            customerMetafields: {{ customer.metafields.sufio | json }},
            cartAttributes: {{ cart.attributes | json }}
        });
        SufioVAT.onCart();
    };
</script> 
  
  </body>
</html>