      "label": "Logo"
    },
    {
      "type": "text",
      "id": "header_icon",
      "label": "Header Icon",
      "default": "◆"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header Text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Background Gradient Start",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gradient_end",
