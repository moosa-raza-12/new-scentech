    color: #160000;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    max-width: 672px;
    font-family: 'N27';
  }

  .cmp-scent-modal__details-content {
    color: #160000;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
