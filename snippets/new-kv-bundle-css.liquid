<style>
  :root {
    /* General Section Colors */
    --kv-color-section-bg: {{ section.settings.color_section_bg | default: '#F8F7F4' }};

    /* Hero Section Colors */
    --kv-color-hero-text: {{ section.settings.color_hero_text | default: '#FFFFFF' }};
    --kv-color-hero-sticky-bg: {{ section.settings.color_hero_sticky_bg | default: '#F1EFE8' }};
    --kv-color-hero-sticky-border: {{ section.settings.color_hero_sticky_border | default: '#160000' | color_modify: 'alpha', 0.10 }};
    --kv-color-progress-banner-bg: {{ section.settings.color_progress_banner_bg | default: '#FFFFFF' | color_modify: 'alpha', 0.80 }};
    --kv-color-progress-sticky-footer-bg: {{ section.settings.color_progress_sticky_footer_bg | default: '#000000' | color_modify: 'alpha', 0.10 }};

    /* Promo Banner Colors */
    --kv-color-promo-bg: {{ section.settings.color_promo_bg | default: '#2F3E2F' }};
    --kv-color-promo-text: {{ section.settings.color_promo_text | default: '#FFFFFF' }};

    /* Progress Bar Colors */
    --kv-color-progress-track: {{ section.settings.color_progress_track | default: '#162518' | color_modify: 'alpha', 0.10 }};
    --kv-color-progress-fill-start: {{ section.settings.color_progress_fill_start | default: '#162518' }};
    --kv-color-progress-fill-end: {{ section.settings.color_progress_fill_end | default: '#455046' }};
    --kv-color-progress-fill-shadow: {{ section.settings.color_progress_fill_start | default: '#162518' | color_modify: 'alpha', 0.30 }};
    --kv-color-milestone-border: {{ section.settings.color_milestone_border | default: '#C5C1BB' }};
    --kv-color-milestone-bg: {{ section.settings.color_milestone_bg | default: '#FFFFFF' }};
    --kv-color-milestone-unlocked-bg: {{ section.settings.color_milestone_unlocked | default: '#162518' }};
    --kv-color-milestone-label: {{ section.settings.color_milestone_label | default: '#162518' }};
    --kv-color-milestone-price: {{ section.settings.color_milestone_price | default: '#162518' | color_modify: 'alpha', 0.60 }};
    --kv-color-progress-footer-bg: {{ section.settings.color_progress_footer_bg | default: '#750505' | color_modify: 'alpha', 0.08 }};
    --kv-color-progress-footer-text: {{ section.settings.color_progress_footer_text | default: '#162518' }};

    /* Tabs Colors */
    --kv-color-tab-text: {{ section.settings.color_tab_text | default: '#160000' }};
    --kv-color-tab-border: {{ section.settings.color_tab_border | default: '#160000' | color_modify: 'alpha', 0.10 }};
    --kv-color-tab-hover-bg: {{ section.settings.color_tab_hover_bg | default: '#f5f5f5' }};
    --kv-color-tab-active-text: {{ section.settings.color_tab_active_text | default: '#FFFFFF' }};
    --kv-color-tab-count-bg: {{ section.settings.color_tab_count_bg | default: '#160000' | color_modify: 'alpha', 0.10 }};
    --kv-color-tab-active-count-bg: {{ section.settings.color_tab_active_count_bg | default: '#FFFFFF' | color_modify: 'alpha', 0.20 }};

    /* Product Card Colors */
    --kv-color-product-card-bg: {{ section.settings.color_product_card_bg | default: '#FFFFFF' }};
    --kv-color-product-card-border: {{ section.settings.color_product_card_border | default: '#160000' | color_modify: 'alpha', 0.10 }};
    --kv-color-product-title: {{ section.settings.color_product_title | default: '#160000' }};
    --kv-color-product-description: {{ section.settings.color_product_description | default: '#160000' }};
    --kv-color-bundle-tag-bg: {{ section.settings.color_bundle_tag_bg | default: '#160000' | color_modify: 'alpha', 0.06 }};
    --kv-color-bundle-tag-text: {{ section.settings.color_bundle_tag_text | default: '#160000' }};
    --kv-color-bundle-tag-prefix: {{ section.settings.color_bundle_tag_prefix | default: '#160000' | color_modify: 'alpha', 0.70 }};
    --kv-color-product-badge-text: {{ section.settings.color_product_badge_text | default: '#FFFFFF' }};
    --kv-color-preorder-badge-bg: {{ section.settings.color_preorder_badge_bg | default: '#6A0F0F' }};

    /* Variant Colors */
    --kv-color-variant-active-border: {{ section.settings.color_variant_active_border | default: '#1a1a1a' }};

    /* Quantity Selector Colors */
    --kv-color-qty-input-border: {{ section.settings.color_qty_input_border | default: '#160000' | color_modify: 'alpha', 0.15 }};
    --kv-color-qty-input-bg: {{ section.settings.color_qty_input_bg | default: '#FFFFFF' }};
    --kv-color-qty-input-text: {{ section.settings.color_qty_input_text | default: '#162518' }};
    --kv-color-bundle-qty-input-text: {{ section.settings.color_bundle_qty_input_text | default: '#34393D' }};

    /* Add-to-Cart Colors */
    --kv-color-atc-text: {{ section.settings.color_atc_text | default: '#FFFFFF' }};
    --kv-color-atc-disabled-bg: {{ section.settings.color_atc_disabled_bg | default: '#cccccc' }};
    --kv-color-cta-added-bg: {{ section.settings.color_cta_added_bg | default: '#4a7c59' }};
    --kv-color-cta-added-text: {{ section.settings.color_cta_added_text | default: '#FFFFFF' }};

    /* Continue / Sticky Cart Colors */
    --kv-color-continue-btn-text: {{ section.settings.color_continue_btn_text | default: '#FFFFFF' }};
    --kv-color-sticky-bg: {{ section.settings.color_sticky_bg | default: '#FFFFFF' }};
    --kv-color-sticky-shadow: {{ section.settings.color_sticky_shadow | default: '#34393D' | color_modify: 'alpha', 0.20 }};
    --kv-color-disc-active-msg: {{ section.settings.color_disc_active_msg | default: '#17561F' }};

    /* Thumbnail Colors */
    --kv-color-thumbnail-border: {{ section.settings.color_thumbnail_border | default: '#160000' | color_modify: 'alpha', 0.10 }};
    --kv-color-thumbnail-skeleton-border: {{ section.settings.color_thumbnail_skeleton_border | default: '#160000' | color_modify: 'alpha', 0.10 }};
    --kv-color-thumbnail-remove-bg: {{ section.settings.color_thumbnail_remove_bg | default: '#E8E5E5' }};
    --kv-color-thumbnail-qty-bg: {{ section.settings.color_thumbnail_qty_bg | default: '#162518' }};
    --kv-color-thumbnail-qty-text: {{ section.settings.color_thumbnail_qty_text | default: '#FFFFFF' }};
    --kv-color-thumbnail-qty-border: {{ section.settings.color_thumbnail_qty_border | default: '#FFFFFF' }};
    --kv-color-thumbnail-free-badge-bg: {{ section.settings.color_thumbnail_free_badge_bg | default: '#ae4e42' }};
    --kv-color-thumbnail-free-badge-text: {{ section.settings.color_thumbnail_free_badge_text | default: '#FFFFFF' }};
    --kv-color-thumbnail-gift-text: {{ section.settings.color_thumbnail_gift_text | default: '#162518' }};
    --kv-color-thumbnail-gift-image-border: {{ section.settings.color_thumbnail_gift_image_border | default: '#160000' }};

    /* Modal Overlay */
    --kv-color-modal-overlay: {{ section.settings.color_modal_overlay | default: '#000000' | color_modify: 'alpha', 0.50 }};

    /* Scent Modal Colors */
    --kv-color-scent-modal-bg: {{ section.settings.color_scent_modal_bg | default: '#FFFFFF' }};
    --kv-color-scent-modal-header-bg: {{ section.settings.color_scent_modal_header_bg | default: '#F1EFE8' }};
    --kv-color-scent-modal-header-border: {{ section.settings.color_scent_modal_header_border | default: '#160000' | color_modify: 'alpha', 0.10 }};
    --kv-color-scent-modal-close-bg: {{ section.settings.color_scent_modal_close_bg | default: '#160000' }};
    --kv-color-scent-modal-content-bg: {{ section.settings.color_scent_modal_content_bg | default: '#DED9C5' }};
    --kv-color-scent-modal-title: {{ section.settings.color_scent_modal_title | default: '#160000' }};
    --kv-color-scent-modal-description: {{ section.settings.color_scent_modal_description | default: '#160000' }};
    --kv-color-scent-modal-details-title: {{ section.settings.color_scent_modal_details_title | default: '#160000' }};
    --kv-color-scent-modal-details-text: {{ section.settings.color_scent_modal_details_text | default: '#160000' }};
    --kv-color-scent-modal-add-bg: {{ section.settings.color_scent_modal_add_bg | default: '#162518' }};
    --kv-color-scent-modal-add-text: {{ section.settings.color_scent_modal_add_text | default: '#FFFFFF' }};

    /* Info Modal Colors */
    --kv-color-info-modal-bg: {{ section.settings.color_info_modal_bg | default: '#f0efe9' }};
    --kv-color-info-modal-close-bg: {{ section.settings.color_info_modal_close_bg | default: '#FFFFFF' | color_modify: 'alpha', 0.90 }};
    --kv-color-info-modal-close-hover-bg: {{ section.settings.color_info_modal_close_bg | default: '#FFFFFF' }};
    --kv-color-info-modal-placeholder-bg: {{ section.settings.color_info_modal_placeholder_bg | default: '#F8F7F4' }};
    --kv-color-info-modal-placeholder-text: {{ section.settings.color_info_modal_placeholder_text | default: '#160000' }};

    /* Mini Cart Colors */
    --kv-color-mini-cart-bg: {{ section.settings.color_mini_cart_bg | default: '#FFFFFF' }};
    --kv-color-mini-cart-close: {{ section.settings.color_mini_cart_close | default: '#666666' }};
    --kv-color-mini-cart-gift-placeholder-bg: {{ section.settings.color_mini_cart_gift_placeholder_bg | default: '#162518' | color_modify: 'alpha', 0.08 }};
    --kv-color-mini-cart-gift-placeholder-text: {{ section.settings.color_mini_cart_gift_placeholder_text | default: '#162518' }};
    --kv-color-mini-cart-gift-label: {{ section.settings.color_mini_cart_gift_label | default: '#1a2a49' }};
    --kv-color-mini-cart-gift-price: {{ section.settings.color_mini_cart_gift_price | default: '#1a2a49' }};
    --kv-color-mini-cart-gift-strikethrough: {{ section.settings.color_mini_cart_gift_strikethrough | default: '#AE4E42' }};
    --kv-color-mini-cart-strikethrough-middle: {{ section.settings.color_mini_cart_strikethrough_middle | default: '#000000' }};
    --kv-color-mini-cart-strikethrough-badge-bg: {{ section.settings.color_mini_cart_strikethrough_badge_bg | default: '#AE4E42' }};
    --kv-color-mini-cart-strikethrough-badge-text: {{ section.settings.color_mini_cart_strikethrough_badge_text | default: '#FFFFFF' }};
    --kv-color-mini-cart-item-border: {{ section.settings.color_mini_cart_item_border | default: '#160000' | color_modify: 'alpha', 0.10 }};
    --kv-color-mini-cart-item-title: {{ section.settings.color_mini_cart_item_title | default: '#160000' }};
    --kv-color-mini-cart-item-price: {{ section.settings.color_mini_cart_item_price | default: '#162518' }};
    --kv-color-mini-cart-gift-text: {{ section.settings.color_mini_cart_gift_text | default: '#5c5c5c' }};
    --kv-color-mini-cart-gift-inventory-bg: {{ section.settings.color_mini_cart_gift_inventory_bg | default: '#252116' | color_modify: 'alpha', 0.05 }};
    --kv-color-mini-cart-gift-inventory-border: {{ section.settings.color_mini_cart_gift_inventory_border | default: '#162518' | color_modify: 'alpha', 0.10 }};
    --kv-color-mini-cart-gift-inventory-text: {{ section.settings.color_mini_cart_gift_inventory_text | default: '#162518' }};
    --kv-color-mini-cart-qty-text: {{ section.settings.color_mini_cart_qty_text | default: '#FFFFFF' }};
    --kv-color-mini-cart-qty-value: {{ section.settings.color_mini_cart_qty_value | default: '#160100' }};
    --kv-color-mini-cart-subtotal: {{ section.settings.color_mini_cart_subtotal | default: '#666666' }};
    --kv-color-mini-cart-preorder-bg: {{ section.settings.color_mini_cart_preorder_bg | default: '#252116' | color_modify: 'alpha', 0.05 }};
    --kv-color-mini-cart-preorder-label: {{ section.settings.color_mini_cart_preorder_label | default: '#162518' }};
    --kv-color-mini-cart-preorder-dates: {{ section.settings.color_mini_cart_preorder_dates | default: '#162518' }};
    --kv-color-mini-cart-preorder-dates-bg: {{ section.settings.color_mini_cart_preorder_dates_bg | default: '#FFFFFF' }};
    --kv-color-mini-cart-preorder-info: {{ section.settings.color_mini_cart_preorder_info | default: '#162518' }};
    --kv-color-mini-cart-preorder-toggle: {{ section.settings.color_mini_cart_preorder_toggle | default: '#160000' | color_modify: 'alpha', 0.50 }};
    --kv-color-mini-cart-empty: {{ section.settings.color_mini_cart_empty | default: '#999999' }};
    --kv-color-mini-cart-checkout-text: {{ section.settings.color_mini_cart_checkout_text | default: '#FFFFFF' }};

    /* Image Placeholder Colors */
    --kv-color-image-placeholder-bg: {{ section.settings.color_image_placeholder_bg | default: '#f5f5f5' }};
    --kv-color-image-placeholder-text: {{ section.settings.color_image_placeholder_text | default: '#999999' }};

    /* Info Icon SVG Stroke */
    --kv-color-info-icon-stroke: {{ section.settings.color_info_icon_stroke | default: '#160000' }};

    /* Qty Button SVG Fill (+ / − icons inside .kv-bundle-qty-btn) */
    --kv-color-qty-btn-icon: {{ section.settings.color_qty_btn_icon | default: '#FFFFFF' }};
  }

  @import url('https://fonts.googleapis.com/css2?family=Bai + Jamjuree:ital, wght@0, 200;0, 300;0, 400;0, 500;0, 600;0, 700;1, 200;1, 300;1, 400;1, 500;1, 600;1, 700 &display=swap');

  @font-face {
    font-family: 'Kento';
    src: url('https://cdn.shopify.com/s/files/1/0888/1219/2090/files/Kento-Bold.woff2?v=1764052251') format('woff2')
    , url('https://cdn.shopify.com/s/files/1/0888/1219/2090/files/Kento-Bold.woff?v=1764052252') format('woff');
    font-weight: bold;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'N27';
    src: url('https://cdn.shopify.com/s/files/1/0888/1219/2090/files/N27-RegularItalic.woff2?v=1764133558') format('woff2')
    , url('https://cdn.shopify.com/s/files/1/0888/1219/2090/files/N27-RegularItalic.woff?v=1764133558') format('woff');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'N27';
    src: url('https://cdn.shopify.com/s/files/1/0888/1219/2090/files/N27-Regular.woff2?v=1764133557') format('woff2')
    , url('https://cdn.shopify.com/s/files/1/0888/1219/2090/files/N27-Regular.woff?v=1764133558') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }


  /* Page Preloader */
  .kv-bundle-section {
    background: var(--kv-color-section-bg);
    font-family: 'Bai Jamjuree'
    , sans-serif;
  }

  /* Hero Section */
  .kv-bundle-hero-section {
    padding: 64px 0;
    transition: padding 0.3s ease
    , background 0.3s ease;
    width: 100%;
    z-index: 9;
    position: relative;
  }

  .kv-bundle-hero-section.sticky {
    backdrop-filter: blur(12px);
    background-image: unset !important;
    border: 1px solid var(--kv-color-hero-sticky-border);
    background: var(--kv-color-hero-sticky-bg);
    padding: 24px 0 0;
    position: sticky;
    top: var(--kv-hero-offset, 0px);
  }

  .kv-bundle-hero-container {
    width: 100%;
    max-width: 1000px;
    padding: 0 20px;
    margin: auto;
  }

  .kv-bundle-hero-inner {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    transition: gap 0.3s ease;
  }

  .kv-bundle-hero-section.sticky .kv-bundle-hero-inner {
    justify-content: center;
  }

  .kv-bundle-hero-content {
    max-width: 400px;
    width: 100%;
    color: var(--kv-color-hero-text);
    transition: opacity 0.3s ease
    , transform 0.3s ease;
  }

  .kv-bundle-hero-section.sticky .kv-bundle-hero-content {
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
    display: none;
  }
  .kv-bundle-hero-title {
    margin: 0 0 12px;
    text-transform: uppercase;
    font-family: 'Kento';
    color: var(--kv-color-hero-text);
    font-size: 42px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
  }

  .kv-bundle-hero-description {
    margin: 0;
    color: var(--kv-color-hero-text);
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    font-family: 'N27';
  }

  /* Progress Banner */
.kv-progress-banner {
    padding-top: 12px;
    width: 100%;
    border-radius: 12px;
    max-width: 400px;
    transition: all 0.3s ease;
    background: var(--kv-color-progress-banner-bg);
}

  .kv-bundle-hero-section.sticky .kv-progress-banner {
    max-width: 430px;
    background: transparent;
  }

  .kv-bundle-hero-section.sticky .kv-progress-banner .kv-progress-footer {
    border-radius: 12px 12px 0 0;
    background: var(--kv-color-progress-sticky-footer-bg);
  }

  .kv-promo-banner {
    background-color: var(--kv-color-promo-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 10px 8px 10px 16px;
    overflow: hidden;
    border-radius: 6px;
    width: 390px;
    margin: 12px auto 0;
  }

  .kv-promo-banner-inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kv-promo-banner-text {
    color: var(--kv-color-promo-text);
    font-size: 12px;
    line-height: 1.4;
    text-align: center;
    margin: 0;
    font-family: "Bai Jamjuree";
  }

  .kv-promo-banner-text strong {
    font-weight: 600;
  }

  @media (max-width: 767.98px) {
    .kv-promo-banner {
      padding: 12px 16px;
      // margin: 0 16px;
      border-radius: 10px;
    }

    .kv-promo-banner-text {
      font-size: 12px;
    }
  }

  .kv-progress-bar-container {
    position: relative;
    padding: 32px 0 45px;
    max-width: 290px;
    margin: auto;
  }

  .kv-progress-price {
    position: absolute;
    left: 0;
    bottom: 30px;
    font-size: 16px;
    font-weight: 500;
    color: var(--kv-color-milestone-label);
  }

  .kv-progress-bar {
    width: 100%;
    height: 3px;
    overflow: visible;
    position: relative;
    border-radius: 99px;
    background: var(--kv-color-progress-track);
  }

  .kv-progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--kv-color-progress-fill-start) 0%, var(--kv-color-progress-fill-end) 100%);
    border-radius: 4px;
    width: 0;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 8px var(--kv-color-progress-fill-shadow);
  }

  .kv-progress-milestones {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100%;
  }

  .kv-progress-milestone {
    position: absolute;
    top: 42%;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  .kv-milestone-marker {
    width: 18px;
    height: 18px;
    position: relative;
    z-index: 2;
    transition: all 0.3s ease;
    margin: 0 auto;
    border-radius: 99px;
    border: 2px solid var(--kv-color-milestone-border);
    background: var(--kv-color-milestone-bg);
  }

  .kv-progress-milestone.unlocked .kv-milestone-marker {
    background: var(--kv-color-milestone-unlocked-bg);
    border-color: var(--kv-color-milestone-unlocked-bg);
    transform: unset;
  }

  .kv-milestone-label {
    position: absolute;
    left: 50%;
    white-space: nowrap;
    min-width: 80px;
    bottom: calc(100% + 12px);
    color: var(--kv-color-milestone-label);
    text-align: center;
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    transform: translateX(-50%);
  }

  .kv-milestone-price-display {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    white-space: nowrap;
    color: var(--kv-color-milestone-price);
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
  }

  .kv-progress-milestone.unlocked .kv-milestone-price-display {
    color: var(--kv-color-milestone-price);
  }

  .kv-progress-gifts {
    display: none;
  }

  .kv-progress-footer {
    background: var(--kv-color-progress-footer-bg);
    border-radius: 0;
    padding: 10px 12px;
    text-align: center;
    margin: 8px -16px -12px;

  }
  .kv-progress-footer {
    {% if url contains 'diffuser-overflow-v1' or template.name contains 'diffuser-overflow-v1' %}
      display: block;
    {% else %}
      display: none !important;
    {% endif %}
  }


  .kv-progress-footer-message {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--kv-color-progress-footer-text);
    font-size: 12px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
  }

  .kv-progress-footer-message.clickable {
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .kv-progress-footer-message.clickable:hover {
    opacity: 0.8;
  }

  .kv-progress-footer-message svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .kv-progress-footer-message-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--kv-color-progress-footer-text);
    font-size: 12px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .kv-progress-footer-message-empty:hover {
    opacity: 0.8;
  }

  .kv-progress-footer-message-empty svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .kv-bundle-collection-inner {
    max-width: 1080px;
    padding: 0 20px;
    margin: auto;
  }

  .kv-bundle-collection {
    padding: 24px 0;
    background: var(--kv-color-section-bg);
  }

  .kv-bundle-tabs {
    display: flex;
    gap: 8px;
    margin: 0 0 20px;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .kv-bundle-tab {
    background: transparent;
    padding: 13px 22px;
    cursor: pointer;
    transition: all 0.3s ease;
