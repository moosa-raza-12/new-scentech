      });
  
      // Info popup modal - disabled (scent modal kept as-is)
  
      // Open modals when clicking on milestone gifts
      document.addEventListener('click', function(e) {
        const milestoneGift = e.target.closest('.kv-milestone-gift');
        if (milestoneGift) {
          const milestone = milestoneGift.closest('.kv-progress-milestone');
          if (milestone) {
            const milestoneNumber = milestone.getAttribute('data-milestone');
            e.preventDefault();
            
            // Open scent modal for milestone 1 (first milestone gift)
            if (milestoneNumber === '1') {
              const productData = {
                productId: milestoneGift.getAttribute('data-product-id'),
                title: milestoneGift.getAttribute('data-product-title'),
                description: milestoneGift.getAttribute('data-product-description'),
                details: milestoneGift.getAttribute('data-product-details'),
