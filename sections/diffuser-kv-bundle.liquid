                                    <button class="kv-bundle-interrupter-cta kv-interrupter-add-to-cart" type="button"
                                      data-product-id="{{ intr_atc_product.id }}"
                                      data-product-handle="{{ intr_atc_product.handle }}"
                                      data-variant-id="{{ intr_atc_product.selected_or_first_available_variant.id }}"
                                      data-variant-price="{{ intr_atc_product.selected_or_first_available_variant.price }}"
                                      data-variant-compare-at-price="{{ intr_atc_product.selected_or_first_available_variant.compare_at_price }}"
                                      data-product-title="{{ intr_atc_product.title | escape }}"
                                      data-product-image="{{ intr_atc_product.featured_image | image_url: width: 600 }}"
                                      data-inventory-date="{{ intr_atc_product.metafields.custom.inventory_stock_date }}"
