    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    max-width: 672px;
    margin: 0 auto;
    padding: 16px 24px;
    border: none;
border-radius: 8px;
background: #5c220a;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    font-family: "Bai Jamjuree", sans-serif;
    line-height: normal;
