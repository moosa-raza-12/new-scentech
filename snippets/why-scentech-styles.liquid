{%- comment -%}
  Why ScenTech styles
  Params: section_id, section_bg_color, card_bg_color, heading_color, body_color,
          padding_top, padding_bottom, heading_alignment
{%- endcomment -%}

<style>
  {{ settings.text_font | font_face: font_display: 'swap' }}
  {%- if settings.text_font.bold_variant -%}
    {{ settings.text_font.bold_variant | font_face: font_display: 'swap' }}
  {%- endif -%}

  /* Zero out Shopify wrapper padding injected by theme .section rules.
     Works even if schema "class" reverts to "section" mid-session. */
  .shopify-section:has(> [data-section-id="{{ section_id }}"]) {
    padding: 0 !important;
  }

  [data-section-id="{{ section_id }}"].wsc-section {
    padding-top: var(--wsc-pad-top, {{ padding_top | default: 24 }}px);
    padding-bottom: var(--wsc-pad-bot, {{ padding_bottom | default: 24 }}px);
    background: {{ section_bg_color | default: '#ffffff' }};
  }

  [data-section-id="{{ section_id }}"] .wsc-section__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  [data-section-id="{{ section_id }}"] .wsc-section__heading {
    font-family: "{{ heading_font | default: 'Kento-Bold' }}", sans-serif !important;
    font-weight: 400;
    color: {{ heading_color | default: '#160000' }};
    font-size: {{ heading_size | default: 48 }}px;
    line-height: 1.1;
    margin: 0 0 48px;
    text-align: {{ heading_alignment | default: 'center' }};
  }
  @media (max-width: 749px) {
    [data-section-id="{{ section_id }}"] .wsc-section__heading {
      font-size: calc({{ heading_size | default: 48 }}px * 0.7);
    }
  }

  [data-section-id="{{ section_id }}"] .wsc-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 8px;
    scroll-padding-left: 16px;
  }
  [data-section-id="{{ section_id }}"] .wsc-track::-webkit-scrollbar { display: none; }

  [data-section-id="{{ section_id }}"] .wsc-card {
    flex: 0 0 auto;
    width: 80vw;
    max-width: 380px;
    background: {{ card_bg_color | default: '#fcfbf4' }};
    border-radius: var(--rounded-lg);
    overflow: hidden;
    scroll-snap-align: start;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  [data-section-id="{{ section_id }}"].is-visible .wsc-card {
    opacity: 1;
    transform: translateY(0);
  }

  [data-section-id="{{ section_id }}"].is-visible .wsc-card:nth-child(1) { transition-delay: 0ms; }
  [data-section-id="{{ section_id }}"].is-visible .wsc-card:nth-child(2) { transition-delay: 80ms; }
  [data-section-id="{{ section_id }}"].is-visible .wsc-card:nth-child(3) { transition-delay: 160ms; }
  [data-section-id="{{ section_id }}"].is-visible .wsc-card:nth-child(4) { transition-delay: 240ms; }
  [data-section-id="{{ section_id }}"].is-visible .wsc-card:nth-child(5) { transition-delay: 320ms; }
  [data-section-id="{{ section_id }}"].is-visible .wsc-card:nth-child(6) { transition-delay: 400ms; }

  [data-section-id="{{ section_id }}"] .wsc-card__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: {{ card_bg_color | default: '#fcfbf4' }};
    overflow: hidden;
  }

  [data-section-id="{{ section_id }}"] .wsc-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  [data-section-id="{{ section_id }}"] .wsc-card__body {
    padding: 24px 24px 32px;
  }

  [data-section-id="{{ section_id }}"] .wsc-card__heading {
    font-family: "{{ card_heading_font | default: 'Kento-Bold' }}", sans-serif !important;
    font-weight: 400;
    color: {{ heading_color | default: '#160000' }};
    font-size: {{ card_heading_size | default: 20 }}px;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  [data-section-id="{{ section_id }}"] .wsc-card__desc {
    font-family: "{{ card_desc_font | default: 'BaiJamjuree-Regular' }}", sans-serif;
    color: {{ body_color | default: '#162518' }};
    opacity: 0.8;
    font-size: {{ card_desc_size | default: 15 }}px;
    line-height: 1.5;
  }

  [data-section-id="{{ section_id }}"] .wsc-card__desc p { margin: 0; }
  [data-section-id="{{ section_id }}"] .wsc-card__desc p + p { margin-top: 8px; }

  @media (max-width: 749px) {
    [data-section-id="{{ section_id }}"].wsc-section {
      padding-top: calc(var(--wsc-pad-top) * 0.7);
      padding-bottom: calc(var(--wsc-pad-bot) * 0.7);
    }
    [data-section-id="{{ section_id }}"] .wsc-section__inner {
      padding: 0;
    }
    [data-section-id="{{ section_id }}"] .wsc-section__heading {
      padding: 0 24px;
    }
    [data-section-id="{{ section_id }}"] .wsc-track {
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  @media (min-width: 750px) {
    [data-section-id="{{ section_id }}"] .wsc-track {
      gap: 24px;
    }
    [data-section-id="{{ section_id }}"] .wsc-card {
      width: calc((100% - 24px) / 2);
      max-width: none;
    }
  }

  @media (min-width: 990px) {
    [data-section-id="{{ section_id }}"] .wsc-card {
      width: calc((100% - 48px) / 3);
    }
    [data-section-id="{{ section_id }}"] .wsc-section__inner {
      padding: 0 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-section-id="{{ section_id }}"] .wsc-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
