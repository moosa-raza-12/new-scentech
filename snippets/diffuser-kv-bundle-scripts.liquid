      // Close modal handlers
      scentModalClose.addEventListener('click', closeScentModal);
      scentModalOverlay.addEventListener('click', closeScentModal);
  
      // Modal Add button - find and click the product's Add button
      scentModalAdd.addEventListener('click', function() {
        if (currentModalProductId) {
          const productCard = document.querySelector(`[data-product-id="${currentModalProductId}"]`);
          if (productCard) {
