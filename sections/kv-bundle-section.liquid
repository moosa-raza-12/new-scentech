<div class="kv-page-preloader" id="kv-page-preloader">
  <div class="kv-preloader-spinner"></div>
</div>

<div class="kv-bundle-section">
    {% assign gift1_product = nil %}
    {% assign gift2_product = nil %}
    {% assign gift3_product = nil %}
    {% assign gift4_product = nil %}
    {% if section.settings.gift_1_product != blank %}
      {% assign gift1_product = all_products[section.settings.gift_1_product] %}
    {% endif %}
    {% if section.settings.gift_2_product != blank %}
      {% assign gift2_product = all_products[section.settings.gift_2_product] %}
    {% endif %}
    {% if section.settings.gift_3_product != blank %}
      {% assign gift3_product = all_products[section.settings.gift_3_product] %}
    {% endif %}
    {% if section.settings.gift_4_product != blank %}
      {% assign gift4_product = all_products[section.settings.gift_4_product] %}
    {% endif %}
    {% assign gift_1_image_url = '' %}
    {% if gift1_product and gift1_product.featured_image %}
      {% assign gift_1_image_url = gift1_product.featured_image | image_url: width: 80 %}
    {% endif %}
    {% assign gift_1_text = '' %}
    {% if section.settings.gift_1_custom_text != blank %}
      {% assign gift_1_text = section.settings.gift_1_custom_text %}
    {% elsif gift1_product %}
      {% assign gift_1_text = 'FREE<br>' | append: gift1_product.title %}
    {% endif %}
    {% assign gift_1_inventory_date = '' %}
    {% if gift1_product and gift1_product.metafields.custom.inventory_stock_date %}
      {% assign gift_1_inventory_date = gift1_product.metafields.custom.inventory_stock_date %}
    {% endif %}
    {% assign gift_2_image_url = '' %}
    {% if gift2_product and gift2_product.featured_image %}
      {% assign gift_2_image_url = gift2_product.featured_image | image_url: width: 80 %}
    {% endif %}
    {% assign gift_2_text = '' %}
    {% if section.settings.gift_2_custom_text != blank %}
      {% assign gift_2_text = section.settings.gift_2_custom_text %}
    {% elsif gift2_product %}
      {% assign gift_2_text = 'FREE<br>' | append: gift2_product.title %}
    {% endif %}
    {% assign gift_2_inventory_date = '' %}
    {% if gift2_product and gift2_product.metafields.custom.inventory_stock_date %}
      {% assign gift_2_inventory_date = gift2_product.metafields.custom.inventory_stock_date %}
    {% endif %}
    {% assign gift_3_image_url = '' %}
    {% if gift3_product and gift3_product.featured_image %}
      {% assign gift_3_image_url = gift3_product.featured_image | image_url: width: 80 %}
    {% endif %}
    {% assign gift_3_text = '' %}
    {% if section.settings.gift_3_custom_text != blank %}
      {% assign gift_3_text = section.settings.gift_3_custom_text %}
    {% elsif gift3_product %}
      {% assign gift_3_text = 'FREE<br>' | append: gift3_product.title %}
    {% endif %}
    {% assign gift_3_inventory_date = '' %}
    {% if gift3_product and gift3_product.metafields.custom.inventory_stock_date %}
      {% assign gift_3_inventory_date = gift3_product.metafields.custom.inventory_stock_date %}
    {% endif %}
    {% assign gift_4_image_url = '' %}
    {% if gift4_product and gift4_product.featured_image %}
      {% assign gift_4_image_url = gift4_product.featured_image | image_url: width: 80 %}
    {% endif %}
    {% assign gift_4_text = '' %}
    {% if section.settings.gift_4_custom_text != blank %}
      {% assign gift_4_text = section.settings.gift_4_custom_text %}
    {% elsif gift4_product %}
      {% assign gift_4_text = 'FREE<br>' | append: gift4_product.title %}
    {% endif %}
    {% assign gift_4_inventory_date = '' %}
    {% if gift4_product and gift4_product.metafields.custom.inventory_stock_date %}
      {% assign gift_4_inventory_date = gift4_product.metafields.custom.inventory_stock_date %}
    {% endif %}
    {%- comment -%} Progress Banner {%- endcomment -%}
    <div class="kv-bundle-hero-section" style="background-image: url({{ section.settings.hero_background_image | image_url: width: 1920 }}); background-size: cover; background-position: center;">
      <div class="kv-bundle-hero-container">
        <div class="kv-bundle-hero-inner">
          <div class="kv-bundle-hero-content">
            <h2 class="kv-bundle-hero-title">{{ section.settings.hero_title }}</h2>
            <p class="kv-bundle-hero-description">{{ section.settings.hero_description }}</p>
          </div>
          <div class="kv-progress-banner">
              <div class="kv-progress-banner-inner">
                  <div class="kv-progress-bar-container">
                      <div class="kv-progress-bar">
                          <div class="kv-progress-bar-fill" id="kv-progress-fill"></div>
                      </div>
                      <div class="kv-progress-milestones">
                          {% if section.settings.milestone_1_count > 0 %}
                          {% assign milestone_1_label_text = section.settings.milestone_1_label | default: '{count} geuren' | replace: '{count}', section.settings.milestone_1_count %}
                          <div class="kv-progress-milestone" data-milestone="1" data-count="{{ section.settings.milestone_1_count }}" style="left: 0%;">
                              <div class="kv-milestone-marker"></div>
                              <div class="kv-milestone-label">{{ milestone_1_label_text }}</div>
                              {% if section.settings.gift_1_product != blank %}
                              <div class="kv-milestone-gift"
                                data-product-id="{{ gift1_product.id }}"
                                data-product-title="{{ gift1_product.title | escape }}"
                                data-product-description="{{ gift1_product.metafields.custom.scent_popup_description | default: gift1_product.description | strip_html | strip | escape }}"
                                data-product-details="{{ gift1_product.metafields.custom.scent_details | escape }}"
                                data-product-image="{% if gift1_product.metafields.custom.scent_image %}{{ gift1_product.metafields.custom.scent_image | image_url: width: 1200 }}{% elsif gift1_product.featured_image %}{{ gift1_product.featured_image | image_url: width: 1200 }}{% endif %}"
                                data-product-variant="{{ gift1_product.metafields.custom.quantity_value | default: gift1_product.selected_or_first_available_variant.title | escape }}"
                                data-product-badge="{{ gift1_product.metafields.custom.collection_card_badge }}">
                                  {% if gift1_product.metafields.custom.progress_gift_image %}
                                  <img src="{{ gift1_product.metafields.custom.progress_gift_image | image_url: width: 80 }}" alt="{{ gift1_product.title }}" class="kv-milestone-gift-image">
                                  {% elsif gift1_product.featured_image %}
                                  <img src="{{ gift1_product.featured_image | image_url: width: 80 }}" alt="{{ gift1_product.title }}" class="kv-milestone-gift-image">
                                  {% endif %}
                                  <div class="kv-milestone-gift-text">
                                      {% if section.settings.gift_1_custom_text != blank %}
                                          {{ section.settings.gift_1_custom_text }}
                                      {% else %}
                                          FREE<br>{{ gift1_product.title }}
                                      {% endif %}
                                  </div>
                              </div>
                              {% endif %}
                          </div>
                          {% endif %}
                          {% if section.settings.milestone_2_count > 0 %}
                          {% assign milestone_2_label_text = section.settings.milestone_2_label | default: '{count} geuren' | replace: '{count}', section.settings.milestone_2_count %}
                          <div class="kv-progress-milestone open-comparison-popup" data-milestone="2" data-count="{{ section.settings.milestone_2_count }}" style="left: 33.33%;">
                              <div class="kv-milestone-marker"></div>
                              <div class="kv-milestone-label">{{ milestone_2_label_text }}</div>
                              {% if section.settings.gift_2_product != blank %}
                              <div class="kv-milestone-gift">
                                  {% if gift2_product.metafields.custom.progress_gift_image %}
                                  <img src="{{ gift2_product.metafields.custom.progress_gift_image | image_url: width: 80 }}" alt="{{ gift2_product.title }}" class="kv-milestone-gift-image">
                                  {% elsif gift2_product.featured_image %}
                                  <img src="{{ gift2_product.featured_image | image_url: width: 80 }}" alt="{{ gift2_product.title }}" class="kv-milestone-gift-image">
                                  {% endif %}
                                  <div class="kv-milestone-gift-text">
                                      {% if section.settings.gift_2_custom_text != blank %}
                                          {{ section.settings.gift_2_custom_text }}
                                      {% else %}
                                          FREE<br>{{ gift2_product.title }}
                                      {% endif %}
                                  </div>
                              </div>
                              {% endif %}
                          </div>
                          {% endif %}
                          {% if section.settings.milestone_3_count > 0 %}
                          {% assign milestone_3_label_text = section.settings.milestone_3_label | default: '{count} geuren' | replace: '{count}', section.settings.milestone_3_count %}
                          <div class="kv-progress-milestone open-comparison-popup" data-milestone="3" data-count="{{ section.settings.milestone_3_count }}" style="left: 66.66%;">
                              <div class="kv-milestone-marker"></div>
                              <div class="kv-milestone-label">{{ milestone_3_label_text }}</div>
                              {% if section.settings.gift_3_product != blank %}
                              <div class="kv-milestone-gift">
                                  {% if gift3_product.metafields.custom.progress_gift_image %}
                                  <img src="{{ gift3_product.metafields.custom.progress_gift_image | image_url: width: 80 }}" alt="{{ gift3_product.title }}" class="kv-milestone-gift-image">
                                  {% elsif gift3_product.featured_image %}
                                  <img src="{{ gift3_product.featured_image | image_url: width: 80 }}" alt="{{ gift3_product.title }}" class="kv-milestone-gift-image">
                                  {% endif %}
                                  <div class="kv-milestone-gift-text">
                                      {% if section.settings.gift_3_custom_text != blank %}
                                          {{ section.settings.gift_3_custom_text }}
                                      {% else %}
                                          FREE<br>{{ gift3_product.title }}
                                      {% endif %}
                                  </div>
                              </div>
                              {% endif %}
                          </div>
                          {% endif %}
                          {% if section.settings.milestone_4_count > 0 %}
                          {% assign milestone_4_label_text = section.settings.milestone_4_label | default: '{count} geuren' | replace: '{count}', section.settings.milestone_4_count %}
                          <div class="kv-progress-milestone open-comparison-popup" data-milestone="4" data-count="{{ section.settings.milestone_4_count }}" style="left: 100%;">
                              <div class="kv-milestone-marker"></div>
                              <div class="kv-milestone-label">{{ milestone_4_label_text }}</div>
                              {% if section.settings.gift_4_product != blank %}
                              <div class="kv-milestone-gift">
                                  {% if gift4_product.metafields.custom.progress_gift_image %}
                                  <img src="{{ gift4_product.metafields.custom.progress_gift_image | image_url: width: 80 }}" alt="{{ gift4_product.title }}" class="kv-milestone-gift-image">
                                  {% elsif gift4_product.featured_image %}
                                  <img src="{{ gift4_product.featured_image | image_url: width: 80 }}" alt="{{ gift4_product.title }}" class="kv-milestone-gift-image">
                                  {% endif %}
                                  <div class="kv-milestone-gift-text">
                                      {% if section.settings.gift_4_custom_text != blank %}
                                          {{ section.settings.gift_4_custom_text }}
                                      {% else %}
                                          FREE<br>{{ gift4_product.title }}
                                      {% endif %}
                                  </div>
                              </div>
                              {% endif %}
                          </div>
                          {% endif %}
                      </div>
                  </div>
                  <div class="kv-progress-footer" id="kv-progress-footer-normal">
                      <div class="kv-progress-footer-message" id="kv-progress-footer-message">
                        <svg width="12" height="13" viewBox="0 0 12 13" fill="none" xmlns="http://www.w3.org/2000/svg">
