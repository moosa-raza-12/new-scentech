    gap: 4px;
}
  
.kv-bundle-tab:hover {
    background: var(--kv-tab-hover-bg);
}
  
.kv-bundle-tab.active {
    color: var(--kv-tab-active-text);
    border-color: var(--kv-tab-active-bg);
    background: var(--kv-tab-active-bg);
}

.kv-bundle-tab #kv-total-count {
    border-radius: 99px;
    background: var(--kv-tab-count-bg);
