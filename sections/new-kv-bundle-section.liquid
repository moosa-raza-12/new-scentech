// --- Bundle "Part of" tag visibility sync ---
// Show .kv-bundle-product-bundle-tag on a product card only while at least
// one bundle interrupter containing that product currently has qty > 0 in
// the in-page cart. Hides the tag again when the bundle is removed.
(function () {
  function readInterrupterQty(blockId) {
    var wrapper = document.querySelector('.kv-interrupter-qty-wrapper[data-block-id="' + blockId + '"]');
    if (!wrapper) return 0;
    if (wrapper.style.display === 'none') return 0;
    var input = wrapper.querySelector('.kv-bundle-qty-input');
    if (!input) return 0;
    var q = parseInt(input.value, 10);
    return isNaN(q) ? 0 : q;
  }

  function kvSyncAllBundleTags() {
    var intrData = window.__kvInterrupterProducts || {};
    var activeProductIds = Object.create(null);
    Object.keys(intrData).forEach(function (blockId) {
      var products = intrData[blockId] || [];
      if (products.length < 2) return; // only bundle interrupters (>= 2 products) drive the tag
      var qty = readInterrupterQty(blockId);
      if (qty > 0) {
        products.forEach(function (p) { activeProductIds[String(p.id)] = true; });
      }
    });
    document.querySelectorAll('.kv-bundle-product-card[data-product-id]').forEach(function (card) {
      var pid = card.getAttribute('data-product-id');
      if (activeProductIds[pid]) {
        card.classList.add('kv-bundle-active');
      } else {
        card.classList.remove('kv-bundle-active');
      }
    });
  }

  window.kvSyncAllBundleTags = kvSyncAllBundleTags;

  var syncScheduled = false;
  function scheduleSync() {
    if (syncScheduled) return;
    syncScheduled = true;
    requestAnimationFrame(function () {
      syncScheduled = false;
      kvSyncAllBundleTags();
    });
  }

  function attach() {
    kvSyncAllBundleTags();
    var root = document.querySelector('.kv-bundle-collection') || document.body;
    if ('MutationObserver' in window) {
      // The interrupter scripts mutate the qty wrapper's display style and
      // re-render the thumbnail carousel whenever bundle qty changes; both
      // surface here as childList / attribute mutations.
      new MutationObserver(scheduleSync).observe(root, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['style', 'class']
      });
    }
    // Catch direct clicks on the bundle qty buttons (covers the input.value
    // assignments that don't trigger mutation observers).
    document.addEventListener('click', function (e) {
      if (!e.target) return;
      var btn = e.target.closest && e.target.closest('.kv-interrupter-add-to-cart, .kv-intr-qty-increase, .kv-intr-qty-decrease, .kv-bundle-thumbnail-remove');
      if (btn) scheduleSync();
    }, true);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attach);
  } else {
    attach();
  }
})();
</script>
