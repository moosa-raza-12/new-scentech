<style>
  .cds-highlight {
    display: none;
  }

  .cds-cards.active .cds-highlight {
    display: block;

    /* or flex, depending on your layout */
  }
  .compare-icon-wrapper {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    cursor: pointer;
  }
  .custom-diffuser-selector {
    width: 100%;
    max-width: 1000px;
    padding: 20px 20px 12px;
    margin: auto;
  }
  @media (max-width: 639px) {
    .custom-diffuser-selector {
      padding: 20px 20px 0;
    }
  }


  /*

   .cds-header-content{ 
   display: flex; 
   justify-content: space-between; 
   } 
*/

  /* Header */.cds-header {
    margin-bottom: 16px;
  }
  .cds-header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cds-left {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }
  @media (max-width: 749px) {
    .cds-left {
      gap: 8px;
    }
  }
  .cds-step {
    width: 34px;
    height: 34px;
    background: var(--cds-banner-bg, #938E70);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    font-size: 16px;
  }
  @media (max-width: 639px) {
    .cds-step {
      width: 24px !important;
      height: 24px !important;
      font-size: 12px !important;
    }

  }
  .cds-title {
    color: #160000;
    font-weight: 400;
    margin: 0;
    font-size: 20px;
    font-family: N27;
  }
  @media (max-width: 639px) {
    .cds-title {
      text-align: center;
      font-size: 16px !important;
    }
    .compare-icon-wrapper {
      gap: 6px;
    }
    .cds-subtext {
      margin-top: 12px;
      font-size: 12px;
    }
    .cds-header {
      margin-bottom: 20px;
    }
    .cds-compare {
      font-size: 14px;
    }
  }

  .cds-subtext {
    margin-top: 12px;
    color: #160000;

    font-weight: 400;
    letter-spacing: 0;
  }

  .cds-compare {
    color: #162518;
    font-size: 12px;
    font-weight: 600;
    text-decoration-line: underline;
  }

  /* Banner */
  .cds-banner {
    border-radius: 6px;
    background: var(--cds-banner-bg, #938E70);
    color: #fff;
    padding: 14px;
    margin-bottom: 20px;
    text-align: center;
    font-size: 14px;
  }
  @media screen and (max-width: 639px) {
    .cds-banner {
      padding: 10px 16px;
      font-size: 12px;
      margin-bottom: 20px;
    }
  }
  /* Cards */
  .cds-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cds-cards {
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
  }

  .cds-cards.active {
    border: 1px solid #160000;
  }

  .cds-card.active {
    border: 2px solid #2e2e2e;
  }

  .cds-card-innerss {
    display: flex;
    gap: 20px;
    padding: 6px 20px 6px 6px;
    cursor: pointer;
    align-items: center;
  }

  .cds-image img {
    width: 70px;
    height: auto;
    border-radius: 8px;
  }

  .cds-content {
    flex: 1;
  }

  .cds-name {
    margin: 0;
    color: #160000;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    font-family: N27;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cds-info-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    pointer-events: auto;
    position: relative;
    z-index: 2;
  }
  @media (max-width: 639px) {
    .cds-name {
      font-size: 16px !important;
    }
    .cds-image img {
      heigth: 80px;
      width: 80px;
    }
  }

  .cds-desc {
    margin: 5px 0 0;
    color: #160000;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: normal;
  }
  @media (max-width: 639px) {
    .cds-desc {
      font-size: 12px !important;
    }
    .cds-header-content {
      display: flex;
      width: 100%;
      justify-content: space-between;
    }
  }
  .cds-price {
    text-align: right;
    display: flex;
    gap: 5px;
  }

  .cds-price .old {
    display: block;
    text-decoration: line-through;
    color: #160000;
    font-size: 16px;
    opacity: 0.4;
  }

  .cds-price .new {
    font-weight: 600;
    font-size: 16px;
    color: #160000;
  }
  @media (max-width: 749px) {
    .cds-price .new {
      font-size: 12px;
    }
    .cds-price .old {
      font-size: 12px;
    }
  }
  /* Locked state – cards not selectable until 2 scents are added */
  .cds-cards.cds-locked {
    /* opacity: 0.45; */
    pointer-events: none;
    position: relative;
    user-select: none;
  }
  .cds-cards.cds-locked .cds-card-innerss {
    cursor: not-allowed;
  }
  .cds-lock-overlay {
    display: none;
    background: rgba(0, 0, 0, 0.06);
    padding: 8px 12px;
    text-align: center;
    font-size: 12px;
    color: #5c220a;
    font-weight: 600;
  }
  .cds-cards.cds-locked .cds-lock-overlay {
    display: block;
  }

  /* Highlight footer */
  .cds-highlight {
    background: rgba(0, 0, 0, 0.10);
    padding: 10px 12px;
    text-align: center;
    font-size: 12px;
  }
  .cds-highlight-text {
    color: {{ section.settings.highlight_text_color | default: '#5c220a' }};
    font-size: 12px;
    font-weight: 400;
  }

  /* Second diffuser accordion */
  .lp-diffuser-accordion {
    width: 100%;
    max-width: 960px;
    margin-top: 12px;
  }
  .lp-diffuser-accordion__trigger {
    width: 100%;
    border-radius: 8px;
    border: 1px dashed rgba(22, 0, 0, 0.10);
    background: {{ section.settings.background_color | default: '#fff' }};
    padding: 4px 4px 4px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  @media (max-width: 748px) {
    .lp-diffuser-accordion__trigger {
      border-radius: 12px;
    }
  }
  .lp-diffuser-accordion__heading-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  .accordion__icon-open,
  .accordion__icon-close {
    line-height: 0;
  }
  .lp-diffuser-accordion__heading {
    color: #160000;
    font-family: "Bai Jamjuree";
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }
  .lp-diffuser-accordion.active .lp-diffuser-accordion__heading {
    color: #222222;
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
  }
  .lp-diffuser-accordion__icon {
    display: flex;
    width: 28px;
    height: 28px;
    justify-content: center;
    align-items: center;
    border-radius: 6px;
    background: {{ section.settings.icon_background | default: '#f0f0f0' }};
    color: {{ section.settings.icon_color | default: '#160000' }};
    font-size: {{ section.settings.icon_font_size | default: 16 }}px;
    font-weight: 600;
    flex-shrink: 0;
  }
  .lp-diffuser-accordion__content {
    display: none;
    max-height: 0;
    overflow: hidden;
    padding: 6px;
    transition: max-height 0.35s ease;
    border-radius: 8px;
    background: #FFF;
    border: 1px solid rgba(22, 0, 0, 0.10);
    border-top: none;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  .lp-diffuser-accordion__inner {
    padding-top: 16px;
    color: {{ section.settings.content_color | default: '#160000' }};
    font-size: {{ section.settings.content_size | default: 14 }}px;
    line-height: 1.6;
  }
  .lp-diffuser-accordion.active .lp-diffuser-accordion__trigger {
    border-style: solid;
    border-bottom: none;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding: 12px 16px 0;
  }
  .lp-diffuser-accordion__content .cds-card-innerss {
    background-color: #F8F7F4;
    /* backdrop-filter: blur(2px); */
  }
</style>

<div class="custom-diffuser-selector">

  <!-- Header -->
  <div class="cds-header">
    <div class="cds-header-content">
      <div class="cds-left">
        <div class="cds-step">{{ section.settings.selector_step }}</div>
        <div>
          <h2 class="cds-title">{{ section.settings.selector_heading }}</h2>
        </div>

      </div>
      <div class="compare-icon-wrapper">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none">
          <path d="M7 14C6.03356 14 5.12752 13.8166 4.28188 13.4497C3.43624 13.0872 2.69128 12.5861 2.04698 11.9463C1.40716 11.3065 0.90604 10.5638 0.543624 9.71812C0.181208 8.87248 0 7.96644 0 7C0 6.03356 0.181208 5.12752 0.543624 4.28188C0.90604 3.43624 1.40716 2.69351 2.04698 2.05369C2.69128 1.4094 3.43624 0.90604 4.28188 0.543624C5.12752 0.181208 6.03356 0 7 0C7.96644 0 8.87248 0.181208 9.71812 0.543624C10.5638 0.90604 11.3065 1.4094 11.9463 2.05369C12.5861 2.69351 13.0872 3.43624 13.4497 4.28188C13.8166 5.12752 14 6.03356 14 7C14 7.96644 13.8166 8.87248 13.4497 9.71812C13.0872 10.5638 12.5861 11.3065 11.9463 11.9463C11.3065 12.5861 10.5638 13.0872 9.71812 13.4497C8.87248 13.8166 7.96644 14 7 14ZM7 12.4631C7.75615 12.4631 8.46309 12.3221 9.12081 12.0403C9.783 11.7584 10.3624 11.3669 10.8591 10.8658C11.3602 10.3602 11.7517 9.77852 12.0336 9.12081C12.3199 8.45861 12.4631 7.75168 12.4631 7C12.4631 6.24385 12.3199 5.53691 12.0336 4.87919C11.7517 4.217 11.3602 3.63535 10.8591 3.13423C10.3624 2.63311 9.783 2.24161 9.12081 1.95973C8.46309 1.67785 7.75615 1.53691 7 1.53691C6.24385 1.53691 5.53468 1.67785 4.87248 1.95973C4.21477 2.24161 3.63535 2.63311 3.13423 3.13423C2.63311 3.63535 2.24161 4.217 1.95973 4.87919C1.67785 5.53691 1.53691 6.24385 1.53691 7C1.53691 7.75168 1.67785 8.45861 1.95973 9.12081C2.24161 9.77852 2.63311 10.3602 3.13423 10.8658C3.63535 11.3669 4.21477 11.7584 4.87248 12.0403C5.53468 12.3221 6.24385 12.4631 7 12.4631ZM6.84564 8.30201C6.37136 8.30201 6.13423 8.09843 6.13423 7.69128C6.13423 7.68233 6.13423 7.67338 6.13423 7.66443C6.13423 7.65101 6.13423 7.63758 6.13423 7.62416C6.13423 7.33781 6.21029 7.10067 6.36242 6.91275C6.51454 6.72483 6.70917 6.55034 6.94631 6.38926C7.22371 6.19239 7.43177 6.02908 7.57047 5.89933C7.71365 5.76958 7.78523 5.60403 7.78523 5.40268C7.78523 5.19687 7.70693 5.02685 7.55034 4.89262C7.39821 4.75391 7.19687 4.68456 6.94631 4.68456C6.8255 4.68456 6.71141 4.7047 6.60403 4.74497C6.49664 4.78523 6.39821 4.8434 6.30872 4.91946C6.