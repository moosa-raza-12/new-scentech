<script>
    function getAmsterdamToday() {
      const now = new Date();
      const ams = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
      if (ams.getHours() > 22 || (ams.getHours() === 22 && ams.getMinutes() >= 59)) {
        ams.setDate(ams.getDate() + 1);
      }
      ams.setHours(0, 0, 0, 0);
      return ams;
    }
  
    function getShippingDate() {
      const today = getAmsterdamToday();
      const day = today.getDay();
      if (day === 0) today.setDate(today.getDate() + 1);
      if (day === 6) today.setDate(today.getDate() + 2);
      return today;
    }
  
    // Selected products tracker
    let selectedProducts = [];
    
    // Get Shopify money format from theme settings
    const moneyFormat = '{{ shop.money_format }}' || '${{amount}}';
  
    const kvCountryCode = '{{ localization.country.iso_code }}';
    const kvCountryName = '{{ localization.country.name }}';
  
    const kvDeliveryDays = {
      nl: {{ settings.delivery_days_nl | default: 1 }},
      be: {{ settings.delivery_days_be | default: 1 }},
      de: {{ settings.delivery_days_de | default: 2 }},
      euMin: {{ settings.delivery_days_eu_min | default: 3 }},
      euMax: {{ settings.delivery_days_eu_max | default: 4 }},
      rowMin: {{ settings.delivery_days_row_min | default: 6 }},
      rowMax: {{ settings.delivery_days_row_max | default: 10 }}
    };
  
    function getInstockCollapsedMessage() {
      return 'Your order ships out today from the Netherlands.';
    }
  
    function getInstockDeliveryDateRange() {
      const euCountries = ['AT','BG','HR','CY','CZ','DK','EE','FI','FR','GR','HU','IE','IT','LV','LT','LU','MT','PL','PT','RO','SK','SI','ES','SE'];
      const monthNames = ["January","February","March","April","May","June","July","August","September","October","November","December"];
      const shipDate = getShippingDate();
      let minDays, maxDays;
  
      switch (kvCountryCode) {
        case 'NL': minDays = kvDeliveryDays.nl; maxDays = kvDeliveryDays.nl; break;
        case 'BE': minDays = kvDeliveryDays.be; maxDays = kvDeliveryDays.be; break;
        case 'DE': minDays = kvDeliveryDays.de; maxDays = kvDeliveryDays.de; break;
        default:
          if (euCountries.includes(kvCountryCode)) {
            minDays = kvDeliveryDays.euMin;
            maxDays = kvDeliveryDays.euMax;
          } else {
            minDays = kvDeliveryDays.rowMin;
            maxDays = kvDeliveryDays.rowMax;
          }
      }
  
      const startDate = new Date(shipDate);
      startDate.setDate(startDate.getDate() + minDays);
      const endDate = new Date(shipDate);
      endDate.setDate(endDate.getDate() + maxDays);
  
      if (minDays === maxDays) {
        return `${startDate.getDate()} ${monthNames[startDate.getMonth()]}`;
      } else if (startDate.getMonth() === endDate.getMonth()) {
        return `${startDate.getDate()} - ${endDate.getDate()} ${monthNames[endDate.getMonth()]}`;
      } else {
        return `${startDate.getDate()} ${monthNames[startDate.getMonth()]} - ${endDate.getDate()} ${monthNames[endDate.getMonth()]}`;
      }
    }
  
    // Progress bar milestones (product counts)
    const textLabels = {
      free: '{{ section.settings.text_free | default: "FREE" }}',
      freeGift: '{{ section.settings.text_free_gift | default: "Free Gift" }}',
      addScents: '{{ section.settings.text_add_scents | default: "Add Scents" }}',
      continue: '{{ section.settings.text_continue | default: "Continue" }}',
      addToCart: '{{ section.settings.text_add_to_cart | default: "Add to Cart" }}',
      noItems: '{{ section.settings.text_no_items | default: "No items selected" }}',
      save: '{{ section.settings.text_save | default: "SAVE" }}',
      preOrderShips: '{{ section.settings.text_preorder_ships | default: "Pre-Order: Ships by" }}',
      giftPreOrderPrefix: '{{ section.settings.text_gift_preorder_prefix | default: "The" }}',
      giftPreOrderSuffix: '{{ section.settings.text_gift_preorder_suffix | default: "is on Pre-Order. Delivers on" }}'
    };
  
    function parseMilestonePrice(priceStr) {
      if (!priceStr) return 0;
      const cleaned = priceStr.replace(/[^\d,\.]/g, '').replace(',', '.');
      return Math.round(parseFloat(cleaned) * 100) || 0;
    }

    const milestones = {
      milestone1: {{ section.settings.milestone_1_count | default: 0 }},
      milestone2: {{ section.settings.milestone_2_count | default: 0 }},
      milestone3: {{ section.settings.milestone_3_count | default: 0 }},
      milestone4: {{ section.settings.milestone_4_count | default: 0 }},
      milestone1Price: parseMilestonePrice('{{ section.settings.milestone_1_price }}'),
      milestone2Price: parseMilestonePrice('{{ section.settings.milestone_2_price }}'),
      milestone3Price: parseMilestonePrice('{{ section.settings.milestone_3_price }}'),
      milestone4Price: parseMilestonePrice('{{ section.settings.milestone_4_price }}'),
      milestone1Text: '{{ section.settings.milestone_1_text | default: "Add [count] more scents for a FREE gift!" }}',
      milestone2Text: '{{ section.settings.milestone_2_text | default: "Add [count] more scents for a FREE gift!" }}',
      milestone3Text: '{{ section.settings.milestone_3_text | default: "Add [count] more scents for a FREE gift!" }}',
      milestone4Text: '{{ section.settings.milestone_4_text | default: "Add [count] more scents for a FREE gift!" }}',
      startText: '{{ section.settings.progress_start_text | default: "Start building your bundle!" }}',
      completeText: '{{ section.settings.progress_complete_text | default: "ðŸŽ‰ Congratulations! All rewards unlocked!" }}'
    };

    function getMilestonePricePerScent(scentCount) {
      if (milestones.milestone4 > 0 && scentCount >= milestones.milestone4) {
        return milestones.milestone4Price;
      } else if (milestones.milestone3 > 0 && scentCount >= milestones.milestone3) {
        return milestones.milestone3Price;
      } else if (milestones.milestone2 > 0 && scentCount >= milestones.milestone2) {
        return milestones.milestone2Price;
      }
      return milestones.milestone1Price;
    }
  
    const milestoneGifts = [];
  
    document.addEventListener('DOMContentLoaded', function() {
      // Hide preloader after page load
      const preloader = document.getElementById('kv-page-preloader');
      if (preloader) {
        setTimeout(() => {
          preloader.classList.add('hidden');
          setTimeout(() => {
            preloader.style.display = 'none';
          }, 500);
        }, 300);
      }
  
      // Update total count - count of all products across all tabs
      const totalCountElement = document.getElementById('kv-total-count');
      if (totalCountElement) {
        const allProductsGrid = document.querySelector('[data-content="all"] .kv-bundle-products-grid');
        const productCount = allProductsGrid ? allProductsGrid.querySelectorAll('.kv-bundle-product-card').length : 0;
        totalCountElement.textContent = productCount;
      }
  
      // Toggle sticky class when hero section scrolls out of view
      const heroSection = document.querySelector('.kv-bundle-hero-section');
      const bundleCollection = document.querySelector('.kv-bundle-collection');
      const announcementBar = document.querySelector('body .announcement-bar');
      const headerSection = document.querySelector('body .shopify-section--header');
  
      function updateHeroOffset() {
        if (!heroSection) return;
        let offset = 0;
        if (announcementBar) offset += announcementBar.offsetHeight || 0;
        if (headerSection) offset += headerSection.offsetHeight || 0;
        heroSection.style.setProperty('--kv-hero-offset', `${offset}px`);
        document.documentElement.style.setProperty('--kv-hero-offset', `${offset}px`);
      }
  
      updateHeroOffset();
  
      if (window.ResizeObserver) {
        const resizeObserver = new ResizeObserver(() => {
          updateHeroOffset();
        });
        if (announcementBar) resizeObserver.observe(announcementBar);
        if (headerSection) resizeObserver.observe(headerSection);
      } else {
        window.addEventListener('resize', updateHeroOffset);
        window.addEventListener('load', updateHeroOffset);
      }
  
      function updateStickyHeroHeight() {
        if (!heroSection) return;
        if (heroSection.classList.contains('sticky')) {
          const stickyHeight = heroSection.offsetHeight;
          document.documentElement.style.setProperty('--kv-sticky-hero-height', `${stickyHeight}px`);
        } else {
          document.documentElement.style.setProperty('--kv-sticky-hero-height', '0px');
        }
      }
  
      function handleHeroSticky() {
        const scentSelector=document.querySelector('.scent-selector')
        const progresFooter=document.querySelector('.kv-progress-footer2')
        if (!heroSection) return;
        const triggerPoint = heroSection.offsetHeight || 0;
        if ((window.pageYOffset || document.documentElement.scrollTop) > triggerPoint) {
          heroSection.classList.add('sticky');
          scentSelector.style.display = 'none';
          progresFooter.style.display = 'block';
         console.log("Sticky Enabeled")
        } else {
          heroSection.classList.remove('sticky');
          scentSelector.style.display = 'block';
          progresFooter.style.display = 'none';
        }
        updateStickyHeroHeight();
      }
  
      handleHeroSticky();
      window.addEventListener('scroll', handleHeroSticky, { passive: true });
  
      function updateProgressFooterScrollVisibility() {
        const progressFooter = document.getElementById('kv-progress-footer-empty');
        if (!progressFooter) return;
  
        const stickyTarget = document.querySelector('.kv-bundle-items-sticky');
        const triggerPoint = stickyTarget
          ? stickyTarget.getBoundingClientRect().top + window.scrollY
          : 600;
        const hasPassedTrigger = window.scrollY >= triggerPoint;
  
        progressFooter.style.display = hasPassedTrigger ? 'block' : 'none';
      }
  
      updateProgressFooterScrollVisibility();
      window.addEventListener('scroll', updateProgressFooterScrollVisibility, { passive: true });
      window.addEventListener('resize', updateProgressFooterScrollVisibility);
  
      // Update sticky height on resize
      if (window.ResizeObserver) {
        const heroResizeObserver = new ResizeObserver(() => {
          updateStickyHeroHeight();
        });
        heroResizeObserver.observe(heroSection);
      } else {
        window.addEventListener('resize', updateStickyHeroHeight);
      }
  
      // Tab switching
      const tabs = document.querySelectorAll('.kv-bundle-tab');
      const tabContents = document.querySelectorAll('.kv-bundle-tab-content');
  
      tabs.forEach(tab => {
        tab.addEventListener('click', function() {
          const tabId = this.getAttribute('data-tab');
          
          // Remove active class from all tabs and contents
          tabs.forEach(t => t.classList.remove('active'));
          tabContents.forEach(tc => tc.classList.remove('active'));
          
          // Add active class to clicked tab and corresponding content
          this.classList.add('active');
          document.querySelector(`[data-content="${tabId}"]`).classList.add('active');
        });
      });
  
      // Activate the first collection tab on page load
      const firstCollectionTab = document.querySelector('.kv-bundle-tab:not([data-tab="all"])');
      if (firstCollectionTab) {
        const firstTabId = firstCollectionTab.getAttribute('data-tab');
        tabs.forEach(t => t.classList.remove('active'));
        tabContents.forEach(tc => tc.classList.remove('active'));
        firstCollectionTab.classList.add('active');
        const firstTabContent = document.querySelector(`[data-content="${firstTabId}"]`);
        if (firstTabContent) firstTabContent.classList.add('active');
      }
  
      // Handle diffuser selector cards (cds-cards) as selected bundle products
      document.addEventListener('kv:selector-product-selected', function(e) {
        const data = e.detail || {};
        if (!data.productId || !data.variantId) return;
  
        const nonSelectorItemCount = selectedProducts
          .filter(product => product.selectionSource !== 'cds-selector')
          .reduce((sum, product) => sum + (product.quantity || 0), 0);
  
        // Selector product is eligible only after 2 other bundle items are selected
        if (nonSelectorItemCount < 2) {
          return;
        }
  
        const selectorProduct = {
          productId: data.productId,
          productHandle: data.productHandle || '',
          variantId: data.variantId,
          quantity: 1,
          image: data.image || '',
          title: data.title || '',
          price: parseInt(data.variantPrice, 10) || 0,
          compareAtPrice: parseInt(data.variantCompareAtPrice, 10) || 0,
          inventoryDate: '',
          inventoryQuantity: 0,
          selectionSource: 'cds-selector'
        };
  
        // Keep only one active diffuser selector card product at a time
        selectedProducts = selectedProducts.filter(product => product.selectionSource !== 'cds-selector');
        selectedProducts.push(selectorProduct);
  
        // If this product also exists in product grids, mirror its selected state there
        syncProductState(selectorProduct.productId, 'add');
        syncProductQuantity(selectorProduct.productId, 1);
  
        updateThumbnailCarousel();
        if (document.getElementById('kv-minicart').classList.contains('active')) {
          updateMiniCart();
        }
        // In the kv:selector-product-selected handler
  if (nonSelectorItemCount < 2) {
  // Show a message that they need more items first
  const discMsg = document.querySelector(`.disc-active-msg`);
  if (discMsg) {
    discMsg.style.display = 'block';
    discMsg.textContent = `Add ${2 - nonSelectorItemCount} more items first!`;
    setTimeout(() => {
      discMsg.style.display = 'none';
    }, 3000);
  }
  return;
  } 
      });
  
      // Handle Add button click - show quantity controls
      document.addEventListener('click', function(e) {
        if (e.target.classList.contains('kv-bundle-add-to-cart') || e.target.closest('.kv-bundle-add-to-cart')) {
          const button = e.target.classList.contains('kv-bundle-add-to-cart') ? e.target : e.target.closest('.kv-bundle-add-to-cart');
          const card = button.closest('.kv-bundle-product-card');
          const productId = card.getAttribute('data-product-id');
          const productHandle = card.getAttribute('data-product-handle');
          const variantId = button.getAttribute('data-variant-id');
          const variantPrice = button.getAttribute('data-variant-price');
          const variantCompareAtPrice = button.getAttribute('data-variant-compare-at-price');
          const inventoryDate = card.getAttribute('data-inventory-date');
          const inventoryQuantity = parseInt(card.getAttribute('data-inventory-quantity')) || 0;
          const productImage = card.querySelector('.kv-bundle-product-image');
          const productTitle = card.querySelector('.kv-bundle-product-title').textContent.trim();
          
          // Show quantity controls on ALL instances of this product
          syncProductState(productId, 'add');
          
          // Add to selected products with price from data attribute
          const productData = {
            productId: productId,
            productHandle: productHandle,
            variantId: variantId,
            quantity: 1,
            image: productImage.src,
            title: productTitle,
            price: parseInt(variantPrice) || 0,
            compareAtPrice: parseInt(variantCompareAtPrice) || 0,
            inventoryDate: inventoryDate || '',
            inventoryQuantity: inventoryQuantity
          };
          
          // Check if product already exists
          const existingIndex = selectedProducts.findIndex(p => p.productId === productId);
          if (existingIndex === -1) {
            selectedProducts.push(productData);
          } else {
            selectedProducts[existingIndex] = productData;
          }
          
          updateThumbnailCarousel();
        }
      });
  
      // Quantity controls
      document.addEventListener('click', function(e) {
        // Check if clicked element or its parent is the decrease button
        const decreaseBtn = e.target.classList.contains('kv-bundle-qty-decrease') ? e.target : e.target.closest('.kv-bundle-qty-decrease');
        if (decreaseBtn) {
          const input = decreaseBtn.nextElementSibling;
          const card = decreaseBtn.closest('.kv-bundle-product-card');
          if (!card) return;
          
          const productId = card.getAttribute('data-product-id');
          const currentValue = parseInt(input.value);
          
          if (currentValue > 1) {
            const newValue = currentValue - 1;
            // Update all instances of this product
            syncProductQuantity(productId, newValue);
            updateProductQuantity(productId, newValue);
          } else {
            // Remove product if quantity is 0
            syncProductState(productId, 'remove');
            removeSelectedProduct(productId);
          }
          return;
        }
  
        // Check if clicked element or its parent is the increase button
        const increaseBtn = e.target.classList.contains('kv-bundle-qty-increase') ? e.target : e.target.closest('.kv-bundle-qty-increase');
        if (increaseBtn) {
          const input = increaseBtn.previousElementSibling;
          const card = increaseBtn.closest('.kv-bundle-product-card');
          if (!card) return;
          
          const productId = card.getAttribute('data-product-id');
          const currentValue = parseInt(input.value);
          const newValue = currentValue + 1;
          // Update all instances of this product
          syncProductQuantity(productId, newValue);
          updateProductQuantity(productId, newValue);
        }
      });
  
      // Interrupter card add-to-cart
      document.addEventListener('click', function(e) {
        const intrAddToCartBtn = e.target.classList.contains('kv-interrupter-add-to-cart') ? e.target : e.target.closest('.kv-interrupter-add-to-cart');
        if (intrAddToCartBtn) {
          const quantity = parseInt(intrAddToCartBtn.getAttribute('data-quantity')) || 1;
  
          const productId = intrAddToCartBtn.getAttribute('data-product-id');
          const productHandle = intrAddToCartBtn.getAttribute('data-product-handle');
          const variantId = intrAddToCartBtn.getAttribute('data-variant-id');
          const variantPrice = intrAddToCartBtn.getAttribute('data-variant-price');
          const variantCompareAtPrice = intrAddToCartBtn.getAttribute('data-variant-compare-at-price');
          const productTitle = intrAddToCartBtn.getAttribute('data-product-title');
          const productImage = intrAddToCartBtn.getAttribute('data-product-image');
          const inventoryDate = intrAddToCartBtn.getAttribute('data-inventory-date');
          const inventoryQuantity = parseInt(intrAddToCartBtn.getAttribute('data-inventory-quantity')) || 0;
  
          const productData = {
            productId: productId,
            productHandle: productHandle,
            variantId: variantId,
            quantity: quantity,
            image: productImage,
            title: productTitle,
            price: parseInt(variantPrice) || 0,
            compareAtPrice: parseInt(variantCompareAtPrice) || 0,
            inventoryDate: inventoryDate || '',
            inventoryQuantity: inventoryQuantity
          };
  
          const existingIndex = selectedProducts.findIndex(p => p.productId === productId);
          if (existingIndex === -1) {
            selectedProducts.push(productData);
          } else {
            selectedProducts[existingIndex].quantity = quantity;
          }
  
          updateThumbnailCarousel();
  
          // Visual feedback: loading → success → restore
          const originalLabel = intrAddToCartBtn.textContent.trim();
          intrAddToCartBtn.disabled = true;
          intrAddToCartBtn.classList.add('loading');
          intrAddToCartBtn.textContent = '';
  
          setTimeout(function() {
            intrAddToCartBtn.classList.remove('loading');
            intrAddToCartBtn.textContent = '✓ Added!';
            intrAddToCartBtn.classList.add('kv-interrupter-added');
  
            setTimeout(function() {
              intrAddToCartBtn.textContent = originalLabel;
              intrAddToCartBtn.classList.remove('kv-interrupter-added');
              intrAddToCartBtn.disabled = false;
            }, 1500);
          }, 400);
        }
      });
  
      // Variant selection
      document.addEventListener('click', function(e) {
        if (e.target.classList.contains('kv-bundle-variant-image')) {
          const card = e.target.closest('.kv-bundle-product-card');
          const productId = card.getAttribute('data-product-id');
          const variantId = e.target.getAttribute('data-variant-id');
          const variantPrice = e.target.getAttribute('data-variant-price');
          const variantCompareAtPrice = e.target.getAttribute('data-variant-compare-at-price');
          const variantImageSrc = e.target.src;
          
          // Update ALL instances of this product across all tabs
          const allCards = document.querySelectorAll(`[data-product-id="${productId}"]`);
          allCards.forEach(productCard => {
            if (!productCard.classList.contains('kv-bundle-product-card')) return;
            
            const variantImages = productCard.querySelectorAll('.kv-bundle-variant-image');
            const mainImage = productCard.querySelector('.kv-bundle-product-image');
            const addToCartBtn = productCard.querySelector('.kv-bundle-add-to-cart');
            
            // Update active state on variant images
            variantImages.forEach(img => {
              if (img.getAttribute('data-variant-id') === variantId) {
                img.classList.add('active');
              } else {
                img.classList.remove('active');
              }
            });
            
            // Update main image
            if (mainImage) {
              mainImage.src = variantImageSrc.replace('width=100', 'width=600');
            }
            
            // Update variant ID, price and compare-at price in add to cart button
            if (addToCartBtn && variantId) {
              addToCartBtn.setAttribute('data-variant-id', variantId);
              addToCartBtn.setAttribute('data-variant-price', variantPrice);
              addToCartBtn.setAttribute('data-variant-compare-at-price', variantCompareAtPrice);
            }
          });
  
          // Update variant in selected products
          const product = selectedProducts.find(p => p.productId === productId);
          if (product) {
            product.variantId = variantId;
            product.image = variantImageSrc.replace('width=100', 'width=160');
            product.price = parseInt(variantPrice) || product.price;
            product.compareAtPrice = parseInt(variantCompareAtPrice) || 0;
            updateThumbnailCarousel();
            if (document.getElementById('kv-minicart').classList.contains('active')) {
              updateMiniCart();
            }
          }
        }
      });
  
      // Mini cart controls
      const openMiniCartBtn = document.getElementById('kv-open-minicart');
      const closeMiniCartBtn = document.getElementById('kv-close-minicart');
      const miniCartOverlay = document.getElementById('kv-minicart-overlay');
      const miniCart = document.getElementById('kv-minicart');
      const checkoutBtn = document.getElementById('kv-checkout-btn');
  
      function openMiniCart() {
        if (selectedProducts.length === 0) {
          return;
        }
        // Don't open if scent modal is open
        if (document.getElementById('kv-scent-modal').classList.contains('active')) {
          return;
        }
        miniCartOverlay.classList.add('active');
        miniCart.classList.add('active');
        document.body.style.overflow = 'hidden';
        updateMiniCart();
      }
  
      function closeMiniCart() {
        miniCartOverlay.classList.remove('active');
        miniCart.classList.remove('active');
        document.body.style.overflow = '';
      }
  
      closeMiniCartBtn.addEventListener('click', closeMiniCart);
      miniCartOverlay.addEventListener('click', closeMiniCart);

      // Mini trigger to open mini cart
      const miniTrigger = document.querySelector('.kv-bundle-items-mini-trigger');
      if (miniTrigger) {
        miniTrigger.addEventListener('click', function() { addBundleToCart(openMiniCartBtn); });
      }

      // Shared add-to-cart logic used by both the continue button and checkout button
      function addBundleToCart(triggerBtn) {
        if (selectedProducts.length === 0) return;

        const originalButtonHTML = triggerBtn.innerHTML;
        triggerBtn.disabled = true;
        triggerBtn.innerHTML = 'Adding to cart...';

        const items = selectedProducts.map(product => ({
          id: product.variantId,
          quantity: product.quantity
        }));

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ items: items })
        })
        .then(response => response.json())
        .then(data => {
          fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attributes: { 'scent': 'true' } })
          })
          .then(response => response.json())
          .then(cart => console.log('Scent property added successfully:', cart.attributes))
          .catch(error => console.error('Error:', error));

          triggerBtn.innerHTML = '✓ Added to Cart!';

          const cartPromises = [
            fetch('/cart.js').then(resp => {
              if (!resp.ok) throw new Error('Failed to fetch cart data');
              return resp.json();
            }),
            fetch(`${window.location.pathname}?section_id=cart-drawer`).then(resp => {
              if (!resp.ok) throw new Error('Failed to fetch cart drawer section');
              return resp.text();
            })
          ];

          Promise.all(cartPromises)
            .then(([cartData, sectionsHtml]) => {
              const tempDiv = document.createElement('div');
              tempDiv.innerHTML = sectionsHtml;
              const cartDrawerContent = tempDiv.querySelector('#cart-drawer');
              const cartDrawer = document.querySelector('cart-drawer');

              if (cartDrawer && cartDrawerContent) {
                cartDrawer.innerHTML = cartDrawerContent.innerHTML;
              }

              const cartCountElements = document.querySelectorAll('cart-count');
              cartCountElements.forEach(counter => {
                counter.itemCount = cartData.item_count;
              });

              if (cartDrawer && typeof cartDrawer.show === 'function') {
                cartDrawer.show();
              } else {
                document.dispatchEvent(new CustomEvent('drawer:show', {
                  bubbles: true,
                  detail: { drawer: cartDrawer }
                }));
              }

              document.dispatchEvent(new CustomEvent('cart:change', {
                bubbles: true,
                detail: {
                  baseEvent: 'variant:add',
                  cart: cartData,
                  sections: { 'cart-drawer': sectionsHtml }
                }
              }));

              document.dispatchEvent(new CustomEvent('variant:add', {
                bubbles: true,
                detail: { cart: cartData }
              }));

              document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));

              closeMiniCart();
              selectedProducts.forEach(product => {
                syncProductState(product.productId, 'remove');
              });
              selectedProducts = [];
              updateThumbnailCarousel();

              triggerBtn.disabled = false;
              setTimeout(() => {
                triggerBtn.innerHTML = originalButtonHTML;
              }, 1500);
            })
            .catch(error => {
