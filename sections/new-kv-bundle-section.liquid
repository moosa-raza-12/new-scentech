                  {% if block.settings.cta_product_2 != blank %}{% assign kv_intr_product_count = kv_intr_product_count | plus: 1 %}{% endif %}
                  {% if block.settings.cta_product_3 != blank %}{% assign kv_intr_product_count = kv_intr_product_count | plus: 1 %}{% endif %}
                  {% if block.settings.cta_product_4 != blank %}{% assign kv_intr_product_count = kv_intr_product_count | plus: 1 %}{% endif %}
                  {% if block.settings.cta_product_5 != blank %}{% assign kv_intr_product_count = kv_intr_product_count | plus: 1 %}{% endif %}
                  {% if block.settings.cta_product_6 != blank %}{% assign kv_intr_product_count = kv_intr_product_count | plus: 1 %}{% endif %}

                  {% if kv_intr_product_count == 1 %}
                    {% if block.settings.cta_product_1 != blank %}{% assign kv_intr_excluded = kv_intr_excluded | append: '|' | append: block.settings.cta_product_1 | append: '|' %}{% endif %}
                    {% if block.settings.cta_product_2 != blank %}{% assign kv_intr_excluded = kv_intr_excluded | append: '|' | append: block.settings.cta_product_2 | append: '|' %}{% endif %}
                    {% if block.settings.cta_product_3 != blank %}{% assign kv_intr_excluded = kv_intr_excluded | append: '|' | append: block.settings.cta_product_3 | append: '|' %}{% endif %}
                    {% if block.settings.cta_product_4 != blank %}{% assign kv_intr_excluded = kv_intr_excluded | append: '|' | append: block.settings.cta_product_4 | append: '|' %}{% endif %}
                    {% if block.settings.cta_product_5 != blank %}{% assign kv_intr_excluded = kv_intr_excluded | append: '|' | append: block.settings.cta_product_5 | append: '|' %}{% endif %}
                    {% if block.settings.cta_product_6 != blank %}{% assign kv_intr_excluded = kv_intr_excluded | append: '|' | append: block.settings.cta_product_6 | append: '|' %}{% endif %}
