                      <img src="{{ buy_buttons_block.settings.promo_image_2 | image_url: width: 90 }}" alt="" loading="lazy" width="45" height="45">
                    </div>
                  {%- endif -%}
                  {%- if buy_buttons_block.settings.promo_image_3 != blank -%}
                    <div class="sticky-promo-banner__image sticky-promo-banner__image--3">
                      <img src="{{ buy_buttons_block.settings.promo_image_3 | image_url: width: 90 }}" alt="" loading="lazy" width="45" height="45">
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="sticky-promo-banner__content">
                <p class="sticky-promo-banner__title">
                  {{ buy_buttons_block.settings.promo_title_prefix }} {{ sp_count }} {{ buy_buttons_block.settings.promo_title_suffix }}
                </p>
                {%- if buy_buttons_block.settings.promo_subtitle != blank -%}
