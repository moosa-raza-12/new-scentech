<script>
  document.addEventListener('DOMContentLoaded', function() {
    const priceDisplay = document.getElementById('selected-price-display');
    const infoDisplay = document.getElementById('product-info-display');
    const messageDiv = document.querySelector('.cds-highlights');
    const desktopMq = window.matchMedia('(min-width: 768px)');

    function syncKvBundleDesktopHeroImage() {
      if (!desktopMq.matches) return;
      var dynImg = document.getElementById('kv-bundle-dynamic-image-img');
      var dynVideo = document.getElementById('kv-bundle-dynamic-image-video');
      if (!dynImg) return;
      var active = document.querySelector('.cds-cards[data-diffuser-group="primary"].active');
      var card = active || document.querySelector('.cds-cards[data-diffuser-group="primary"]');
      if (!card) return;
      var videoUrl = card.getAttribute('data-cds-desktop-hero-video');
      var imgUrl = card.getAttribute('data-cds-desktop-hero-image') || card.getAttribute('data-product-image');

      if (videoUrl && dynVideo) {
        dynImg.style.display = 'none';
        dynVideo.src = videoUrl;
        dynVideo.style.display = '';
        dynVideo.play().catch(function() {});
      } else {
        if (dynVideo) {
          dynVideo.style.display = 'none';
          dynVideo.pause();
        }
        dynImg.style.display = '';
        if (imgUrl) dynImg.src = imgUrl;
      }
    }

    syncKvBundleDesktopHeroImage();
    window.addEventListener('resize', syncKvBundleDesktopHeroImage);

    // Listen for primary diffuser selections
    document.addEventListener('kv:selector-product-selected', function(event) {
      const product = event.detail;

      if (priceDisplay && product.variantPrice) {
        const discountedPrice = (product.variantPrice * 0.5) / 100;
        priceDisplay.innerHTML = `€${discountedPrice.toFixed(2).replace('.', ',')}`;
        if (messageDiv) messageDiv.style.display = 'flex';
      }

      if (infoDisplay) {
        infoDisplay.innerHTML = `
          <p>Product: ${product.title}</p>
          <p>Variant ID: ${product.variantId}</p>
        `;
      }

      syncKvBundleDesktopHeroImage();
    });

    // Listen for second diffuser selections (hero image stays on primary)
    document.addEventListener('kv:second-selector-product-selected', function(event) {
      syncKvBundleDesktopHeroImage();
    });
  });
</script>  
