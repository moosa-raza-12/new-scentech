  :root {
    --cds-banner-bg: {{ section.settings.cds_banner_bg | default: '#938E70' }};
  }
  .shopify-section-group-footer-group { display: none !important; }
  body { padding-bottom: var(--kv-sticky-height, 0px); }


  body .kv-bundle-hero-section.sticky {
    position: unset;
  }

  body .kv-bundle-collection {
    padding: 24px 0 !important;
}
  
  .kv-bundle-section { width: 100%; }

  .high-class {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: flex-start;
    gap: 90px;
    width: 100%;
    max-width: 100%;
}

  .kv-bundle-hero-section.sticky {
    position: fixed;
    left: 0;
  }

  .kv-bundle-dynamic-image {
    position: sticky;
    top: 0;
    align-self: start;
    width: 100%;
    max-width: 100%;
    height: 100%;
    background: #f5f1ea;
    overflow: hidden;
  }

  .kv-bundle-dynamic-image img,
  .kv-bundle-dynamic-image video {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .low-class {
    width: 100%;
    max-width: 100%;
  }

  @media screen and (max-width: 991px) {
    .high-class {
      display: block;
    }

    .kv-bundle-dynamic-image {
      position: relative;
      top: auto;
      height: auto;
      max-height: 60vh;
    }

    .kv-bundle-dynamic-image img,
    .kv-bundle-dynamic-image video {
      max-height: 60vh;
      object-fit: cover;
    }
  }
  </style>
<script>
  (function () {
    function updateStickyHeight() {
      var sticky = document.querySelector('.kv-bundle-items-sticky');
      if (!sticky) {
        document.documentElement.style.setProperty('--kv-sticky-height', '0px');
        return;
      }
      var h = sticky.offsetHeight || 0;
      document.documentElement.style.setProperty('--kv-sticky-height', h + 'px');
    }
    function attachObserver() {
      var sticky = document.querySelector('.kv-bundle-items-sticky');
      if (!sticky) { return setTimeout(attachObserver, 250); }
      updateStickyHeight();
      if ('ResizeObserver' in window) {
        new ResizeObserver(updateStickyHeight).observe(sticky);
      }
      if ('MutationObserver' in window) {
        new MutationObserver(updateStickyHeight).observe(sticky, { childList: true, subtree: true, characterData: true });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', attachObserver);
    } else {
      attachObserver();
    }
    window.addEventListener('load', updateStickyHeight);
    window.addEventListener('resize', updateStickyHeight);
    window.addEventListener('orientationchange', updateStickyHeight);
  })();
</script>
