{%- comment -%}
  Clean Standards section
  Spec: docs/superpowers/specs/2026-05-17-clean-standards-design.md
{%- endcomment -%}

<script src="{{ 'clean-standards.js' | asset_url }}" defer></script>

{%- render 'clean-standards-styles',
  section_id: section.id,
  section_bg_color: section.settings.section_bg_color,
  heading_color: section.settings.heading_color,
  body_color: section.settings.body_color,
  button_bg_color: section.settings.button_bg_color,
  button_text_color: section.settings.button_text_color,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  seal_max_width: section.settings.seal_max_width,
  modal_bg_color: section.settings.modal_bg_color,
  modal_text_color: section.settings.modal_text_color,
  check_icon_color: section.settings.check_icon_color,
  exclude_panel_bg: section.settings.exclude_panel_bg,
  exclude_icon_color: section.settings.exclude_icon_color,
  heading_size: section.settings.heading_size,
  card_bg_color: section.settings.card_bg_color,
  card_radius: section.settings.card_radius,
  heading_font: section.settings.heading_font,
  body_font: section.settings.body_font,
  modal_heading_font: section.settings.modal_heading_font
-%}

<section
  class="cs-section"
  data-section-id="{{ section.id }}"
  style="background:{{ section.settings.section_bg_color }};--cs-pad-top:{{ section.settings.padding_top }}px;--cs-pad-bot:{{ section.settings.padding_bottom }}px;">
  <div class="cs-section__inner">
    <div class="cs-section__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="cs-section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.seal_image != blank -%}
        {%- assign seal_alt = section.settings.heading | default: 'Clean and safe' -%}
        {{ section.settings.seal_image | image_url: width: 400 | image_tag:
          class: 'cs-section__seal',
          loading: 'lazy',
          widths: '120,200,300,400',
          sizes: '200px',
          alt: seal_alt
        }}
      {%- endif -%}
    </div>
    {%- if section.settings.body != blank -%}
      <div class="cs-section__body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <button type="button" class="cs-section__cta" data-cs-open="{{ section.id }}">
        {{ section.settings.button_text }}
      </button>
    {%- endif -%}
  </div>
</section>

<div
  class="cs-modal"
  id="cs-modal-{{ section.id }}"
  data-section-id="{{ section.id }}"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cs-modal-title-{{ section.id }}"
  aria-hidden="true">
  <div class="cs-modal__backdrop" data-cs-close></div>
  <div class="cs-modal__panel" role="document">
    <button type="button" class="cs-modal__close" data-cs-close aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
        <path d="M3 3 L11 11 M11 3 L3 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="cs-modal__content">
      {%- if section.settings.modal_heading != blank -%}
        <h3 class="cs-modal__heading" id="cs-modal-title-{{ section.id }}">{{ section.settings.modal_heading }}</h3>
      {%- endif -%}
      {%- if section.settings.modal_intro != blank -%}
        <div class="cs-modal__intro">{{ section.settings.modal_intro }}</div>
      {%- endif -%}
      {%- assign check_blocks = section.blocks | where: 'type', 'check_item' -%}
      {%- if check_blocks.size > 0 -%}
        <ul class="cs-modal__checks">
          {%- for block in check_blocks -%}
            <li class="cs-check" {{ block.shopify_attributes }}>
              <span class="cs-check__icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22">
                  <path d="M4 12 L9 17 L18 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="cs-check__text">{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- assign exclude_blocks = section.blocks | where: 'type', 'exclude_item' -%}
      {%- if exclude_blocks.size > 0 or section.settings.exclude_heading != blank -%}
        <div class="cs-modal__exclude">
          {%- if section.settings.exclude_heading != blank -%}
            <h4 class="cs-modal__exclude-heading">{{ section.settings.exclude_heading }}</h4>
          {%- endif -%}
          {%- if exclude_blocks.size > 0 -%}
            <ul class="cs-modal__exclude-list">
              {%- for block in exclude_blocks -%}
                <li class="cs-exclude" {{ block.shopify_attributes }}>
                  <span class="cs-exclude__icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 18 18">
                      <path d="M4 4 L14 14 M14 4 L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </span>
                  <span class="cs-exclude__text">{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Clean standards",
  "tag": "section",
  "class": "cs-wrapper",
  "settings": [
    { "type": "header", "content": "Front section" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our clean standards" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px, desktop)", "min": 24, "max": 96, "step": 2, "default": 56 },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [
      { "value": "Kento-Bold", "label": "Kento Bold" },
      { "value": "Kento-Regular", "label": "Kento Regular" },
      { "value": "Kento-Light", "label": "Kento Light" },
      { "value": "BaiJamjuree-Bold", "label": "Bai Jamjuree Bold" },
      { "value": "BaiJamjuree-SemiBold", "label": "Bai Jamjuree SemiBold" },
      { "value": "BaiJamjuree-Medium", "label": "Bai Jamjuree Medium" },
      { "value": "BaiJamjuree-Regular", "label": "Bai Jamjuree Regular" },
      { "value": "BaiJamjuree-Light", "label": "Bai Jamjuree Light" },
      { "value": "BaiJamjuree-ExtraLight", "label": "Bai Jamjuree ExtraLight" }
    ], "default": "Kento-Bold" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>300+ clean, premium fragrances crafted to be safe for the whole family—including pets.</p>" },
    { "type": "select", "id": "body_font", "label": "Body font", "options": [
      { "value": "BaiJamjuree-Bold", "label": "Bai Jamjuree Bold" },
      { "value": "BaiJamjuree-SemiBold", "label": "Bai Jamjuree SemiBold" },
      { "value": "BaiJamjuree-Medium", "label": "Bai Jamjuree Medium" },
      { "value": "BaiJamjuree-Regular", "label": "Bai Jamjuree Regular" },
      { "value": "BaiJamjuree-Light", "label": "Bai Jamjuree Light" },
      { "value": "BaiJamjuree-ExtraLight", "label": "Bai Jamjuree ExtraLight" }
    ], "default": "BaiJamjuree-Regular" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Our safety standards" },
    { "type": "image_picker", "id": "seal_image", "label": "Seal image" },
    { "type": "range", "id": "seal_max_width", "label": "Seal max width (px)", "min": 60, "max": 220, "step": 10, "default": 120 },
    { "type": "color", "id": "section_bg_color", "label": "Outer background (around card)", "default": "#ffffff" },
    { "type": "color", "id": "card_bg_color", "label": "Card background", "default": "#F1EFE8" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius (px)", "min": 0, "max": 48, "step": 2, "default": 8 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#160000" },
    { "type": "color", "id": "body_color", "label": "Body text color", "default": "#160000" },
    { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#160000" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 200, "step": 4, "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 200, "step": 4, "default": 64 },

    { "type": "header", "content": "Modal" },
    { "type": "text", "id": "modal_heading", "label": "Modal heading", "default": "Clean and safe fragrances" },
    { "type": "select", "id": "modal_heading_font", "label": "Modal heading font", "options": [
      { "value": "Kento-Bold", "label": "Kento Bold" },
      { "value": "Kento-Regular", "label": "Kento Regular" },
      { "value": "Kento-Light", "label": "Kento Light" },
      { "value": "BaiJamjuree-Bold", "label": "Bai Jamjuree Bold" },
      { "value": "BaiJamjuree-SemiBold", "label": "Bai Jamjuree SemiBold" },
      { "value": "BaiJamjuree-Medium", "label": "Bai Jamjuree Medium" },
      { "value": "BaiJamjuree-Regular", "label": "Bai Jamjuree Regular" },
      { "value": "BaiJamjuree-Light", "label": "Bai Jamjuree Light" },
      { "value": "BaiJamjuree-ExtraLight", "label": "Bai Jamjuree ExtraLight" }
    ], "default": "BaiJamjuree-SemiBold" },
    { "type": "richtext", "id": "modal_intro", "label": "Modal intro paragraph", "default": "<p>Our commitment is to create clean, safe fragrances. ScenTech follows the strict safety standards set by the International Fragrance Association (IFRA), based on toxicological research and real-world exposure.</p>" },
    { "type": "color", "id": "modal_bg_color", "label": "Modal background", "default": "#ffffff" },
    { "type": "color", "id": "modal_text_color", "label": "Modal text color", "default": "#160000" },
    { "type": "color", "id": "check_icon_color", "label": "Check icon color", "default": "#7d9374" },
    { "type": "text", "id": "exclude_heading", "label": "Exclude panel heading", "default": "Our products don't include:" },
    { "type": "color", "id": "exclude_panel_bg", "label": "Exclude panel background", "default": "#F1EFE8" },
    { "type": "color", "id": "exclude_icon_color", "label": "Exclude icon color", "default": "#160000" }
  ],
  "blocks": [
    {
      "type": "check_item",
      "name": "Check item",
      "limit": 6,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Safe for everyday use when used as directed</p>" }
      ]
    },
    {
      "type": "exclude_item",
      "name": "Exclude item",
      "limit": 16,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Parabens" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clean standards",
      "blocks": [
        { "type": "check_item", "settings": { "text": "<p>Safe for everyday use when used as directed</p>" } },
        { "type": "check_item", "settings": { "text": "<p>Cats and dogs: designed for homes and pets</p>" } },
        { "type": "check_item", "settings": { "text": "<p>Homes with kids: evaluated for shared family spaces</p>" } },
        { "type": "check_item", "settings": { "text": "<p>Cruelty-free: no animal testing</p>" } },
        { "type": "exclude_item", "settings": { "text": "Parabens" } },
        { "type": "exclude_item", "settings": { "text": "Acetaldehyde" } },
        { "type": "exclude_item", "settings": { "text": "Diclorobenzene" } },
        { "type": "exclude_item", "settings": { "text": "Formaldehyde" } },
        { "type": "exclude_item", "settings": { "text": "Ethylhexanol" } },
        { "type": "exclude_item", "settings": { "text": "Methyl Pyrrolidone" } },
        { "type": "exclude_item", "settings": { "text": "Phthalates" } },
        { "type": "exclude_item", "settings": { "text": "Propylene Glycol" } },
        { "type": "exclude_item", "settings": { "text": "Styrene" } },
        { "type": "exclude_item", "settings": { "text": "Animal Testing" } },
        { "type": "exclude_item", "settings": { "text": "Dyes" } },
        { "type": "exclude_item", "settings": { "text": "Gluten" } }
      ]
    }
  ]
}
{% endschema %}
