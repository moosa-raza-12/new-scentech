{% render 'new-kv-bundle-css' %}
<style>
                .scent-selector {
                  padding: 20px;
                  background: {{ section.settings.bg_color }};
                  border-radius: 12px;
                  font-family: inherit;
                }
                
                .scent-header {
                  display: flex;
                  align-items: center;
                  justify-content: space-between;
                  gap: 16px;
                }
                
                .step-circle {
                  width: 40px;
                  height: 40px;
                  background: {{ section.settings.circle_bg }};
                  color: {{ section.settings.circle_text }};
                  border-radius: 50%;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  font-weight: 600;
                }
                
                .scent-title-wrapper {
                  flex: 1;
                }
                
                .scent-title {
                  margin: 0;
                  font-size: {{ section.settings.heading_size }}px;
                  color: {{ section.settings.heading_color }};
                }
                
                .scent-subtext {
                  margin: 4px 0 0;
                  font-size: {{ section.settings.subtext_size }}px;
                  color: {{ section.settings.subtext_color }};
                }
                
                .scent-badge {
                  background: {{ section.settings.badge_bg }};
                  color: {{ section.settings.badge_text_color }};
                  padding: 8px 14px;
                  border-radius: 10px;
                  font-size: 14px;
                  white-space: nowrap;
                }
                </style>
 
<div class="kv-page-preloader" id="kv-page-preloader">
    <div class="kv-preloader-spinner"></div>
  </div>
  
  <div class="kv-bundle-section">
      
      {%- comment -%} Progress Banner {%- endcomment -%}
      <div class="kv-bundle-hero-section" style="background-image: url({{ section.settings.hero_background_image | image_url: width: 1920 }}); background-size: cover; background-position: center;">
        <div class="kv-bundle-hero-container">
            {% comment %} {% if template == 'page.diffuser-overflow-v1' or template.name == 'diffuser-overflow-v1' %} {% endcomment %}

                <section class="scent-selector">
                  <div class="scent-header">
                    <div class="step-circle">
                      {{ section.settings.step_number }}
                    </div>
                
                    <div class="scent-title-wrapper">
                      <h2 class="scent-title">{{ section.settings.heading }}</h2>
                      <p class="scent-subtext">{{ section.settings.subtext }}</p>
                    </div>
                
                    <div class="scent-badge">
                      {{ section.settings.badge_text }}
                    </div>
                  </div>
                </section>
          <div class="kv-bundle-hero-inner">
            {% comment %} <div class="kv-bundle-hero-content">
              <h2 class="kv-bundle-hero-title">{{ section.settings.hero_title }}</h2>
              <p class="kv-bundle-hero-description">{{ section.settings.hero_description }}</p>
            </div> {% endcomment %}
            <div class="kv-progress-banner">
                <div class="kv-progress-banner-inner">
                    <div class="kv-progress-bar-container">
                        <div class="kv-progress-bar">
                            <div class="kv-progress-bar-fill" id="kv-progress-fill"></div>
                        </div>
                        <div class="kv-progress-milestones">
                            {% if section.settings.milestone_1_count > 0 %}
                            {% assign milestone_1_label_text = section.settings.milestone_1_label | default: '{count} geuren' | replace: '{count}', section.settings.milestone_1_count %}
                            <div class="kv-progress-milestone" data-milestone="1" data-count="{{ section.settings.milestone_1_count }}" style="left: 0%;">
                                <div class="kv-milestone-marker"></div>
                                <div class="kv-milestone-label">{{ milestone_1_label_text }}</div>
                                {% if section.settings.milestone_1_price != blank %}
                                <div class="kv-milestone-price-display">{{ section.settings.milestone_1_price }}</div>
                                {% endif %}
                            </div>
                            {% endif %}
                            {% if section.settings.milestone_2_count > 0 %}
                            {% assign milestone_2_label_text = section.settings.milestone_2_label | default: '{count} geuren' | replace: '{count}', section.settings.milestone_2_count %}
                            <div class="kv-progress-milestone" data-milestone="2" data-count="{{ section.settings.milestone_2_count }}" style="left: 33.33%;">
                                <div class="kv-milestone-marker"></div>
                                <div class="kv-milestone-label">{{ milestone_2_label_text }}</div>
                                {% if section.settings.milestone_2_price != blank %}
                                <div class="kv-milestone-price-display">{{ section.settings.milestone_2_price }}</div>
                                {% endif %}
                            </div>
                            {% endif %}
                            {% if section.settings.milestone_3_count > 0 %}
                            {% assign milestone_3_label_text = section.settings.milestone_3_label | default: '{count} geuren' | replace: '{count}', section.settings.milestone_3_count %}
                            <div class="kv-progress-milestone" data-milestone="3" data-count="{{ section.settings.milestone_3_count }}" style="left: 66.66%;">
                                <div class="kv-milestone-marker"></div>
                                <div class="kv-milestone-label">{{ milestone_3_label_text }}</div>
                                {% if section.settings.milestone_3_price != blank %}
                                <div class="kv-milestone-price-display">{{ section.settings.milestone_3_price }}</div>
                                {% endif %}
                            </div>
                            {% endif %}
                            {% if section.settings.milestone_4_count > 0 %}
                            {% assign milestone_4_label_text = section.settings.milestone_4_label | default: '{count} geuren' | replace: '{count}', section.settings.milestone_4_count %}
                            <div class="kv-progress-milestone" data-milestone="4" data-count="{{ section.settings.milestone_4_count }}" style="left: 100%;">
                                <div class="kv-milestone-marker"></div>
                                <div class="kv-milestone-label">{{ milestone_4_label_text }}</div>
                                {% if section.settings.milestone_4_price != blank %}
                                <div class="kv-milestone-price-display">{{ section.settings.milestone_4_price }}</div>
                                {% endif %}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="kv-progress-footer" id="kv-progress-footer-normal" style="display: none;">
                        <div class="kv-progress-footer-message" id="kv-progress-footer-message">
                          <svg width="12" height="13" viewBox="0 0 12 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2.53125 12.5625C1.97266 12.5625 1.54297 12.416 1.24219 12.123C0.941406 11.8301 0.791016 11.4062 0.791016 10.8516V7.40625H0.761719C0.511719 7.32422 0.322266 7.17383 0.193359 6.95508C0.0644531 6.73633 0 6.46094 0 6.12891V4.68164C0 4.25586 0.117188 3.91992 0.351562 3.67383C0.585938 3.42383 0.908203 3.29883 1.31836 3.29883H2.2207C2.06055 3.14258 1.93555 2.95703 1.8457 2.74219C1.75586 2.52344 1.71094 2.28906 1.71094 2.03906C1.71094 1.64453 1.80664 1.29492 1.99805 0.990234C2.19336 0.681641 2.45117 0.439453 2.77148 0.263672C3.0918 0.0878906 3.45117 0 3.84961 0C4.29883 0 4.69922 0.123047 5.05078 0.369141C5.40234 0.615234 5.64844 0.966797 5.78906 1.42383C5.93359 0.966797 6.18164 0.615234 6.5332 0.369141C6.88867 0.123047 7.28906 0 7.73438 0C8.12891 0 8.48633 0.0878906 8.80664 0.263672C9.13086 0.439453 9.38867 0.681641 9.58008 0.990234C9.77148 1.29492 9.86719 1.64453 9.86719 2.03906C9.86719 2.28906 9.82227 2.52344 9.73242 2.74219C9.64648 2.95703 9.52539 3.14258 9.36914 3.29883H10.2715C10.6895 3.29883 11.0117 3.42383 11.2383 3.67383C11.4688 3.91992 11.584 4.25586 11.584 4.68164V6.12891C11.584 6.46094 11.5195 6.73633 11.3906 6.95508C11.2617 7.17383 11.0703 7.32422 10.8164 7.40625H10.793V10.8516C10.793 11.4062 10.6426 11.8301 10.3418 12.123C10.041 12.416 9.61328 12.5625 9.05859 12.5625H2.53125ZM5.15039 11.3906V7.5H2.07422V10.6992C2.07422 10.918 2.13477 11.0879 2.25586 11.209C2.37695 11.3301 2.54883 11.3906 2.77148 11.3906H5.15039ZM6.43359 11.3906H8.8125C9.03516 11.3906 9.20703 11.3301 9.32812 11.209C9.44922 11.0879 9.50977 10.918 9.50977 10.6992V7.5H6.43359V11.3906ZM5.15039 6.35156V4.45312H1.66992C1.5332 4.45312 1.43359 4.48438 1.37109 4.54688C1.3125 4.60938 1.2832 4.70898 1.2832 4.8457V5.95898C1.2832 6.0957 1.3125 6.19531 1.37109 6.25781C1.43359 6.32031 1.5332 6.35156 1.66992 6.35156H5.15039ZM6.43359 6.35156H9.91992C10.0527 6.35156 10.1484 6.32422 10.207 6.26953C10.2695 6.21094 10.3008 6.11328 10.3008 5.97656V4.8457C10.3008 4.70898 10.2695 4.60938 10.207 4.54688C10.1484 4.48438 10.0527 4.45312 9.91992 4.45312H6.43359V6.35156ZM5.18555 3.29883V2.54297C5.18555 2.14062 5.06836 1.81641 4.83398 1.57031C4.59961 1.32422 4.31641 1.20117 3.98438 1.20117C3.67188 1.20117 3.41992 1.28906 3.22852 1.46484C3.03711 1.64062 2.94141 1.88281 2.94141 2.19141C2.94141 2.50391 3.0625 2.76758 3.30469 2.98242C3.54688 3.19336 3.88672 3.29883 4.32422 3.29883H5.18555ZM6.39844 3.29883H7.25977C7.69727 3.29883 8.03711 3.19336 8.2793 2.98242C8.52148 2.76758 8.64258 2.50391 8.64258 2.19141C8.64258 1.88281 8.54688 1.64062 8.35547 1.46484C8.16797 1.28906 7.91602 1.20117 7.59961 1.20117C7.27148 1.20117 6.98828 1.32422 6.75 1.57031C6.51562 1.81641 6.39844 2.14062 6.39844 2.54297V3.29883Z" fill="#162518"/>
                            </svg>                          
                            <span>{{ section.settings.progress_start_text | default: "Start building your bundle!" }}</span>
                        </div>
                    </div>
                    <div class="kv-progress-footer empty open-comparison-popup" id="kv-progress-footer-empty" style="display: none;">
                      <div class="kv-progress-footer-message-empty">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M7 14C6.03356 14 5.12752 13.8166 4.28188 13.4497C3.43624 13.0872 2.69128 12.5861 2.04698 11.9463C1.40716 11.3065 0.90604 10.5638 0.543624 9.71812C0.181208 8.87248 0 7.96644 0 7C0 6.03356 0.181208 5.12752 0.543624 4.28188C0.90604 3.43624 1.40716 2.69351 2.04698 2.05369C2.69128 1.4094 3.43624 0.90604 4.28188 0.543624C5.12752 0.181208 6.03356 0 7 0C7.96644 0 8.87248 0.181208 9.71812 0.543624C10.5638 0.90604 11.3065 1.4094 11.9463 2.05369C12.5861 2.69351 13.0872 3.43624 13.4497 4.28188C13.8166 5.12752 14 6.03356 14 7C14 7.96644 13.8166 8.87248 13.4497 9.71812C13.0872 10.5638 12.5861 11.3065 11.9463 11.9463C11.3065 12.5861 10.5638 13.0872 9.71812 13.4497C8.87248 13.8166 7.96644 14 7 14ZM7 12.4631C7.75615 12.4631 8.46309 12.3221 9.12081 12.0403C9.783 11.7584 10.3624 11.3669 10.8591 10.8658C11.3602 10.3602 11.7517 9.77852 12.0336 9.12081C12.3199 8.45861 12.4631 7.75168 12.4631 7C12.4631 6.24385 12.3199 5.53691 12.0336 4.87919C11.7517 4.217 11.3602 3.63535 10.8591 3.13423C10.3624 2.63311 9.783 2.24161 9.12081 1.95973C8.46309 1.67785 7.75615 1.53691 7 1.53691C6.24385 1.53691 5.53468 1.67785 4.87248 1.95973C4.21477 2.24161 3.63535 2.63311 3.13423 3.13423C2.63311 3.63535 2.24161 4.217 1.95973 4.87919C1.67785 5.53691 1.53691 6.24385 1.53691 7C1.53691 7.75168 1.67785 8.45861 1.95973 9.12081C2.24161 9.77852 2.63311 10.3602 3.13423 10.8658C3.63535 11.3669 4.21477 11.7584 4.87248 12.0403C5.53468 12.3221 6.24385 12.4631 7 12.4631ZM6.84564 8.30201C6.37136 8.30201 6.13423 8.09843 6.13423 7.69128C6.13423 7.68233 6.13423 7.67338 6.13423 7.66443C6.13423 7.65101 6.13423 7.63758 6.13423 7.62416C6.13423 7.33781 6.21029 7.10067 6.36242 6.91275C6.51454 6.72483 6.70917 6.55034 6.94631 6.38926C7.22371 6.19239 7.43177 6.02908 7.57047 5.89933C7.71365 5.76958 7.78523 5.60403 7.78523 5.40268C7.78523 5.19687 7.70693 5.02685 7.55034 4.89262C7.39821 4.75391 7.19687 4.68456 6.94631 4.68456C6.8255 4.68456 6.71141 4.7047 6.60403 4.74497C6.49664 4.78523 6.39821 4.8434 6.