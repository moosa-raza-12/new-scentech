{% comment %}
  Beste Diffuser Comparison
  Scentech — Ranked vergelijking #1–#4 met criteria-scores
{% endcomment %}

<style>
  #bdc-{{ section.id }} {
    --color-bg:       {{ section.settings.color_bg }};
    --color-text:     {{ section.settings.color_text }};
    --color-accent:   {{ section.settings.color_accent }};
    --color-badge-bg: {{ section.settings.color_badge_bg }};
    --color-winner-border: {{ section.settings.color_accent }};
    --font-body: 'Bai Jamjuree', sans-serif;
  }

  #bdc-{{ section.id }} .bdc-wrapper {
    background: var(--color-bg);
    padding: clamp(48px, 7vw, 96px) 24px;
    font-family: var(--font-body);
  }

  #bdc-{{ section.id }} .bdc-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  #bdc-{{ section.id }} .bdc-section-header {
    margin-bottom: 48px;
  }

  #bdc-{{ section.id }} .bdc-section-header h2 {
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin: 0 0 12px 0;
    line-height: 1.25;
  }

  #bdc-{{ section.id }} .bdc-section-header p {
    font-size: 15px;
    color: var(--color-text);
    opacity: 0.65;
    line-height: 1.6;
    margin: 0;
    max-width: 640px;
  }

  /* Item card */
  #bdc-{{ section.id }} .bdc-item {
    background: #ffffff;
    border: 1px solid rgba(35, 31, 32, 0.10);
    border-radius: 8px;
    padding: 28px 28px 24px;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(35, 31, 32, 0.04);
  }

  #bdc-{{ section.id }} .bdc-item--winner {
    border: 2px solid var(--color-winner-border);
    background: #fffdf5;
    box-shadow: 0 4px 16px rgba(35, 31, 32, 0.08);
  }

  #bdc-{{ section.id }} .bdc-item__inner {
    display: flex;
    gap: 28px;
    align-items: stretch;
  }

  #bdc-{{ section.id }} .bdc-item__image {
    flex: 0 0 200px;
    width: 200px;
    min-height: 100%;
  }

  #bdc-{{ section.id }} .bdc-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
    display: block;
  }

  #bdc-{{ section.id }} .bdc-item__image-placeholder {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background: linear-gradient(160deg, #F5EFE8 0%, #EAE0D4 100%);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: #8A8A8A;
    letter-spacing: 0.06em;
    text-align: center;
  }

  #bdc-{{ section.id }} .bdc-item__content {
    flex: 1;
    min-width: 0;
  }

  /* Rank row */
  #bdc-{{ section.id }} .bdc-item__top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  #bdc-{{ section.id }} .bdc-rank {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text);
    opacity: 0.45;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #bdc-{{ section.id }} .bdc-badge {
    background: var(--color-badge-bg);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
  }

  /* Title row */
  #bdc-{{ section.id }} .bdc-item__title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  #bdc-{{ section.id }} .bdc-item__title {
    font-size: clamp(17px, 2.2vw, 20px);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  #bdc-{{ section.id }} .bdc-overall-score {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  #bdc-{{ section.id }} .bdc-overall-score__stars {
    color: var(--color-accent);
    font-size: 16px;
    letter-spacing: 1px;
  }

  #bdc-{{ section.id }} .bdc-overall-score__number {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text);
  }

  /* Summary */
  #bdc-{{ section.id }} .bdc-item__summary {
    font-size: 14px;
    color: var(--color-text);
    opacity: 0.65;
    line-height: 1.65;
    margin: 0 0 20px 0;
  }

  /* Criteria */
  #bdc-{{ section.id }} .bdc-criteria {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
    font-size: 14px;
  }

  #bdc-{{ section.id }} .bdc-criteria tr {
    border-bottom: 1px solid rgba(35, 31, 32, 0.07);
  }

  #bdc-{{ section.id }} .bdc-criteria tr:last-child {
    border-bottom: none;
  }

  #bdc-{{ section.id }} .bdc-criteria td {
    padding: 9px 0;
    vertical-align: middle;
    color: var(--color-text);
  }

  #bdc-{{ section.id }} .bdc-criteria__label {
    font-weight: 600;
    width: 38%;
    min-width: 120px;
  }

  #bdc-{{ section.id }} .bdc-criteria__stars {
    color: var(--color-accent);
    font-size: 13px;
    letter-spacing: 1px;
    width: 90px;
  }

  #bdc-{{ section.id }} .bdc-criteria__note {
    opacity: 0.55;
    font-size: 13px;
    padding-left: 12px;
  }

  /* Link */
  #bdc-{{ section.id }} .bdc-item__link {
    display: inline-block;
    background: var(--color-text);
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 4px;
    text-decoration: none;
    transition: opacity 0.2s;
    margin-top: 4px;
  }

  #bdc-{{ section.id }} .bdc-item__link:hover {
    opacity: 0.82;
  }

  @media (max-width: 600px) {
    #bdc-{{ section.id }} .bdc-wrapper {
      padding: 40px 16px;
    }
    #bdc-{{ section.id }} .bdc-item {
      padding: 20px 16px;
    }
    #bdc-{{ section.id }} .bdc-item__inner {
      flex-direction: column;
    }
    #bdc-{{ section.id }} .bdc-item__image {
      flex: none;
      width: 100%;
    }
    #bdc-{{ section.id }} .bdc-item__image img,
    #bdc-{{ section.id }} .bdc-item__image-placeholder {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
    #bdc-{{ section.id }} .bdc-criteria__note {
      display: none;
    }
    #bdc-{{ section.id }} .bdc-item__title-row {
      flex-direction: column;
      gap: 6px;
    }
    #bdc-{{ section.id }} .bdc-item__link {
      width: 100%;
      text-align: center;
    }
  }
</style>

<section id="bdc-{{ section.id }}">
  <div class="bdc-wrapper">
    <div class="bdc-inner">

      {%- if section.settings.heading != blank or section.settings.intro != blank -%}
        <div class="bdc-section-header">
          {%- if section.settings.heading != blank -%}
            <h2>{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p>{{ section.settings.intro }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- assign rank = block.settings.rank -%}
        <div class="bdc-item {% if rank == 1 %}bdc-item--winner{% endif %}" {{ block.shopify_attributes }}>

          <!-- Rang + badge (boven de image+content rij) -->
          <div class="bdc-item__top">
            <span class="bdc-rank">#{{ rank }}</span>
            {%- if block.settings.badge_text != blank -%}
              <span class="bdc-badge">{{ block.settings.badge_text }}</span>
            {%- endif -%}
          </div>

          <div class="bdc-item__inner">

          <!-- Afbeelding -->
          <div class="bdc-item__image">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: alt: block.settings.title, loading: 'lazy' }}
            {%- else -%}
              <div class="bdc-item__image-placeholder">Geen foto</div>
            {%- endif -%}
          </div>

          <!-- Content -->
          <div class="bdc-item__content">

          <!-- Titel + eindscore -->
          <div class="bdc-item__title-row">
            <h3 class="bdc-item__title">{{ block.settings.title }}</h3>
            {%- if block.settings.score_overall != blank -%}
              <div class="bdc-overall-score">
                <span class="bdc-overall-score__stars">
                  {%- assign filled = block.settings.score_stars -%}
                  {%- for i in (1..5) -%}
                    {%- if i <= filled -%}★{%- else -%}☆{%- endif -%}
                  {%- endfor -%}
                </span>
                <span class="bdc-overall-score__number">{{ block.settings.score_overall }}</span>
              </div>
            {%- endif -%}
          </div>

          <!-- Samenvatting -->
          {%- if block.settings.summary != blank -%}
            <p class="bdc-item__summary">{{ block.settings.summary }}</p>
          {%- endif -%}

          <!-- Criteria tabel -->
          <table class="bdc-criteria">
            {%- assign criteria_labels = block.settings.crit_1_label | append: '|||' | append: block.settings.crit_2_label | append: '|||' | append: block.settings.crit_3_label | append: '|||' | append: block.settings.crit_4_label | append: '|||' | append: block.settings.crit_5_label | split: '|||' -%}
            {%- assign criteria_stars = block.settings.crit_1_stars | append: '|||' | append: block.settings.crit_2_stars | append: '|||' | append: block.settings.crit_3_stars | append: '|||' | append: block.settings.crit_4_stars | append: '|||' | append: block.settings.crit_5_stars | split: '|||' -%}
            {%- assign criteria_notes = block.settings.crit_1_note | append: '|||' | append: block.settings.crit_2_note | append: '|||' | append: block.settings.crit_3_note | append: '|||' | append: block.settings.crit_4_note | append: '|||' | append: block.settings.crit_5_note | split: '|||' -%}

            {%- for label in criteria_labels -%}
              {%- if label != blank -%}
                {%- assign star_count = criteria_stars[forloop.index0] | plus: 0 -%}
                <tr>
                  <td class="bdc-criteria__label">{{ label }}</td>
                  <td class="bdc-criteria__stars">
                    {%- for i in (1..5) -%}
                      {%- if i <= star_count -%}★{%- else -%}☆{%- endif -%}
                    {%- endfor -%}
                  </td>
                  <td class="bdc-criteria__note">{{ criteria_notes[forloop.index0] }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </table>

          <!-- Link knop -->
          {%- if block.settings.show_link and block.settings.link_url != blank -%}
            <a href="{{ block.settings.link_url }}" class="bdc-item__link">
              {{ block.settings.link_text | default: 'Bekijk product →' }}
            </a>
          {%- endif -%}

          </div><!-- /bdc-item__content -->
          </div><!-- /bdc-item__inner -->
        </div>
      {%- endfor -%}

    </div>
  </div>
</section>

