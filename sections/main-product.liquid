{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --product-grid: auto / minmax(0, 1fr);
    --product-gallery-media-list-grid: auto / auto-flow {% if section.settings.mobile_carousel_control == 'free_scroll' %}{% if section.settings.mobile_media_size == 'expanded' %}84vw{% else %}73vw{% endif %}{% else %}100%{% endif %};
    --product-gallery-media-list-gap: {% if section.settings.mobile_media_size == 'expanded' %}var(--spacing-0-5){% else %}var(--grid-gutter){% endif %};
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      --section-spacing-block-start: {% if section.settings.mobile_media_size == 'expanded' %}0px{% else %}var(--container-gutter){% endif %};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- assign media_ratio = section.settings.desktop_media_width | divided_by: 50.0 -%}
      --product-grid: auto / minmax(0, {{ media_ratio }}fr) minmax(0, {{ 2.0 | minus: media_ratio }}fr);
      --product-gallery-media-list-grid: {% if section.settings.desktop_media_layout contains 'grid' %}auto-flow dense / repeat(2, minmax(0, 1fr)){% else %}auto / auto-flow 100%{% endif %};
      --product-gallery-media-list-gap: calc(var(--grid-gutter) / 2);
    }

    {%- if section.settings.desktop_media_layout == 'grid_highlight' -%}
      #shopify-section-{{ section.id }} .product-gallery__media-list > :not([hidden]) {
        grid-column: span 2;
      }

      #shopify-section-{{ section.id }} .product-gallery__media-list > :not([hidden]) ~ *:not(.product-gallery__media--expand) {
        grid-column: span 1;
      }
    {%- endif -%}
  }

  @media screen and (min-width: 1400px) {
    #shopify-section-{{ section.id }} {
      --product-gallery-media-list-gap: var(--grid-gutter);
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .vrc-col {
      grid-column: 2;
    }
  }

  body:has(.product-quick-add.is-visible) .intercom-lightweight-app-launcher,
  body:has(.product-quick-add.is-visible) .intercom-launcher {
    bottom: 164px !important;
    transition: bottom 0.2s ease;
  }
</style>

{{- 'product-block.css' | asset_url | stylesheet_tag: preload: true -}}

<script>
document.addEventListener('DOMContentLoaded', function() {
  const productSwitch = document.querySelector('.product-switch');
  const switchOptions = document.querySelectorAll('.product-switch .switch-option');
  
  if (productSwitch && switchOptions.length > 0) {
    switchOptions.forEach(option => {
      option.addEventListener('click', function(e) {
        e.preventDefault(); // Prevent immediate navigation
        
        const targetUrl = this.dataset.url || this.href;
        const isAlreadyActive = this.classList.contains('active');
        
        // Don't animate if clicking the already active option
        if (isAlreadyActive) return;
        
        // Add animating class for smoother transition
        productSwitch.classList.add('animating');
        
        // Remove active from all, add to clicked
        switchOptions.forEach(opt => opt.classList.remove('active'));
        this.classList.add('active');
        
        // Navigate after animation completes (500ms for smoother feel)
        setTimeout(() => {
          window.location.href = targetUrl;
        }, 500);
      });
    });
    
    // Remove animating class after transition
    productSwitch.addEventListener('transitionend', function() {
      productSwitch.classList.remove('animating');
    });
  }
});
</script>

<script>
  function initializeCompareModal(blockId) {
  const openBtn = document.getElementById('compare-btn-' + blockId);
  const modal = document.getElementById('compare-modal-' + blockId);

  if (!openBtn || !modal) return;

  const closeBtn = modal.querySelector('.compare-modal__close');
  const backdrop = modal.querySelector('.compare-modal__backdrop');

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    modal.setAttribute('aria-hidden', 'true');
    openBtn.focus();
  }

  openBtn.addEventListener('click', function(e) {
    e.preventDefault();
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    modal.setAttribute('aria-hidden', 'false');
    closeBtn.focus();
  });

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.style.display === 'flex') {
      closeModal();
    }
  });
}

function initAllCompareModals(container = document) {
  container.querySelectorAll('[id^="compare-btn-"]').forEach(btn => {
    const blockId = btn.id.replace('compare-btn-', '');
    initializeCompareModal(blockId);
  });
}

document.addEventListener('DOMContentLoaded', () => initAllCompareModals());

document.addEventListener('shopify:section:load', function(event) {
  const section = document.getElementById('shopify-section-' + event.detail.sectionId);
  if (section) initAllCompareModals(section);
});
  </script>


{%- capture product_form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}

<div {% render 'section-properties', tight: true %}>
  <product-rerender id="product-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender>
    <div class="product">
      {%- if product.media.size > 0 -%}
        <div class="sticky-product-images">
          {%- render 'product-gallery', product: product, product_form_id: product_form_id -%}
        </div>
      {%- endif -%}

      {%- render 'product-info', 
        product: product, 
        update_url: true,
        product_form_id: product_form_id,
        context: 'main_product'
      -%}

    </div>
  </product-rerender>
</div>

{%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}

{%- if section.settings.show_fixed_add_to_cart and product.available and buy_buttons_block != blank -%}
  <product-rerender id="{{ product_form_id }}-sticky-bar" observe-form="{{ product_form_id }}">
    {%- if product.selected_or_first_available_variant.available -%}
      <product-quick-add form="{{ product_form_id }}" class="product-quick-add">
        {%- assign button_label = 'product.general.add_to_cart_button' | t-%}
        {%- capture sticky_button_label -%}<span style="display:inline-flex;align-items:center;gap:8px;">{{ button_label }} <svg xmlns="http://www.w3.org/2000/svg" width="3" height="3" viewBox="0 0 3 3" fill="none" style="width:3px;height:3px;flex-shrink:0;"><path d="M0 3V0H3V3H0Z" fill="white"/></svg> {{ product.selected_or_first_available_variant.price | money }}</span>{%- endcapture -%}

        {%- comment -%} Prepare promo banner data once for reuse {%- endcomment -%}
        {%- assign sticky_promo_enabled = buy_buttons_block.settings.promo_enabled -%}
        {%- if sticky_promo_enabled -%}
          <style>
            .product-quick-add.is-visible {
              background: #F3F4F3;
              box-shadow: 0 -4px 34px 0 rgba(0, 0, 0, 0.15);
              padding: 16px;
              border-radius: 8px 8px 0px 0px;
              font-family:'Bai Jamjuree';
              font-size: 16px;
            }
            .product-quick-add .button {
              font-size: 16px !important;
              font-weight: 600 !important;
              padding: 17px;
            }

            .sticky-promo-banner {
              font-family: 'Bai Jamjuree';
              align-items: center;
              gap: 12px;
              text-decoration: none;
              background: #ffffff;
              border-radius: 8px;
              border: 1px solid rgba(22, 37, 24, 0.10);
          
              border-radius: 10px;
              padding: 6px 16px 6px 6px;
              margin-top: 10px;
              cursor: pointer;
            }
            .sticky-promo-banner__images {
              flex-shrink: 0;
              position: relative;
              width: 90px;
              height: 45px;
            }
            .sticky-promo-banner__image {
              position: absolute;
              top: 0;
              width: 45px;
              height: 45px;
              border-radius: 8px;
              overflow: hidden;
              box-shadow: 1px 0 3px rgba(0, 0, 0, 0.08);
            }
            .sticky-promo-banner__image--1 { 
              left: 0; z-index: 1;
              border-radius: 4px;
              border: 1px solid #CCC5BC;

            }
            .sticky-promo-banner__image--2 { 
              border-radius: 4px;
              border: 1px solid #CCC5BC;
              box-shadow: -2px 0 2px 0 rgba(22, 0, 0, 0.20);
              left: 25px; z-index: 2; 
            }
            .sticky-promo-banner__image--3 { 
              left: 46px; z-index: 3; 
              border-radius: 4px;
              border: 1px solid #CCC5BC;
              box-shadow: -2px 0 2px 0 rgba(22, 0, 0, 0.20);
            }
            .sticky-promo-banner__image img {
              width: 100%;
              height: 100%;
              object-fit: cover;
            }
            .sticky-promo-banner__content {
              flex: 1;
              min-width: 0;
            }
            .sticky-promo-banner__title {
              color: #160000;
              font-family: "Bai Jamjuree";
              font-size: 16px;
              font-style: normal;
              font-weight: 600;
              line-height: normal;
            }
            .sticky-promo-banner__subtitle {
              margin: 2px 0 0;
              color: #160000;
              text-align: left;
              leading-trim: both;
              text-edge: cap;
              font-family: "Bai Jamjuree";
              font-size: 12px;
              font-style: normal;
              font-weight: 400;
              line-height: normal;
            }
            .sticky-promo-banner__arrow {
              flex-shrink: 0;
              color: #1a1a1a;
            }
            .sticky-promo-banner--mobile {
              display: flex;
            }

            .sticky-promo-banner--desktop .sticky-promo-banner__images {
              width: 122px;
              height: 50px;
            }
            .sticky-promo-banner--desktop .sticky-promo-banner__image {
              width: 50px;
              height: 50px;
              border: 2px solid #fff;
            }
            .sticky-promo-banner--desktop .sticky-promo-banner__image--1 { left: 0; }
            .sticky-promo-banner--desktop .sticky-promo-banner__image--2 { left: 36px; }
            .sticky-promo-banner--desktop .sticky-promo-banner__image--3 { left: 72px; }
            .sticky-promo-banner--desktop .sticky-promo-banner__title {
              font-size: 14px;
            }
          </style>
          {%- assign sp_mf_parts = buy_buttons_block.settings.promo_scent_metafield | split: '.' -%}
          {%- assign sp_ns = sp_mf_parts[0] -%}
          {%- assign sp_key = sp_mf_parts[1] -%}
