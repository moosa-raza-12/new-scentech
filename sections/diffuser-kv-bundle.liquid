{% liquid
  assign kv_default_desktop_hero_url = blank
  assign kv_default_desktop_hero_video = blank
  for block in section.blocks
    if block.type == 'diffuser'
      assign _hero = block.settings.cds_desktop_hero_image
      assign _sel = block.settings.selector_image
      assign _prod = block.settings.selector_product
      if _hero != blank
        assign kv_default_desktop_hero_url = _hero | image_url: width: 1200
      elsif _sel != blank
        assign kv_default_desktop_hero_url = _sel | image_url: width: 1200
      elsif _prod != blank and _prod.featured_image != blank
        assign kv_default_desktop_hero_url = _prod.featured_image | image_url: width: 1200
      endif
      if block.settings.selector_video_url != blank
        assign kv_default_desktop_hero_video = block.settings.selector_video_url
      endif
      break
    endif
  endfor
%}
