      "label": "End date",
      "info": "Format: YYYY-MM-DD (e.g., 2026-01-31)",
      "default": "2026-01-31"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time",
      "info": "Format: HH:MM (24-hour, e.g., 23:59)",
