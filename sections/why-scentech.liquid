{%- comment -%}
  Why Scentech section
  Spec: docs/superpowers/specs/2026-05-18-why-scentech-design.md
{%- endcomment -%}

<script src="{{ 'why-scentech.js' | asset_url }}" defer></script>

{%- render 'why-scentech-styles',
  section_id: section.id,
  section_bg_color: section.settings.section_bg_color,
  card_bg_color: section.settings.card_bg_color,
  heading_color: section.settings.heading_color,
  body_color: section.settings.body_color,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  heading_alignment: section.settings.heading_alignment,
  heading_size: section.settings.heading_size,
  card_heading_size: section.settings.card_heading_size,
  card_desc_size: section.settings.card_desc_size,
  heading_font: section.settings.heading_font,
  card_heading_font: section.settings.card_heading_font,
  card_desc_font: section.settings.card_desc_font
-%}

<section
  class="wsc-section"
  data-section-id="{{ section.id }}"
  style="background:{{ section.settings.section_bg_color }};--wsc-pad-top:{{ section.settings.padding_top }}px;--wsc-pad-bot:{{ section.settings.padding_bottom }}px;">
  <div class="wsc-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="wsc-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="wsc-track" role="region" aria-label="{{ section.settings.heading | default: 'Scentech benefits' | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <article class="wsc-card" {{ block.shopify_attributes }}>
              <div class="wsc-card__media">
                {%- if block.settings.image != blank -%}
                  {%- assign card_alt = block.settings.image.alt | default: block.settings.heading -%}
                  {{ block.settings.image | image_url: width: 1000 | image_tag:
                    class: 'wsc-card__img',
                    loading: 'lazy',
                    widths: '400,600,800,1000',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 85vw',
                    alt: card_alt
                  }}
                {%- endif -%}
              </div>
              <div class="wsc-card__body">
                {%- if block.settings.heading != blank -%}
                  <h3 class="wsc-card__heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="wsc-card__desc">{{ block.settings.description }}</div>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Why Scentech",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["*"] },
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why thousands love Scentech" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "color", "id": "section_bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "card_bg_color", "label": "Card background", "default": "#fcfbf4" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#160000" },
    { "type": "color", "id": "body_color", "label": "Body text color", "default": "#162518" },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 120, "step": 4, "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 120, "step": 4, "default": 24 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Section heading size (px, desktop)", "min": 24, "max": 96, "step": 2, "default": 48 },
    { "type": "select", "id": "heading_font", "label": "Section heading font", "options": [
      { "value": "Kento-Bold", "label": "Kento Bold" },
      { "value": "Kento-Regular", "label": "Kento Regular" },
      { "value": "Kento-Light", "label": "Kento Light" },
      { "value": "BaiJamjuree-Bold", "label": "Bai Jamjuree Bold" },
      { "value": "BaiJamjuree-SemiBold", "label": "Bai Jamjuree SemiBold" },
      { "value": "BaiJamjuree-Medium", "label": "Bai Jamjuree Medium" },
      { "value": "BaiJamjuree-Regular", "label": "Bai Jamjuree Regular" },
      { "value": "BaiJamjuree-Light", "label": "Bai Jamjuree Light" },
      { "value": "BaiJamjuree-ExtraLight", "label": "Bai Jamjuree ExtraLight" }
    ], "default": "Kento-Bold" },
    { "type": "range", "id": "card_heading_size", "label": "Card heading size (px)", "min": 14, "max": 36, "step": 1, "default": 20 },
    { "type": "select", "id": "card_heading_font", "label": "Card heading font", "options": [
      { "value": "Kento-Bold", "label": "Kento Bold" },
      { "value": "Kento-Regular", "label": "Kento Regular" },
      { "value": "Kento-Light", "label": "Kento Light" },
      { "value": "BaiJamjuree-Bold", "label": "Bai Jamjuree Bold" },
      { "value": "BaiJamjuree-SemiBold", "label": "Bai Jamjuree SemiBold" },
      { "value": "BaiJamjuree-Medium", "label": "Bai Jamjuree Medium" },
      { "value": "BaiJamjuree-Regular", "label": "Bai Jamjuree Regular" },
      { "value": "BaiJamjuree-Light", "label": "Bai Jamjuree Light" },
      { "value": "BaiJamjuree-ExtraLight", "label": "Bai Jamjuree ExtraLight" }
    ], "default": "Kento-Bold" },
    { "type": "range", "id": "card_desc_size", "label": "Card description size (px)", "min": 12, "max": 22, "step": 1, "default": 15 },
    { "type": "select", "id": "card_desc_font", "label": "Card description font", "options": [
      { "value": "BaiJamjuree-Bold", "label": "Bai Jamjuree Bold" },
      { "value": "BaiJamjuree-SemiBold", "label": "Bai Jamjuree SemiBold" },
      { "value": "BaiJamjuree-Medium", "label": "Bai Jamjuree Medium" },
      { "value": "BaiJamjuree-Regular", "label": "Bai Jamjuree Regular" },
      { "value": "BaiJamjuree-Light", "label": "Bai Jamjuree Light" },
      { "value": "BaiJamjuree-ExtraLight", "label": "Bai Jamjuree ExtraLight" }
    ], "default": "BaiJamjuree-Regular" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Card heading" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Short benefit description, one to two sentences.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Scentech",
      "blocks": [
        { "type": "card", "settings": {
          "heading": "Non-toxic fragrances",
          "description": "<p>Clean, premium ingredients crafted to be safe for the whole family—including pets.</p>"
        }},
        { "type": "card", "settings": {
          "heading": "Smart scent control",
          "description": "<p>Schedule and automate your scent experience without wasting fragrance.</p>"
        }},
        { "type": "card", "settings": {
          "heading": "Hotel-quality scent",
          "description": "<p>Powered by the same diffusion technology luxury hotels use — turn every room into a five-star escape.</p>"
        }}
      ]
    }
  ]
}
{% endschema %}
