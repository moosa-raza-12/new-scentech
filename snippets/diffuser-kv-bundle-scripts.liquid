            description: infoBtn.getAttribute('data-product-description'),
            details: infoBtn.getAttribute('data-product-details'),
            image: infoBtn.getAttribute('data-product-image'),
            variant: infoBtn.getAttribute('data-product-variant'),
            badge: infoBtn.getAttribute('data-product-badge')
          };
          
          openScentModal(productData);
        } else if (productImage) {
          e.preventDefault();
          e.stopPropagation();
          
          // Find parent product card to get data attributes
          const productCard = productImage.closest('.kv-bundle-product-card');
          if (productCard) {
            const infoButton = productCard.querySelector('.kv-scent-info-btn');
            if (infoButton) {
              const productData = {
                productId: infoButton.getAttribute('data-product-id'),
                title: infoButton.getAttribute('data-product-title'),
                description: infoButton.getAttribute('data-product-description'),
                details: infoButton.getAttribute('data-product-details'),
                image: infoButton.getAttribute('data-product-image'),
                variant: infoButton.getAttribute('data-product-variant'),
                badge: infoButton.getAttribute('data-product-badge')
              };
              
              openScentModal(productData);
