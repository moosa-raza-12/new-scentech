        {% endif %}
        {% if intr.settings.badge_text != blank %}
          <div class="kv-bundle-interrupter-badge">{{ intr.settings.badge_text }}</div>
        {% endif %}
      </div>
      <div class="kv-bundle-interrupter-content">
        {% if intr.settings.heading != blank %}
          <div class="kv-bundle-interrupter-title">{{ intr.settings.heading }}</div>
        {% endif %}
        {% if intr.settings.description != blank %}
          <div class="kv-bundle-interrupter-text">{{ intr.settings.description }}</div>
        {% endif %}
        {% if intr.settings.show_cta and intr.settings.cta_label != blank and intr.settings.cta_link != blank %}
          <a class="kv-bundle-interrupter-cta" href="{{ intr.settings.cta_link }}"{% if intr.settings.cta_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
            {{ intr.settings.cta_label }}
          </a>
        {% endif %}
