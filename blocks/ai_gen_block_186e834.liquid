{% doc %}
  @prompt
    textbox with a background that is 50% opacity. in the text box i can specify rich text. the box has a border that is slightly darker than the background but same color (maybe just same color without opacity. the box has rounded corners 12px radius and reaches from left to right on mobile but not full width (almost though) and the bigger the screen the more space left and right. On pc it should be about 25% space on both left and right., make the border a bit thicker, a little more padding on both sides mobile, enable me to specify the color for the border and background seperately and also make sure to remove the opacity, some more padding above the section

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-textbox-container-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.top_spacing }}px 16px 0;
  }

  .ai-textbox-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border: 2px solid {{ block.settings.border_color }};
    border-radius: 12px;
    padding: {{ block.settings.padding }}px;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .ai-textbox-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  .ai-textbox-content-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;}

  .ai-textbox-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-textbox-content-{{ ai_gen_id }} h1,
  .ai-textbox-content-{{ ai_gen_id }} h2,
  .ai-textbox-content-{{ ai_gen_id }} h3,
  .ai-textbox-content-{{ ai_gen_id }} h4,
  .ai-textbox-content-{{ ai_gen_id }} h5,
  .ai-textbox-content-{{ ai_gen_id }} h6 {
    margin: 0 0 0.5em 0;
    color: {{ block.settings.text_color }};
  }

  .ai-textbox-content-{{ ai_gen_id }} ul,
  .ai-textbox-content-{{ ai_gen_id }} ol {
    margin: 0 0 1em 0;
    padding-left: 1.5em;
  }

  .ai-textbox-content-{{ ai_gen_id }} li {
    margin-bottom: 0.25em;
  }

  .ai-textbox-content-{{ ai_gen_id }} strong {
    font-weight: 600;
  }

  .ai-textbox-content-{{ ai_gen_id }} em {
    font-style: italic;
  }

  .ai-textbox-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-textbox-content-{{ ai_gen_id }} a:hover {
    opacity: 0.8;
  }

  @media screen and (min-width: 750px) {
    .ai-textbox-container-{{ ai_gen_id }} {
      padding: {{ block.settings.top_spacing }}px 12.5% 0;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-textbox-container-{{ ai_gen_id }} {
      padding: {{ block.settings.top_spacing }}px 25% 0;
    }
  }
{% endstyle %}

<div class="ai-textbox-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-textbox-{{ ai_gen_id }}">
    {% if block.settings.content != blank %}
      <div class="ai-textbox-content-{{ ai_gen_id }}">
        {{ block.settings.content }}
      </div>
    {% else %}
      <div class="ai-textbox-content-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
        Add your rich text content here...
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Rich text box",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text content",
      "default": "<p>Add your rich text content here. You can format text, add links, and create lists.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#4a90e2"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Inner spacing",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Rich text box"
    }
  ],
  "tag": null
}
{% endschema %}