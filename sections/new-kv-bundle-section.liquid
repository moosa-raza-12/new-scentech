{% render 'new-kv-bundle-css' %}

<style>
  .shopify-section-group-footer-group { display: none !important; }
  body { padding-bottom: var(--kv-sticky-height, 0px); }
</style>
<script>
  (function () {
    function updateStickyHeight() {
      var sticky = document.querySelector('.kv-bundle-items-sticky');
      if (!sticky) {
        document.documentElement.style.setProperty('--kv-sticky-height', '0px');
        return;
      }
      var h = sticky.offsetHeight || 0;
      document.documentElement.style.setProperty('--kv-sticky-height', h + 'px');
    }
    function attachObserver() {
      var sticky = document.querySelector('.kv-bundle-items-sticky');
      if (!sticky) { return setTimeout(attachObserver, 250); }
      updateStickyHeight();
      if ('ResizeObserver' in window) {
        new ResizeObserver(updateStickyHeight).observe(sticky);
      }
      if ('MutationObserver' in window) {
        new MutationObserver(updateStickyHeight).observe(sticky, { childList: true, subtree: true, characterData: true });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', attachObserver);
    } else {
      attachObserver();
    }
    window.addEventListener('load', updateStickyHeight);
    window.addEventListener('resize', updateStickyHeight);
    window.addEventListener('orientationchange', updateStickyHeight);
  })();
</script>

