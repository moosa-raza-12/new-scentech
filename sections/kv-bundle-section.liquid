/* Page Preloader */

/* Hero Section */
.kv-bundle-hero-section {
    padding: 64px 0px;
    transition: padding 0.3s ease, background 0.3s ease;
    width: 100%;
    z-index: 9;
    position: relative;
}

.kv-bundle-hero-section.sticky {
    backdrop-filter: blur(12px);
    background-image: unset !important;
    border: 1px solid var(--kv-hero-sticky-border);
    background: var(--kv-hero-sticky-bg);
    padding: 24px 0 0;
    position: sticky;
    top: var(--kv-hero-offset, 0px);
}

.kv-bundle-hero-container {
    width: 100%;
    max-width: 1000px;
    padding: 0 20px;
    margin: auto;
}

.kv-bundle-hero-inner {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    transition: gap 0.3s ease;
}

.kv-bundle-hero-section.sticky .kv-bundle-hero-inner {
    justify-content: center;
}

.kv-bundle-hero-content {
    max-width: 400px;
    width: 100%;
    color: var(--kv-hero-text);
    transition: opacity 0.3s ease, transform 0.3s ease;
}

.kv-bundle-hero-section.sticky .kv-bundle-hero-content {
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
    display: none;
}
.kv-bundle-hero-title {
    margin: 0 0 12px 0;
    text-transform: uppercase;
    font-family: 'Kento';
    color: var(--kv-hero-text);
    font-size: 42px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
}

.kv-bundle-hero-description {
    margin: 0;
    color: var(--kv-hero-text);
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    font-family: 'N27';
}

/* Progress Banner */
.kv-progress-banner {
    padding: 12px 16px;
    width: 100%;
    border-radius: 12px;
    background: var(--kv-progress-banner-bg);
    max-width: 400px;
    transition: all 0.3s ease;
}

.kv-bundle-hero-section.sticky .kv-progress-banner {
    max-width: 430px;
    background: transparent;
}

.kv-bundle-hero-section.sticky .kv-progress-banner .kv-progress-footer {
  border-radius: 12px 12px 0 0;
  background: var(--kv-progress-sticky-footer-bg);
}

.kv-promo-banner {
  background-color: var(--kv-promo-fallback-bg);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  padding: 10px 8px;
  overflow: hidden;
  border-radius: 6px;
  width: 100%;
  margin: 0 auto;
  margin-top: 12px;
  max-width: 420px;
}

.kv-promo-banner-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.kv-promo-banner-text {
  color: var(--kv-promo-text);
  font-size: 12px;
  line-height: 1.4;
  text-align: center;
  margin: 0;
 font-family: "Bai Jamjuree";
}

.kv-promo-banner-text strong {
  font-weight: 600;
}

@media (max-width: 767.98px) {
  .kv-promo-banner {
      border-radius: 10px;
  }

  .kv-promo-banner-text {
      font-size: 12px;
  }
}

.kv-progress-bar-container {
    position: relative;
    padding: 32px 0 45px;
    max-width: 290px;
    margin: auto;
}

.kv-progress-price {
  position: absolute;
  left: 0;
  bottom: 30px;
  font-size: 16px;
  font-weight: 500;
  color: var(--kv-progress-text);
}

.kv-progress-bar {
    width: 100%;
    height: 3px;
    overflow: visible;
    position: relative;
    border-radius: 99px;
    background: var(--kv-progress-bar-track);
}

.kv-progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--kv-progress-bar-fill-start) 0%, var(--kv-progress-bar-fill-end) 100%);
  border-radius: 4px;
  width: 0%;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 0 8px var(--kv-progress-bar-glow);
}

.kv-progress-milestones {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
}

.kv-progress-milestone {
    position: absolute;
    top: 42%;
    transform: translate(-50%, -50%);
    text-align: center;
}

.kv-milestone-marker {
    width: 18px;
    height: 18px;
    position: relative;
    z-index: 2;
    transition: all 0.3s ease;
    margin: 0 auto;
    border-radius: 99px;
    border: 2px solid var(--kv-milestone-marker-border);
    background: var(--kv-milestone-marker-bg);
}

.kv-progress-milestone.unlocked .kv-milestone-marker {
    background: var(--kv-milestone-unlocked);
    border-color: var(--kv-milestone-unlocked);
    transform: unset;
}

.kv-milestone-label {
    position: absolute;
    left: 50%;
    white-space: nowrap;
    min-width: 80px;
    bottom: calc(100% + 12px);
    color: var(--kv-progress-text);
    text-align: center;
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    transform: translateX(-50%);
}

.kv-milestone-gift {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    min-width: 100px;
    cursor: pointer;
}

.kv-milestone-gift-image {
    width: 28px;
    height: 28px;
    object-fit: contain;
    margin: 3px auto;
    border-radius: 4px;
    border: 1px solid var(--kv-milestone-gift-border);
    position: relative;
    display: block;
}

.kv-milestone-gift-text {
    color: var(--kv-progress-text);
    text-align: center;
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
}

.kv-milestone-price {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    min-width: 100px;
}

.kv-milestone-price-image {
    width: 28px;
    height: 28px;
    object-fit: contain;
    margin: 3px auto;
    border-radius: 4px;
    position: relative;
    display: block;
}

.kv-milestone-price-image {
    opacity: 0;
    visibility: hidden;
}

.kv-milestone-price-text {
    color: var(--kv-progress-text);
    text-align: center;
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
}

.kv-progress-milestone .kv-milestone-gift-image {
    border: none;
    padding: 1px;
    animation: kv-gradient-rotate 3s linear infinite;
}

@keyframes kv-gradient-rotate {
    0% {
        background: var(--kv-milestone-gift-border);
    }
    100% {
        background: var(--kv-milestone-gift-border-active);
    }
}

.kv-progress-milestone.unlocked .kv-milestone-gift-text {
  color: var(--kv-progress-text);
}

.kv-progress-gifts {
  display: none;
}

.kv-progress-footer {
    background: var(--kv-progress-footer-bg);
    border-radius: 0;
    padding: 10px 12px;
    text-align: center;
    margin: 8px -16px -12px;
}

.kv-progress-footer-message {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--kv-progress-text);
    font-size: 12px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
}

.kv-progress-footer-message.clickable {
    cursor: pointer;
    transition: opacity 0.2s;
}

.kv-progress-footer-message.clickable:hover {
    opacity: 0.8;
}

.kv-progress-footer-message svg {
  width: 15px;
  height: 15px;
  flex-shrink: 0;
}

.kv-progress-footer-message svg path,
.kv-progress-footer-message-empty svg path,
.kv-bundle-thumbnail.kv-skeleton svg path,
.kv-below-atc-discount svg path,
