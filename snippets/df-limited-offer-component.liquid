{% liquid
  assign accordion_id = 'lp-diffuser-accordion-' | append: section.id
%}

<div class="lp-diffuser-accordion">
  <button
    class="lp-diffuser-accordion__trigger"
    type="button"
    aria-expanded="false"
    aria-controls="{{ accordion_id }}">
    <div class="lp-diffuser-accordion__heading-wrap">
      <span class="lp-diffuser-accordion__heading">
        {{ section.settings.closed_heading }}
      </span>

      <span class="lp-diffuser-accordion__subtext">
        {{ section.settings.closed_subtext }}
      </span>
    </div>

    <span
      class="lp-diffuser-accordion__icon"
      data-open-icon="{{ section.settings.open_icon }}"
      data-close-icon="{{ section.settings.close_icon }}">
      {{ section.settings.close_icon }}
    </span>
  </button>

  <div id="{{ accordion_id }}" class="lp-diffuser-accordion__content">
    <div class="lp-diffuser-accordion__inner">
      {{ section.settings.content }}
    </div>
  </div>
</div>

<style>
  .lp-diffuser-accordion {
    width: 100%;
  }

  .lp-diffuser-accordion__trigger {
    width: 100%;
    border: 1px dashed{{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
    background: {{ section.settings.background_color }};

    padding: {{ section.settings.padding_vertical }}px{{ section.settings.padding_horizontal }}px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;

    cursor: pointer;
    transition: all 0.3s ease;
  }

  .lp-diffuser-accordion__trigger:hover {
    background: {{ section.settings.hover_background_color }};
  }

  .lp-diffuser-accordion__heading-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    text-align: left;
  }

  .lp-diffuser-accordion__heading {
    color: {{ section.settings.heading_color-id }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.3;
  }

  .lp-diffuser-accordion__subtext {
    color: {{ section.settings.subtext_color }};
    font-size: {{ section.settings.subtext_size }}px;
    line-height: 1.4;
  }

  .lp-diffuser-accordion__icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;

    border-radius: {{ section.settings.icon_radius }}px;
    background: {{ section.settings.icon_background }};

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    color: {{ section.settings.icon_color }};
    font-size: {{ section.settings.icon_font_size }}px;
    font-weight: 600;
  }

  .lp-diffuser-accordion__content {
    max-height: 0;
    overflow: hidden;

    transition: max-height 0.35s ease;
  }

  .lp-diffuser-accordion__inner {
    padding-top: 16px;

    color: {{ section.settings.content_color }};
    font-size: {{ section.settings.content_size }}px;
    line-height: 1.6;
  }

  .lp-diffuser-accordion.active .lp-diffuser-accordion__trigger {
    border-style: solid;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordion = document.querySelector('.lp-diffuser-accordion');
  
    if (!accordion) return;
  
    const trigger = accordion.querySelector('.lp-diffuser-accordion__trigger');
    const content = accordion.querySelector('.lp-diffuser-accordion__content');
    const heading = accordion.querySelector('.lp-diffuser-accordion__heading');
    const subtext = accordion.querySelector('.lp-diffuser-accordion__subtext');
    const icon = accordion.querySelector('.lp-diffuser-accordion__icon');
  
    const closedHeading = `{{ section.settings.closed_heading | escape }}`;
    const openHeading = `{{ section.settings.open_heading | escape }}`;
  
    const closedSubtext = `{{ section.settings.closed_subtext | escape }}`;
    const openSubtext = `{{ section.settings.open_subtext | escape }}`;
  
    trigger.addEventListener('click', () => {
      const isOpen = accordion.classList.contains('active');
  
      accordion.classList.toggle('active');
  
      if (isOpen) {
        content.style.maxHeight = null;
  
        trigger.setAttribute('aria-expanded', 'false');
  
        heading.textContent = closedHeading;
        subtext.textContent = closedSubtext;
  
        icon.textContent = icon.dataset.closeIcon;
      } else {
        content.style.maxHeight = content.scrollHeight + 'px';
  
        trigger.setAttribute('aria-expanded', 'true');
  
        heading.textContent = openHeading;
        subtext.textContent = openSubtext;
  
        icon.textContent = icon.dataset.openIcon;
      }
    });
  });
</script>