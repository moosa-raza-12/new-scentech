    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
    pointer-events: none;
  }

  .cmp-scent-modal-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .cmp-scent-modal {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
