  stroke: currentColor;
}

.kv-progress-footer-message-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--kv-progress-text);
    font-size: 12px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
    cursor: pointer;
    transition: opacity 0.2s;
}

.kv-progress-footer-message-empty:hover {
    opacity: 0.8;
}

.kv-progress-footer-message-empty svg {
  width: 15px;
  height: 15px;
  flex-shrink: 0;
}

.kv-bundle-collection-inner {
    max-width: 1080px;
    padding: 0 20px;
    margin: auto;
}

.kv-bundle-collection {
    padding: 24px 0;
    background: var(--kv-collection-bg);
}
  
.kv-bundle-tabs {
