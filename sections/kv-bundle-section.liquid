}

.kv-bundle-tab {
    background: transparent;
    padding: 13px 22px;
    cursor: pointer;
    transition: all 0.3s ease;
    color: var(--kv-tab-text);
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    border-radius: 6px;
    border: 1px solid var(--kv-tab-border);
