        </svg>
        {% if section.settings.selector_compare_text != blank %}
          <a href="{{ section.settings.selector_compare_link }}" class="cds-compare">
            {{ section.settings.selector_compare_text }}
          </a>
        {% endif %}
      </div>

    </div>
    <p class="cds-subtext">{{ section.settings.selector_subtext }}</p>
  </div>

  <!-- Promo Banner -->
  {% if section.settings.selector_banner_text != blank %}
    <div class="cds-banner">
      {{ section.settings.selector_banner_text }}
    </div>
  {% endif %}

  <!-- Diffuser Blocks -->
  <div class="cds-list">
    {% for block in section.blocks %}
      {% if block.type == "diffuser" %}
        {% comment %} Get selected product (if any) {% endcomment %}
        {% assign product_obj = block.settings.selector_product %}

        {% comment %} ----- IMAGE FALLBACK ----- {% endcomment %}
        {% assign img_url = block.settings.selector_image %}
        {% if img_url == blank and product_obj != blank and product_obj.featured_image != blank %}
          {% assign img_url = product_obj.featured_image %}
        {% endif %}

        {% comment %} ----- PRICE & DISCOUNT ----- {% endcomment %}
        {% assign new_price_display = block.settings.selector_new_price %}
        {% assign old_price_display = block.settings.selector_old_price %}
        {% assign discount_percent = nil %}

        {% if product_obj != blank and product_obj.price > 0 %}
          {% assign new_price_display = product_obj.price | money %}
          {% if product_obj.compare_at_price > product_obj.price %}
            {% assign old_price_display = product_obj.compare_at_price | money %}
            {% assign discount_percent = product_obj.compare_at_price | minus: product_obj.price | times: 100 | divided_by: product_obj.compare_at_price %}
          {% endif %}
        {% endif %}

        {% comment %} ----- DIFFUSER DETECTION (for cds-highlight) ----- {% endcomment %}
        {% assign is_diffuser = false %}
        {% if product_obj != blank %}
          {% if product_obj.type == "Diffuser" or product_obj.tags contains "diffuser" %}
            {% assign is_diffuser = true %}

          {% endif %}
        {% endif %}
        {% comment %} {% if block.settings.selector_highlight %}active{% endif %} {% endcomment %}
        <div class="cds-cards" {{ block.shopify_attributes }}>
          <div class="cds-card-innerss">

            {% if img_url %}
              <div class="cds-image">
                <img src="{{ img_url | image_url: width: 200 }}" alt="">
              </div>
            {% endif %}

            <div class="cds-content">
              <h3 class="cds-name">{{ block.settings.selector_title }}</h3>
              <p class="cds-desc">{{ block.settings.selector_description }}</p>
            </div>

            <div class="cds-price">
              {% if old_price_display != blank %}
                <span class="old">{{ old_price_display }}</span>
                {% comment %} {% if discount_percent %}
                                                    <span class="discount-badge">{{ discount_percent }}% off</span>
                                              {% endif %} {% endcomment %}
              {% endif %}
              <span class="new">{{ new_price_display }}</span>
            </div>

          </div>

          {% comment %} Highlight only for diffuser products with text set {% endcomment %}
          {% comment %} {% if is_diffuser and block.settings.selector_highlight_text != blank %} {% endcomment %}
          <div class="cds-highlight">
            {{ block.settings.selector_highlight_text }}
          </div>
        {% comment %} {% endif %} {% endcomment %}

        </div>
      {% endif %}
    {% endfor %}
  </div>


</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const cardSelector = '.cds-cards';
    const activeClass = 'active';
    const highlightSelector = '.cds-highlight';
  
    function hideAllHighlights() {
      document.querySelectorAll(highlightSelector).forEach(hl => {
        hl.style.display = 'none';
      });
    }
  
    function resetActiveCards() {
      document.querySelectorAll(cardSelector).forEach(card => {
        card.classList.remove(activeClass);
      });
    }
  
    function showHighlightForCard(card) {
      const highlight = card.querySelector(highlightSelector);
      if (highlight) {
        highlight.style.display = ''; // revert to CSS default (e.g., block or flex)
      }
    }
  
    // Initially hide all highlights (if they are not already hidden by CSS)
    hideAllHighlights();
  
    // Delegate click event to handle dynamically added cards
    document.body.addEventListener('click', function(e) {
      // Find the closest .cds-cards element (allows clicking on inner elements)
      const card = e.target.closest(cardSelector);
      if (!card) return;
  
      // If this card is already active, do nothing (or optionally unselect – decide)
      if (card.classList.contains(activeClass)) {
        return; // already active, ignore
      }
  
      // Remove active class from all cards and hide all highlights
      resetActiveCards();
      hideAllHighlights();
  
      // Activate the clicked card
      card.classList.add(activeClass);
      showHighlightForCard(card);
    });
  });
</script>

<style>
  .cds-highlight {
    display: none;
  }

  .cds-cards.active .cds-highlight {
    display: block;
    /* or flex, depending on your layout */
  }
  .compare-icon-wrapper {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    cursor: pointer;
  }
  .custom-diffuser-selector {
    width: 100%;
    max-width: 1000px;
    padding: 20px 20px 0;
    margin: auto;
  }


  /*

   .cds-header-content{ 
   display: flex; 
   justify-content: space-between; 
   } 
*/

  /* Header */.cds-header {
    margin-bottom: 16px;
  }
  .cds-header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cds-left {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  .cds-step {
    width: 40px;
    height: 40px;
    background: #1f3d2b;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
  }
  @media (max-width: 639px) {
    .cds-step {
      width: 24px !important;
      height: 24px !important;
      font-size: 12px !important;
    }
  }
  .cds-title {
    margin: 0;
    font-size: 24px;
  }
  @media (max-width: 639px) {
    .cds-title {
      color: #160000;
      text-align: center;
      font-size: 16px !important;
    }
  }

  .cds-subtext {
    margin-top: 10px;
    color: #160000;
  }

  .cds-compare {
    color: #162518;
    font-size: 12px;
    font-weight: 600;
    text-decoration-line: underline;
  }

  /* Banner */
  .cds-banner {
    border-radius: 6px;
    background: #938E70;
    color: #fff;
    padding: 14px;
    margin-bottom: 16px;
    text-align: center;
  }
  @media screen and (max-width: 639px) {
    .cds-banner {
      padding: 10px 16px;
      font-size: 12px;
    }
  }
  /* Cards */
  .cds-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cds-cards {
    border: 1px solid #ddd;
    border-radius: 12px;
    overflow: hidden;
  }

  .cds-card.active {
    border: 2px solid #2e2e2e;
  }

  .cds-card-innerss {
    display: flex;
    gap: 16px;
    padding: 14px;
    align-items: center;
  }

  .cds-image img {
    width: 70px;
    height: auto;
    border-radius: 8px;
  }

  .cds-content {
    flex: 1;
  }

  .cds-name {
    margin: 0;
    color: #160000;
    font-size: 18px;
    font-weight: 400;
  }
  @media (max-width: 639px) {
    .cds-name {
      font-size: 16px !important;
    }
  }

  .cds-desc {
    margin: 4px 0 0;
    color: #555;
    font-size: 14px;
  }
  @media (max-width: 639px) {
    .cds-desc {
      font-size: 12px !important;
    }
  }
  .cds-price {
    text-align: right;
    white-space: nowrap;
  }

  .cds-price .old {
    display: block;
    text-decoration: line-through;
    color: #999;
    font-size: 14px;
  }

  .cds-price .new {
    font-weight: 600;
    font-size: 16px;
  }

  /* Highlight footer */
  .cds-highlight {
    background: #e9e6dc;
    padding: 10px;
    text-align: center;
    font-size: 14px;
  }
</style>