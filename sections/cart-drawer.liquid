{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Cart drawer won't appear to your customers if you have set the cart type to Page in the global theme settings."
    },
    {
      "type": "paragraph",
      "content": "Free shipping bar can be configured in global cart settings."
    },
    {
      "type": "header",
      "content": "Free shipping bar"
    },
    {
      "type": "text",
      "id": "kv_shipping_threshold",
      "label": "Free shipping minimum amount",
      "info": "Enter the amount in your store's main currency (e.g. 50).",
      "default": "50"
    },
    {
      "type": "inline_richtext",
      "id": "kv_shipping_unreached_text",
      "label": "Below threshold text",
      "info": "Use {amount} for the remaining amount (currency symbol is auto-added). Use bold for emphasis.",
      "default": "Spend <strong>{amount}</strong> more to get <strong>FREE SHIPPING</strong>!"
    },
    {
      "type": "inline_richtext",
      "id": "kv_shipping_reached_text",
      "label": "Above threshold text",
      "default": "Nice work! <strong>FREE SHIPPING</strong> unlocked"
    },
    {
      "type": "inline_richtext",
      "id": "kv_shipping_reached_gifts_text",
