        </svg>
        {% if section.settings.selector_compare_text != blank %}
          <a href="{{ section.settings.selector_compare_link }}" class="cds-compare">
            {{ section.settings.selector_compare_text }}
          </a>
        {% endif %}
      </div>

    </div>
    <p class="cds-subtext">{{ section.settings.selector_subtext }}</p>
  </div>

  <!-- Promo Banner -->
  {% if section.settings.selector_banner_text != blank %}
    <div class="cds-banner">
      {{ section.settings.selector_banner_text }}
    </div>
  {% endif %}

  <!-- Diffuser Blocks -->
  <div class="cds-list">
    {% for block in section.blocks %}
      {% if block.type == "diffuser" %}
        {% assign product_obj = block.settings.selector_product %}
        {% assign new_price_display = nil %}
        {% assign old_price_display = nil %}
        {% assign discount_percent = block.settings.selector_discount_percent | default: 0 %}

        {% comment %} Get image {% endcomment %}
        {% assign img_url = block.settings.selector_image %}
        {% if img_url == blank and product_obj != blank and product_obj.featured_image != blank %}
          {% assign img_url = product_obj.featured_image %}
        {% endif %}

        {% if product_obj != blank %}
          {% assign original_price_cents = product_obj.price %}

          {% if discount_percent > 0 %}
            {% assign discount_multiplier = 100 | minus: discount_percent %}
            {% assign discounted_price_cents = original_price_cents | times: discount_multiplier | divided_by: 100 %}
            {% assign old_price_display = original_price_cents | money %}
            {% assign new_price_display = discounted_price_cents | money %}
          {% else %}
            {% assign new_price_display = original_price_cents | money %}
          {% endif %}
        {% endif %}

        {% assign selected_variant = product_obj.selected_or_first_available_variant %}
        {% assign card_product_id = '' %}
        {% assign card_product_handle = '' %}
        {% assign card_variant_id = '' %}
        {% assign card_variant_price = 0 %}
        {% assign card_variant_compare_at_price = 0 %}
        {% assign card_title = block.settings.selector_title %}
        {% assign card_image = '' %}

        {% if product_obj != blank %}
          {% assign card_product_id = product_obj.id %}
          {% assign card_product_handle = product_obj.handle %}
          {% assign card_title = product_obj.title %}
          {% if selected_variant != blank %}
            {% assign card_variant_id = selected_variant.id %}
            {% assign card_variant_price = selected_variant.price %}
            {% assign card_variant_compare_at_price = selected_variant.compare_at_price | default: 0 %}
          {% endif %}
          {% if product_obj.featured_image != blank %}
            {% assign card_image = product_obj.featured_image | image_url: width: 600 %}
          {% elsif img_url != blank %}
            {% assign card_image = img_url | image_url: width: 600 %}
          {% endif %}
        {% elsif img_url != blank %}
          {% assign card_image = img_url | image_url: width: 600 %}
        {% endif %}

        <div
          class="cds-cards"
          data-product-id="{{ card_product_id }}"
          data-product-handle="{{ card_product_handle }}"
          data-variant-id="{{ card_variant_id }}"
          data-variant-price="{{ card_variant_price }}"
          data-variant-compare-at-price="{{ card_variant_compare_at_price }}"
          data-product-title="{{ card_title | escape }}"
          data-product-image="{{ card_image | escape }}"
          {{ block.shopify_attributes }}>
          <div class="cds-card-innerss">
            {% if img_url %}
              <div class="cds-image">
                {{ img_url | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </div>
            {% endif %}

            <div class="cds-content">
              <div class="cds-header-content">
                <h3 class="cds-name">
                  {% if product_obj != blank %}
                  {{ block.settings.selector_title }}
                  {% else %}
                  {{ product_obj.title }} 
                  {% endif %}
                </h3>

                <div class="cds-price">
                  
                    {% if old_price_display != nil and old_price_display != blank %}
                    <span class="old">{{ old_price_display }}</span>
                    {% else %}
                    <span class="old">{{ new_price_display }}</span>
                    {% endif %}
                
                  <span class="new">{{ new_price_display }}</span>
                </div>
              </div>
              <p class="cds-desc">{{ block.settings.selector_description }}</p>
            </div>
          </div>

          {% if discount_percent > 0 and new_price_display != blank %}
            <div class="cds-highlight">
              {{ block.settings.selector_highlight_text | replace: '[price]', new_price_display | replace: '[percent]', discount_percent }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>


</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const cardSelector = '.cds-cards';
    const activeClass = 'active';
    const highlightSelector = '.cds-highlight';
  
    function hideAllHighlights() {
      document.querySelectorAll(highlightSelector).forEach(hl => {
        hl.style.display = 'none';
      });
    }
  
    function resetActiveCards() {
      document.querySelectorAll(cardSelector).forEach(card => {
        card.classList.remove(activeClass);
      });
    }
  
    function showHighlightForCard(card) {
      const highlight = card.querySelector(highlightSelector);
      if (highlight) {
        highlight.style.display = ''; // revert to CSS default (e.g., block or flex)
      }
    }
  
    // Initially hide all highlights (if they are not already hidden by CSS)
    hideAllHighlights();
  
    // Delegate click event to handle dynamically added cards
    document.body.addEventListener('click', function(e) {
      // Find the closest .cds-cards element (allows clicking on inner elements)
      const card = e.target.closest(cardSelector);
      if (!card) return;
  
      // If this card is already active, do nothing (or optionally unselect – decide)
      if (card.classList.contains(activeClass)) {
        return; // already active, ignore
      }
  
      // Remove active class from all cards and hide all highlights
      resetActiveCards();
      hideAllHighlights();
  
      // Activate the clicked card
      card.classList.add(activeClass);
      showHighlightForCard(card);
  
      const selectedProduct = {
        productId: card.getAttribute('data-product-id'),
        productHandle: card.getAttribute('data-product-handle'),
        variantId: card.getAttribute('data-variant-id'),
        variantPrice: parseInt(card.getAttribute('data-variant-price') || '0', 10),
        variantCompareAtPrice: parseInt(card.getAttribute('data-variant-compare-at-price') || '0', 10),
        title: card.getAttribute('data-product-title') || '',
        image: card.getAttribute('data-product-image') || ''
      };
  
      document.dispatchEvent(new CustomEvent('kv:selector-product-selected', {
        detail: selectedProduct
      }));
    });
  });
</script>

<style>
  .cds-highlight {
    display: none;
  }

  .cds-cards.active .cds-highlight {
    display: block;

    /* or flex, depending on your layout */
  }
  .compare-icon-wrapper {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    cursor: pointer;
  }
  .custom-diffuser-selector {
    width: 100%;
    max-width: 1000px;
    padding: 20px 20px 0;
    margin: auto;
  }


  /*

   .cds-header-content{ 
   display: flex; 
   justify-content: space-between; 
   } 
*/

  /* Header */.cds-header {
    margin-bottom: 16px;
  }
  .cds-header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cds-left {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }
  @media (max-width: 749px) {
    .cds-left {
      gap: 8px;
    }
  }
  .cds-step {
    width: 24px;
    height: 24px;
    background: #162518;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 12px;
  }
  @media (max-width: 639px) {
    .cds-step {
      width: 24px !important;
      height: 24px !important;
      font-size: 12px !important;
    }
  }
  .cds-title {
    color: #160000;
    font-weight: 400;
    margin: 0;
    font-size: 16px;
  }
  @media (max-width: 639px) {
    .cds-title {
      text-align: center;
      font-size: 16px !important;
    }
    .compare-icon-wrapper {
      gap: 6px;
    }
    .cds-subtext {
      margin-top: 12px;
      font-size: 12px;
    }
    .cds-header {
      margin-bottom: 20px;
    }
  }

  .cds-subtext {
    margin-top: 12px;
    color: #160000;

    font-weight: 400;
    letter-spacing: 0;
  }

  .cds-compare {
    color: #162518;
    font-size: 12px;
    font-weight: 600;
    text-decoration-line: underline;
  }

  /* Banner */
  .cds-banner {
    border-radius: 6px;
    background: #938E70;
    color: #fff;
    padding: 14px;
    margin-bottom: 20px;
    text-align: center;
    font-size: 12px;
  }
  @media screen and (max-width: 639px) {
    .cds-banner {
      padding: 10px 16px;
      font-size: 12px;
      margin-bottom: 20px;
    }
  }
  /* Cards */
  .cds-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cds-cards {
    border: 1px solid #ddd;
    border-radius: 12px;
    overflow: hidden;
  }

  .cds-cards.active {
    border: 1px solid #160000;
  }

  .cds-card.active {
    border: 2px solid #2e2e2e;
  }

  .cds-card-innerss {
    display: flex;
    gap: 20px;
    padding: 6px;
    padding-right: 20px;
    cursor: pointer;
    align-items: center;
  }

  .cds-image img {
    width: 70px;
    height: auto;
    border-radius: 8px;
  }

  .cds-content {
    flex: 1;
  }

  .cds-name {
    margin: 0;
    color: #160000;
font-size: 16px;
font-weight: 400;
letter-spacing: 0;
  }
  @media (max-width: 639px) {
    .cds-name {
      font-size: 16px !important;
    }
    .cds-image img {
      heigth: 80px;
      width: 80px;
    }
  }

  .cds-desc {
    margin: 12px 0 0;
    color: #160000;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
  }
  @media (max-width: 639px) {
    .cds-desc {
      font-size: 12px !important;
    }
    .cds-header-content {
      display: flex;
      width: 100%;
      justify-content: space-between;
    }
    .cds-desc {
      font-size: 12px;
    }
  }
  .cds-price {
    text-align: right;
    display: flex;
    gap: 5px;
  }

  .cds-price .old {
    display: block;
    text-decoration: line-through;
    color: #938E70;
    font-size: 12px;
  }

  .cds-price .new {
    font-weight: 600;
    font-size: 12px;
    color: #160000;
  }
  @media (max-width: 749px) {
    .cds-price .new {
      font-size: 12px;
    }
    .cds-price .old {
      font-size: 12px;
    }
  }
  /* Highlight footer */
  .cds-highlight {
    background: rgba(0, 0, 0, 0.10);
    padding: 10px 12px;
    text-align: center;
    font-size: 12px;
  }
</style>