/* Scent Modal */
.kv-scent-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ section.settings.scent_modal_overlay_bg | default: '#000000' | color_modify: 'alpha', 0.5 }};
    z-index: 10000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
    pointer-events: none;
}

.kv-scent-modal-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.kv-scent-modal {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10000;
    max-height: 90vh;
    transform: translateY(100%);
    transition: transform 0.3s ease-out;
    max-width: 800px;
    margin: auto;
    border-radius: 16px 16px 0 0;
    background: {{ section.settings.scent_modal_bg | default: '#FFFFFF' }};
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.kv-scent-modal.active {
    transform: translateY(0);
}


.kv-scent-modal-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s;
    border-radius: 99px;
    background: {{ section.settings.scent_modal_close_bg | default: '#160000' }};
}


.kv-scent-modal-image {
  width: 100%;
  height: 360px;
  overflow: hidden;
}

.kv-scent-modal-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.kv-scent-modal-content {
