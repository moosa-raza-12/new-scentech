{%- comment -%}
  Getting Started Steps section
  Pura-inspired horizontal step flow with arrows + CTA button.
  Desktop: 3 steps side-by-side (image top, text bottom), arrows between.
  Mobile: vertical stack (image left, text right), down-arrows between.
{%- endcomment -%}

<script src="{{ 'getting-started.js' | asset_url }}" defer></script>

{%- render 'getting-started-styles',
  section_id: section.id,
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  arrow_color: section.settings.arrow_color,
  cta_bg_color: section.settings.cta_bg_color,
  cta_text_color: section.settings.cta_text_color,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  heading_size: section.settings.heading_size,
  step_heading_size: section.settings.step_heading_size,
  step_desc_size: section.settings.step_desc_size,
  heading_font: section.settings.heading_font,
  step_heading_font: section.settings.step_heading_font,
  step_desc_font: section.settings.step_desc_font,
  image_size_mobile: section.settings.image_size_mobile,
  image_size_desktop: section.settings.image_size_desktop,
  image_radius: section.settings.image_radius
-%}

<section
  class="gs-section"
  data-section-id="{{ section.id }}"
  style="--gs-pad-top:{{ section.settings.padding_top }}px;--gs-pad-bot:{{ section.settings.padding_bottom }}px;">
  <div class="gs-section__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="gs-section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="gs-steps">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <div class="gs-step" {{ block.shopify_attributes }}>
                <div class="gs-step__media">
                  {%- if block.settings.image != blank -%}
                    {%- assign step_alt = block.settings.image.alt | default: block.settings.heading -%}
                    {{ block.settings.image | image_url: width: 600 | image_tag:
                      class: 'gs-step__img',
                      loading: 'lazy',
                      widths: '200,300,400,600',
                      sizes: '(min-width: 750px) 25vw, 30vw',
                      alt: step_alt
                    }}
                  {%- endif -%}
                </div>
                <div class="gs-step__body">
                  {%- if block.settings.heading != blank -%}
                    <h3 class="gs-step__heading">{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <div class="gs-step__desc">{{ block.settings.description }}</div>
                  {%- endif -%}
                </div>
              </div>
              {%- unless forloop.last -%}
                <div class="gs-arrow" aria-hidden="true">
                  <svg class="gs-arrow__svg gs-arrow__svg--desktop" viewBox="0 0 33 13" xmlns="http://www.w3.org/2000/svg">
                    <g transform="translate(0, 12) rotate(-90)">
                      <path d="M10.209 0.75C8.04499 1.46676 4.61861 7.91763 4.61861 16.5188C4.61861 23.3997 7.04987 28.8232 8.07177 30.3165C6.08808 28.2259 1.5529 23.4714 0.831561 24.0448C-0.0701171 24.7616 6.78264 31.75 7.68432 31.75C8.58599 31.75 7.14329 26.5535 10.75 20.9986" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </g>
                  </svg>
                  <svg class="gs-arrow__svg gs-arrow__svg--mobile" viewBox="-1 0 13 33" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10.209 0.75C8.04499 1.46676 4.61861 7.91763 4.61861 16.5188C4.61861 23.3997 7.04987 28.8232 8.07177 30.3165C6.08808 28.2259 1.5529 23.4714 0.831561 24.0448C-0.0701171 24.7616 6.78264 31.75 7.68432 31.75C8.58599 31.75 7.14329 26.5535 10.75 20.9986" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_cta -%}
        <div class="gs-cta-wrap">
          <a href="{{ section.settings.cta_link | default: '#' }}" class="gs-cta">
            {{ section.settings.cta_text }}
          </a>
        </div>
      {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Getting started steps",
  "tag": "section",
  "class": "gs-wrapper",
  "enabled_on": { "templates": ["*"] },
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you'll need" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#fcfbf4" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#160000" },
    { "type": "color", "id": "arrow_color", "label": "Arrow color", "default": "#160000" },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 120, "step": 4, "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 120, "step": 4, "default": 24 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Section heading size (px, desktop)", "min": 24, "max": 96, "step": 2, "default": 48 },
    { "type": "select", "id": "heading_font", "label": "Section heading font", "options": [
      { "value": "Kento-Bold", "label": "Kento Bold" },
      { "value": "Kento-Regular", "label": "Kento Regular" },
      { "value": "Kento-Light", "label": "Kento Light" },
      { "value": "BaiJamjuree-Bold", "label": "Bai Jamjuree Bold" },
      { "value": "BaiJamjuree-SemiBold", "label": "Bai Jamjuree SemiBold" },
      { "value": "BaiJamjuree-Medium", "label": "Bai Jamjuree Medium" },
      { "value": "BaiJamjuree-Regular", "label": "Bai Jamjuree Regular" },
      { "value": "BaiJamjuree-Light", "label": "Bai Jamjuree Light" },
      { "value": "BaiJamjuree-ExtraLight", "label": "Bai Jamjuree ExtraLight" }
    ], "default": "Kento-Bold" },
    { "type": "range", "id": "step_heading_size", "label": "Step heading size (px)", "min": 14, "max": 36, "step": 1, "default": 20 },
    { "type": "select", "id": "step_heading_font", "label": "Step heading font", "options": [
      { "value": "Kento-Bold", "label": "Kento Bold" },
      { "value": "Kento-Regular", "label": "Kento Regular" },
      { "value": "Kento-Light", "label": "Kento Light" },
      { "value": "BaiJamjuree-Bold", "label": "Bai Jamjuree Bold" },
      { "value": "BaiJamjuree-SemiBold", "label": "Bai Jamjuree SemiBold" },
      { "value": "BaiJamjuree-Medium", "label": "Bai Jamjuree Medium" },
      { "value": "BaiJamjuree-Regular", "label": "Bai Jamjuree Regular" },
      { "value": "BaiJamjuree-Light", "label": "Bai Jamjuree Light" },
      { "value": "BaiJamjuree-ExtraLight", "label": "Bai Jamjuree ExtraLight" }
    ], "default": "BaiJamjuree-SemiBold" },
    { "type": "range", "id": "step_desc_size", "label": "Step description size (px)", "min": 12, "max": 22, "step": 1, "default": 15 },
    { "type": "select", "id": "step_desc_font", "label": "Step description font", "options": [
      { "value": "BaiJamjuree-Bold", "label": "Bai Jamjuree Bold" },
      { "value": "BaiJamjuree-SemiBold", "label": "Bai Jamjuree SemiBold" },
      { "value": "BaiJamjuree-Medium", "label": "Bai Jamjuree Medium" },
      { "value": "BaiJamjuree-Regular", "label": "Bai Jamjuree Regular" },
      { "value": "BaiJamjuree-Light", "label": "Bai Jamjuree Light" },
      { "value": "BaiJamjuree-ExtraLight", "label": "Bai Jamjuree ExtraLight" }
    ], "default": "BaiJamjuree-Regular" },

    { "type": "header", "content": "Step images" },
    { "type": "range", "id": "image_size_mobile", "label": "Image max width on mobile (px)", "min": 60, "max": 220, "step": 4, "default": 140 },
    { "type": "range", "id": "image_size_desktop", "label": "Image max width on desktop (px)", "min": 80, "max": 360, "step": 4, "default": 200 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius (px)", "min": 0, "max": 80, "step": 2, "default": 0 },

    { "type": "header", "content": "Call to action" },
    { "type": "checkbox", "id": "show_cta", "label": "Show 'Get started' button", "default": true },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Get started" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "cta_bg_color", "label": "Button background", "default": "#160000" },
    { "type": "color", "id": "cta_text_color", "label": "Button text color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Step image" },
        { "type": "text", "id": "heading", "label": "Step heading", "default": "Step heading" },
        { "type": "richtext", "id": "description", "label": "Step description", "default": "<p>Short description of this step.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Getting started steps",
      "blocks": [
        { "type": "step", "settings": {
          "heading": "Select diffuser",
          "description": "<p>From a cozy nook to your morning commute, we've got a diffuser for it.</p>"
        }},
        { "type": "step", "settings": {
          "heading": "Choose fragrances",
          "description": "<p>Find your favorites with over 300 premium scents in the Marketplace.</p>"
        }},
        { "type": "step", "settings": {
          "heading": "Download the app",
          "description": "<p>Customize intensity, switch between fragrances, and set schedules and timers.</p>"
        }}
      ]
    }
  ]
}
{% endschema %}
