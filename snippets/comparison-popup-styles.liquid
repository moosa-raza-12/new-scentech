  }

  .cmp-scent-modal__description {
    color: #160000;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 140%;
  }

  .cmp-scent-modal__details {
    padding: 16px 20px 24px;
  }

  .cmp-scent-modal__details h3 {
