{% liquid
  assign accordion_id = 'lp-diffuser-accordion-' | append: section.id
%}

<div class="lp-diffuser-accordion">
  <button
    class="lp-diffuser-accordion__trigger"
    type="button"
    aria-expanded="false"
    aria-controls="{{ accordion_id }}">
    <div class="lp-diffuser-accordion__heading-wrap">

      <span class="lp-diffuser-accordion__heading">
        {{ section.settings.closed_heading }}
      </span>

      <span class="lp-diffuser-accordion__subtext">
        {{ section.settings.closed_subtext }}
      </span>
    </div>
    <div class="lp-diffuser-accordion__icon">
      <span class="accordion__icon-close">{{ section.settings.close_icon_svg }}</span>
      <span class="accordion__icon-open" style="display: none;">{{ section.settings.open_icon_svg }}</span>

    </div>
  </button>

  <div id="{{ accordion_id }}" class="lp-diffuser-accordion__content">
    <div class="lp-diffuser-accordion__inner">
      <div class="cds-list">
        {% liquid
          assign cds_list_block_types = 'diffuser_limited_time' | split: '|'
        %}
        {% for block in section.blocks %}
          {% if cds_list_block_types contains block.type %}
            {% render 'df-limited-offer-cds-card'
              , block: block
              , section: section %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
  .lp-diffuser-accordion {
    width: 100%;
    max-width: 960px;
    margin: auto;
  }

  @media (min-width: 749px) {
    .lp-diffuser-accordion__trigger {

      padding: 4px 4px 4px 20px;
    }
  }

  .lp-diffuser-accordion__trigger {

    width: 100%;
    border-radius: 8px;
    border: 1px dashed rgba(22, 0, 0, 0.10);
    background: {{ section.settings.background_color }};

    padding: {{ section.settings.padding_vertical }}px{{ section.settings.padding_horizontal }}px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;

    cursor: pointer;
    transition: all 0.3s ease;
  }
  .cds-card-innerss {
    background-color: #F8F7F4;
    backdrop-filter: blur(2px);
  }
  .lp-diffuser-accordion__trigger:hover {
    background: {{ section.settings.hover_background_color }};
  }

  .lp-diffuser-accordion__heading-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* gap: 4px; */
    text-align: left;
  }
  .accordion__icon-open,
  .accordion__icon-close {
    line-height: 0;
  }
  .icon-wraper {
    display: flex;
    width: 28px;
    height: 28px;
    padding: 12px 20px;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
  }
  .lp-diffuser-accordion__heading {
    color: {{ section.settings.heading_color-id }};
    font-size: 12px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1;
  }

  .lp-diffuser-accordion__subtext {
    color: {{ section.settings.subtext_color-id }};
    font-size: {{ section.settings.subtext_size }}px;
    line-height: 1.4;
  }

  .lp-diffuser-accordion__icon {
    display: flex;
    width: 28px;
    height: 28px;
    /* padding: 12px 20px; */
    justify-content: center;
    align-items: center;
    border-radius: 6px;
    background: {{ section.settings.icon_background }};
    color: {{ section.settings.icon_color }};
    font-size: {{ section.settings.icon_font_size }}px;
    font-weight: 600;
  }

  .lp-diffuser-accordion__content {
    display: none;
    max-height: 0;
    overflow: hidden;
    padding: 4px 4px 4px 20px;
    transition: max-height 0.35s ease;
    border-radius: 8px;
    background: #FFF;
    border: 1px solid rgba(22, 0, 0, 0.10);
    border-top: none;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  .lp-diffuser-accordion__inner {
    padding-top: 16px;

    color: {{ section.settings.content_color }};
    font-size: {{ section.settings.content_size }}px;
    line-height: 1.6;
  }

  .lp-diffuser-accordion.active .lp-diffuser-accordion__trigger {
    border-style: solid;
    border-bottom: none;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordion = document.querySelector('.lp-diffuser-accordion');
  
    if (!accordion) return;
    const closeIcon = accordion.querySelector('.accordion__icon-close');
  const openIcon = accordion.querySelector('.accordion__icon-open');
  
  
    const trigger = accordion.querySelector('.lp-diffuser-accordion__trigger');
    const content = accordion.querySelector('.lp-diffuser-accordion__content');
    const heading = accordion.querySelector('.lp-diffuser-accordion__heading');
    const subtext = accordion.querySelector('.lp-diffuser-accordion__subtext');
    const icon = accordion.querySelector('.lp-diffuser-accordion__icon');
  
    const closedHeading = `{{ section.settings.closed_heading | escape }}`;
    const openHeading = `{{ section.settings.open_heading | escape }}`;
  
    const closedSubtext = `{{ section.settings.closed_subtext | escape }}`;
    const openSubtext = `{{ section.settings.open_subtext | escape }}`;
  
    trigger.addEventListener('click', () => {
      const isOpen = accordion.classList.contains('active');
  
      accordion.classList.toggle('active');
      
      if (isOpen) {
        content.style.maxHeight = null;
        content.style.display = 'none';
        trigger.setAttribute('aria-expanded', 'false');
  
        heading.textContent = closedHeading;
        subtext.textContent = closedSubtext;
  
        
      } else {
        content.style.maxHeight = 'fit-content';
        content.style.display = 'block';
  
        trigger.setAttribute('aria-expanded', 'true');
  
        heading.textContent = openHeading;
        subtext.textContent = openSubtext;
      }
      if (isOpen) {
  closeIcon.style.display = 'block';
  openIcon.style.display = 'none';
  
  } else {
  closeIcon.style.display = 'none';
  openIcon.style.display = 'block';
  
  }
    });
  });
</script>