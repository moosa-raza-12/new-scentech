<cart-drawer {% if request.design_mode %}handle-section-events{% endif %} class="cart-drawer drawer drawer--lg" id="cart-drawer">
  {%- if cart.item_count == 0 -%}
    {%- comment -%}-- EMPTY CART STATE --{%- endcomment -%}
    <div class="cart-empty">
      {%- comment -%}-- Header --{%- endcomment -%}
      <div class="cart-empty__header">
        <div class="cart-empty__header-left">
          <span class="cart-empty__header-title">{{ section.settings.empty_header_text }}</span>
          <cart-count class="count-bubble count-bubble--lg cart-empty__count">{{ cart.item_count }}</cart-count>
        </div>
        <button is="close-button" class="cart-empty__close" aria-label="{{ 'general.accessibility.close' | t | escape }}">
          {%- render 'icon' with 'close' -%}
        </button>
      </div>

      {%- comment -%}-- Scrollable body --{%- endcomment -%}
      <div class="cart-empty__body">
        {%- comment -%}-- Title & description --{%- endcomment -%}
        <div class="cart-empty__intro">
          {%- if section.settings.empty_title != blank -%}
            <div class="cart-empty__title">{{ section.settings.empty_title }}</div>
          {%- endif -%}
          {%- if section.settings.empty_description != blank -%}
            <p class="cart-empty__description">{{ section.settings.empty_description }}</p>
          {%- endif -%}
        </div>

        {%- comment -%}-- Two category cards --{%- endcomment -%}
        <div class="cart-empty__cards">
          {%- comment -%}-- Card 1 --{%- endcomment -%}
          <div class="cart-empty__card" {% if section.settings.empty_card_1_bg_color != blank %}style="background-color: {{ section.settings.empty_card_1_bg_color }};"{% endif %}>
            {%- if section.settings.empty_card_1_image != blank -%}
              <div class="cart-empty__card-image">
                {{ section.settings.empty_card_1_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'cart-empty__card-img' }}
              </div>
            {%- endif -%}
            <div class="cart-empty__card-body">
              {%- if section.settings.empty_card_1_title != blank -%}
                <h3 class="cart-empty__card-title">{{ section.settings.empty_card_1_title }}</h3>
              {%- endif -%}
              {%- if section.settings.empty_card_1_description != blank -%}
                <p class="cart-empty__card-desc">{{ section.settings.empty_card_1_description }}</p>
              {%- endif -%}
              {%- if section.settings.empty_card_1_button_text != blank -%}
                <a href="{{ section.settings.empty_card_1_button_url }}" class="cart-empty__card-btn">
                  {{ section.settings.empty_card_1_button_text }}
                </a>
              {%- endif -%}
            </div>
          </div>

          {%- comment -%}-- Card 2 --{%- endcomment -%}
          <div class="cart-empty__card" {% if section.settings.empty_card_2_bg_color != blank %}style="background-color: {{ section.settings.empty_card_2_bg_color }};"{% endif %}>
            {%- if section.settings.empty_card_2_image != blank -%}
              <div class="cart-empty__card-image">
                {{ section.settings.empty_card_2_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'cart-empty__card-img' }}
              </div>
            {%- endif -%}
            <div class="cart-empty__card-body">
              {%- if section.settings.empty_card_2_title != blank -%}
                <h3 class="cart-empty__card-title">{{ section.settings.empty_card_2_title }}</h3>
              {%- endif -%}
              {%- if section.settings.empty_card_2_description != blank -%}
                <p class="cart-empty__card-desc">{{ section.settings.empty_card_2_description }}</p>
              {%- endif -%}
              {%- if section.settings.empty_card_2_button_text != blank -%}
                <a href="{{ section.settings.empty_card_2_button_url }}" class="cart-empty__card-btn">
                  {{ section.settings.empty_card_2_button_text }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

      {%- comment -%}-- Bottom CTA --{%- endcomment -%}
      {%- if section.settings.empty_bottom_button_text != blank -%}
        <div class="cart-empty__footer">
          <a href="{{ section.settings.empty_bottom_button_url }}" class="cart-empty__footer-btn">
            {{ section.settings.empty_bottom_button_text }}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.167 10h11.666M10.833 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- comment -%}-- FILLED CART STATE --{%- endcomment -%}
    {%- comment -%}
      IMPORTANT: .cart-drawer__inner is required for the theme JS _onCartChanged() to find and
      replace the inner HTML on AJAX cart updates. Do NOT remove it.
    {%- endcomment -%}
    <div class="cart-drawer__inner kv-cart">
      {%- comment -%}-- Header --{%- endcomment -%}
      <div class="kv-cart__header">
        <div class="kv-cart__header-left">
          <span class="kv-cart__header-title">{{ section.settings.empty_header_text }}</span>
          <cart-count class="kv-cart__count">{{ cart.item_count }}</cart-count>
        </div>
        <button is="close-button" class="kv-cart__close" aria-label="{{ 'general.accessibility.close' | t | escape }}">
          {%- render 'icon' with 'close' -%}
        </button>
      </div>

      {%- comment -%}-- Free shipping bar --{%- endcomment -%}
      {%- if settings.cart_show_free_shipping_threshold -%}
        <div class="kv-cart__shipping-bar">
          {%- render 'kv-free-shipping-bar', kv_threshold: section.settings.kv_shipping_threshold, kv_unreached_text: section.settings.kv_shipping_unreached_text, kv_reached_text: section.settings.kv_shipping_reached_text, kv_reached_gifts_text: section.settings.kv_shipping_reached_gifts_text -%}
        </div>
      {%- endif -%}

      {%- comment -%}-- Categorized line items --{%- endcomment -%}
      <div class="kv-cart__items">
        {%- liquid
          assign kv_categories = ''
          assign kv_has_free_gifts = false
          for line_item in cart.items
            if line_item.final_price == 0
              assign kv_cat = section.settings.free_gifts_category_text
              assign kv_has_free_gifts = true
            else
              assign kv_cat = line_item.product.metafields.custom.minicart_product_category | strip | default: 'Other'
            endif
            assign kv_cat_check = '|||' | append: kv_cat | append: '|||'
            assign kv_categories_check = '|||' | append: kv_categories | append: '|||'
            unless kv_categories_check contains kv_cat_check
              if kv_categories != ''
                assign kv_categories = kv_categories | append: '|||'
              endif
              assign kv_categories = kv_categories | append: kv_cat
            endunless
          endfor

          assign kv_category_list_raw = kv_categories | split: '|||'
          assign kv_sorted_categories = ''
          for cat in kv_category_list_raw
            if cat == section.settings.free_gifts_category_text
            elsif cat == 'Scents'
            else
              if kv_sorted_categories != ''
                assign kv_sorted_categories = kv_sorted_categories | append: '|||'
              endif
              assign kv_sorted_categories = kv_sorted_categories | append: cat
            endif
          endfor
          assign kv_has_scents = false
          for cat in kv_category_list_raw
            if cat == 'Scents'
              assign kv_has_scents = true
              break
            endif
          endfor
          assign kv_final = ''
          if kv_has_free_gifts
            assign kv_final = section.settings.free_gifts_category_text
          endif
          if kv_has_scents
            if kv_final != ''
              assign kv_final = kv_final | append: '|||'
            endif
            assign kv_final = kv_final | append: 'Scents'
          endif
          if kv_sorted_categories != ''
            if kv_final != ''
              assign kv_final = kv_final | append: '|||'
            endif
            assign kv_final = kv_final | append: kv_sorted_categories
          endif
          assign kv_category_list = kv_final | split: '|||'
        -%}

        {%- for category in kv_category_list -%}
          <details class="kv-cart__accordion" open>
            <summary class="kv-cart__accordion-header">
              <span class="kv-cart__accordion-title">{{ category }}</span>
              {% comment %} <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg> {% endcomment %}
              <svg  class="kv-cart__accordion-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <g opacity="0.2">
                  <path d="M13 6L8 11L3 6" stroke="#160000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </g>
              </svg>
            </summary>

            <div class="kv-cart__accordion-body">
              {%- for line_item in cart.items -%}
                {%- if line_item.final_price == 0 -%}
                  {%- assign item_cat = section.settings.free_gifts_category_text -%}
                {%- else -%}
                  {%- assign item_cat = line_item.product.metafields.custom.minicart_product_category | strip | default: 'Other' -%}
                {%- endif -%}
                {%- if item_cat == category -%}
                  {%- if line_item.product.metafields.custom.inventory_stock_date != blank -%}
                    {%- assign stock_date_epoch = line_item.product.metafields.custom.inventory_stock_date | date: '%s' | plus: 0 -%}
                    {%- assign today_epoch = 'now' | date: '%Y-%m-%d' | date: '%s' | plus: 0 -%}
                    {%- if stock_date_epoch >= today_epoch -%}
                      <div class="kv-cart__stock-date-notice">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M7 14C6.04 14 5.13 13.82 4.28 13.46C3.44 13.1 2.7 12.59 2.06 11.95C1.41 11.31 0.91 10.56 0.54 9.71C0.18 8.87 0 7.96 0 7C0 6.04 0.18 5.13 0.54 4.29C0.91 3.44 1.41 2.69 2.06 2.05C2.7 1.41 3.44 0.9 4.28 0.54C5.13 0.18 6.04 0 7 0C7.96 0 8.87 0.18 9.71 0.54C10.56 0.9 11.3 1.41 11.94 2.05C12.59 2.69 13.08 3.44 13.45 4.29C13.82 5.13 14 6.04 14 7C14 7.96 13.82 8.87 13.45 9.71C13.08 10.56 12.59 11.31 11.94 11.95C11.3 12.59 10.56 13.1 9.71 13.46C8.87 13.82 7.96 14 7 14ZM6.35 10.5H8.18V8.67H6.35V10.5ZM6.35 7.58H8.18V3.5H6.35V7.58Z" fill="#924B14"/>
                        </svg>
                        <span>The {{ line_item.product.title }} is on Pre-Order. Delivers on {{ line_item.product.metafields.custom.inventory_stock_date | date: "%b %e" }}.</span>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                  <line-item class="kv-cart__line-item">
                    {%- if line_item.image != blank -%}
                      <div class="kv-cart__line-item-media">
                        {{- line_item.image | image_url: width: line_item.image.width | image_tag: loading: 'lazy', sizes: '(max-width: 740px) 56px, 64px', widths: '56,64,112,128', class: 'kv-cart__line-item-img' -}}
                        {%- if line_item.final_price == 0 and line_item.quantity > 0 -%}
                          <span class="kv-cart__gift-qty-badge">{{ line_item.quantity }}</span>
                        {%- endif -%}
                        <pill-loader class="pill-loader"></pill-loader>
                      </div>
                    {%- endif -%}

                    <div class="kv-cart__line-item-info">
                      <div class="kv-cart__line-item-name-row">
                        {%- if line_item.url != blank -%}
                          <a href="{{ line_item.url }}" class="kv-cart__line-item-name">{{ line_item.product.title | default: line_item.title }}</a>
                        {%- else -%}
                          <span class="kv-cart__line-item-name">{{ line_item.product.title | default: line_item.title }}</span>
                        {%- endif -%}
                        {%- if line_item.product.metafields.custom.scent_popup_description != blank or line_item.product.metafields.custom.scent_details != blank -%}
                          <button class="kv-cart__line-item-info-icon kv-scent-info-btn"
                            type="button"
                            aria-label="View details"
                            data-product-id="{{ line_item.product.id }}"
                            data-product-title="{{ line_item.product.title | escape }}"
                            data-product-description="{{ line_item.product.metafields.custom.scent_popup_description | default: line_item.product.description | strip_html | strip | escape }}"
                            data-product-details="{{ line_item.product.metafields.custom.scent_details | escape }}"
                            data-product-image="{% if line_item.product.metafields.custom.scent_image %}{{ line_item.product.metafields.custom.scent_image | image_url: width: 1200 }}{% elsif line_item.product.featured_image %}{{ line_item.product.featured_image | image_url: width: 1200 }}{% endif %}"
                            data-product-variant="{{ line_item.product.metafields.custom.quantity_value | default: line_item.variant.title | escape }}"
                            data-product-badge="{{ line_item.product.metafields.custom.collection_card_badge | escape }}">
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M7 13.125C10.3827 13.125 13.125 10.3827 13.125 7C13.125 3.61726 10.3827 0.875 7 0.875C3.61726 0.875 0.875 3.61726 0.875 7C0.875 10.3827 3.61726 13.125 7 13.125Z" stroke="#160000" stroke-width="0.875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                              <path d="M6.99121 4.375C6.99121 4.375 6.99317 4.375 6.99559 4.375C6.998 4.375 6.99996 4.375 6.99996 4.375" stroke="#160000" stroke-width="0.875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                              <path d="M7 6.125V9.625" stroke="#160000" stroke-width="0.875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>
                        {%- endif -%}
                      </div>

                      {%- if line_item.final_price == 0 -%}
                        {%- if line_item.variant.compare_at_price and line_item.variant.compare_at_price > 0 -%}
                          <span class="kv-cart__line-item-worth">({{ section.settings.worth_text }} {{ line_item.variant.compare_at_price | money }})</span>
                        {%- elsif line_item.original_price > 0 -%}
                          <span class="kv-cart__line-item-worth">({{ section.settings.worth_text }} {{ line_item.original_price | money }})</span>
                        {%- endif -%}
                      {%- else -%}
                         {%- if line_item.original_price > line_item.final_price -%}
                          <span class="kv-cart__line-item-price">
                            <s class="kv-cart__line-item-original-price">{{ line_item.original_price | money }}</s>
                            {{ line_item.final_price | money }}
                          </span>
                        {%- else -%}
                          <span class="kv-cart__line-item-price">{{ line_item.final_price | money }}</span>
                        {%- endif -%}
                      {%- endif -%}

                      {%- unless line_item.product.has_only_default_variant or line_item.gift_card -%}
                        <span class="kv-cart__line-item-variant">{{ line_item.variant.title }}</span>
                      {%- endunless -%}

                      {%- if line_item.selling_plan_allocation -%}
                        <span class="kv-cart__line-item-variant">{{ line_item.selling_plan_allocation.selling_plan.name }}</span>
                      {%- endif -%}

                      {%- if line_item.product.metafields.custom.minicart_info_text != blank -%}
                        <div class="kv-cart__line-item-notice">
                          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7 14C6.04 14 5.13 13.82 4.28 13.46C3.44 13.1 2.7 12.59 2.06 11.95C1.41 11.31 0.91 10.56 0.54 9.71C0.18 8.87 0 7.96 0 7C0 6.04 0.18 5.13 0.54 4.29C0.91 3.44 1.41 2.69 2.06 2.05C2.7 1.41 3.44 0.9 4.28 0.54C5.13 0.18 6.04 0 7 0C7.96 0 8.87 0.18 9.71 0.54C10.56 0.9 11.3 1.41 11.94 2.05C12.59 2.69 13.08 3.44 13.45 4.29C13.82 5.13 14 6.04 14 7C14 7.96 13.82 8.87 13.45 9.71C13.08 10.56 12.59 11.31 11.94 11.95C11.3 12.59 10.56 13.1 9.71 13.46C8.87 13.82 7.96 14 7 14ZM6.35 10.5H8.18V8.67H6.35V10.5ZM6.35 7.58H8.18V3.5H6.35V7.58Z" fill="#924B14"/>
                          </svg>
                          <span>{{ line_item.product.metafields.custom.minicart_info_text }}</span>
                        </div>
                      {%- endif -%}

                      {%- if line_item.line_level_discount_allocations != blank -%}
                        <ul class="kv-cart__line-item-discounts">
                          {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                            <li class="kv-cart__discount-badge">
                              {%- render 'icon' with 'discount' -%} {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>

                    <div class="kv-cart__line-item-actions">
                      {%- if line_item.final_price == 0 -%}
                        <span class="kv-cart__gift-badge">{{ section.settings.free_gift_badge_text }}</span>
                      {%- else -%}
                        <line-item-quantity class="kv-cart__qty-wrap">
                          <button type="button" class="kv-cart__qty-btn" data-kv-qty-action="decrease" aria-label="{{ 'cart.order.change_quantity' | t | escape }}">−</button>
                          <input class="kv-cart__qty-input" type="text" is="quantity-input" inputmode="numeric" {% if line_item.variant.inventory_management != blank and line_item.variant.inventory_policy == 'deny' %}max="{{ line_item.variant.inventory_quantity }}"{% endif %} data-line-key="{{ line_item.key }}" aria-label="{{ 'cart.order.change_quantity' | t | escape }}" value="{{ line_item.quantity }}">
                          <button type="button" class="kv-cart__qty-btn" data-kv-qty-action="increase" aria-label="{{ 'cart.order.change_quantity' | t | escape }}">+</button>
                        </line-item-quantity>
                      {%- endif -%}
                    </div>
                  </line-item>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </details>
        {%- endfor -%}

        {%- comment -%}-- Add Something Extra (custom slider via blocks) --{%- endcomment -%}
        {%- capture extra_cards -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'extra_product' -%}
              {%- assign ep = block.settings.product -%}
              {%- if ep != blank and ep.available -%}
                {%- assign already_in_cart = false -%}
                {%- for line_item in cart.items -%}
                  {%- if line_item.product.id == ep.id -%}
                    {%- assign already_in_cart = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless already_in_cart -%}
                  {%- assign ep_variant = ep.selected_or_first_available_variant -%}
                  <div class="kv-extra__card" {{ block.shopify_attributes }}>
                    <div class="kv-extra__card-img-wrap">
                      {%- if ep.featured_image != blank -%}
                        {{ ep.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'kv-extra__card-img' }}
                      {%- endif -%}
                    </div>
                    <div class="kv-extra__card-body">
                      <div class="kv-extra__card-name-row">
                        <span class="kv-extra__card-name">{{ ep.title }}</span>
                        {%- if block.settings.show_info_icon -%}
                          {%- if ep.metafields.custom.scent_popup_description != blank or ep.metafields.custom.scent_details != blank -%}
                            <button class="kv-extra__card-info kv-scent-info-btn"
                              type="button"
                              aria-label="View details"
                              data-product-id="{{ ep.id }}"
                              data-product-title="{{ ep.title | escape }}"
                              data-product-description="{{ ep.metafields.custom.scent_popup_description | default: ep.description | strip_html | strip | escape }}"
                              data-product-details="{{ ep.metafields.custom.scent_details | escape }}"
                              data-product-image="{% if ep.metafields.custom.scent_image %}{{ ep.metafields.custom.scent_image | image_url: width: 1200 }}{% elsif ep.featured_image %}{{ ep.featured_image | image_url: width: 1200 }}{% endif %}"
                              data-product-variant="{{ ep.metafields.custom.quantity_value | default: ep_variant.title | escape }}"
                              data-product-badge="{{ ep.metafields.custom.collection_card_badge | escape }}">
                              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M7 13.125C10.3827 13.125 13.125 10.3827 13.125 7C13.125 3.61726 10.3827 0.875 7 0.875C3.61726 0.875 0.875 3.61726 0.875 7C0.875 10.3827 3.61726 13.125 7 13.125Z" stroke="#160000" stroke-width="0.875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M6.99121 4.375C6.99121 4.375 6.99317 4.375 6.99559 4.375C6.998 4.375 6.99996 4.375 6.99996 4.375" stroke="#160000" stroke-width="0.875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M7 6.125V9.625" stroke="#160000" stroke-width="0.875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </button>
                          {%- else -%}
                            <a href="{{ ep.url }}" class="kv-extra__card-info" aria-label="More info about {{ ep.title | escape }}">
                              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8" cy="8" r="7.25" stroke="#999" stroke-width="1.5"/><path d="M7.25 7H8.75V11.5" stroke="#999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="8" cy="4.75" r="0.75" fill="#999"/></svg>
                            </a>
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                      <span class="kv-extra__card-price">{{ ep_variant.price | money }}</span>
                    </div>
                    <form method="post" action="/cart/add" class="kv-extra__card-form">
                      <input type="hidden" name="id" value="{{ ep_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="kv-extra__card-add-btn" {% unless ep_variant.available %}disabled{% endunless %}>
                        {%- if ep_variant.available -%}
                          {{ section.settings.extra_add_button_text | default: '+ Add' }}
                        {%- else -%}
                          {{ section.settings.extra_sold_out_text | default: 'Sold out' }}
                        {%- endif -%}
                      </button>
                    </form>
                  </div>
                {%- endunless -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if extra_cards != blank -%}
          <div class="kv-extra">
            <div class="kv-extra__header">
              <span class="kv-extra__title">{{ section.settings.extra_slider_title | default: 'Add Something Extra' }}</span>
            </div>
            <div class="kv-extra__swiper swiper">
              <div class="kv-extra__track swiper-wrapper">
                {{ extra_cards }}
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}
      IMPORTANT: slot="footer" is required for the theme JS _onCartChanged() to find and
      replace the footer on AJAX cart updates. Do NOT remove it.
    {%- endcomment -%}
    <div class="kv-cart__footer" slot="footer">
      <div class="kv-cart__footer-inner">
        {% for discount_application in cart.cart_level_discount_applications %}
          <div class="kv-cart__discount-row">
            <div class="kv-cart__discount-label">
              {%- render 'icon' with 'discount' -%} {{- discount_application.title -}}
            </div>
            <span class="kv-cart__discount-amount">-{{ discount_application.total_allocated_amount | money }}</span>
          </div>
        {% endfor %}

        {% if section.settings.kv_inventory_text != blank %}
          <div class="kv-cart__inventory-notice">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5.99694 12C5.17287 12 4.39776 11.8449 3.6716 11.5347C2.94952 11.2245 2.31311 10.7939 1.76237 10.2429C1.21163 9.69184 0.779194 9.05306 0.465069 8.32653C0.155023 7.6 0 6.82449 0 6C0 5.17551 0.155023 4.4 0.465069 3.67347C0.779194 2.94694 1.21163 2.30816 1.76237 1.75714C2.31311 1.20612 2.94952 0.77551 3.6716 0.465306C4.39776 0.155102 5.17287 0 5.99694 0C6.82101 0 7.59612 0.155102 8.32228 0.465306C9.04844 0.77551 9.68689 1.20612 10.2376 1.75714C10.7884 2.30816 11.2188 2.94694 11.5288 3.67347C11.8429 4.4 12 5.17551 12 6C12 6.82449 11.8429 7.6 11.5288 8.32653C11.2188 9.05306 10.7884 9.69184 10.2376 10.2429C9.68689 10.7939 9.04844 11.2245 8.32228 11.5347C7.59612 11.8449 6.82101 12 5.99694 12ZM4.86486 9.33673H7.39827C7.46762 9.33673 7.52269 9.31633 7.56349 9.27551C7.60428 9.23061 7.62468 9.17551 7.62468 9.1102C7.62468 9.05306 7.60428 9.00204 7.56349 8.95714C7.52269 8.91224 7.46762 8.8898 7.39827 8.8898H6.3641V5.02041C6.3641 4.94694 6.3437 4.88776 6.30291 4.84286C6.26211 4.79388 6.20296 4.76939 6.12545 4.76939H4.9077C4.84243 4.76939 4.78939 4.79184 4.7486 4.83673C4.7078 4.88163 4.6874 4.93469 4.6874 4.99592C4.6874 5.05306 4.7078 5.10408 4.7486 5.14898C4.78939 5.19388 4.84243 5.21633 4.9077 5.21633H5.90515V8.8898H4.86486C4.79959 8.8898 4.74452 8.91224 4.69964 8.95714C4.65885 9.00204 4.63845 9.05306 4.63845 9.1102C4.63845 9.17551 4.65885 9.23061 4.69964 9.27551C4.74452 9.31633 4.79959 9.33673 4.86486 9.33673ZM5.9847 3.50816C6.12749 3.50816 6.24783 3.46122 6.34574 3.36735C6.44365 3.26939 6.49261 3.15102 6.49261 3.01224C6.49261 2.86939 6.44365 2.74898 6.34574 2.65102C6.24783 2.54898 6.12749 2.49796 5.9847 2.49796C5.846 2.49796 5.72565 2.54898 5.62366 2.65102C5.52575 2.74898 5.4768 2.86939 5.4768 3.01224C5.4768 3.15102 5.52575 3.26939 5.62366 3.36735C5.72565 3.46122 5.846 3.50816 5.9847 3.50816Z" fill="#924B14"/>
            </svg>
            {{ section.settings.kv_inventory_text }}
          </div>
        {% endif %}

        {%- if section.settings.show_shipping_text -%}
          <div class="kv-cart__shipping-text">
            {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
              <p>{{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}</p>
            {%- elsif cart.taxes_included -%}
              <p>{{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}</p>
            {%- elsif shop.shipping_policy.body != blank -%}
              <p>{{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}</p>
            {%- else -%}
              <p>{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_protection -%}
        {%- assign protection_price_cents = section.settings.protection_price | times: 100 -%}
        {%- assign low_cart_price_cents = section.settings.low_cart_product_price | times: 100 -%}
        {%- assign kv_low_cart_threshold_cents = section.settings.low_cart_threshold | default: 50 | times: 100 -%}
        
        {%- comment -%}Determine which protection to show based on cart total{%- endcomment -%}
        {%- if cart.total_price < kv_low_cart_threshold_cents and section.settings.low_cart_product != blank -%}
          {%- assign active_protection_title = section.settings.low_cart_product_title -%}
          {%- assign active_protection_desc = section.settings.low_cart_product_description -%}
          {%- assign active_protection_price = low_cart_price_cents -%}
        {%- else -%}
          {%- assign active_protection_title = section.settings.protection_title -%}
          {%- assign active_protection_desc = section.settings.protection_description -%}
          {%- assign active_protection_price = protection_price_cents -%}
        {%- endif -%}
        
        <div class="kv-cart__protection" id="kv-cart-protection">
          <label class="kv-cart__protection-toggle" for="kv-protection-checkbox">
            <div class="kv-cart__protection-header">
              <div class="kv-cart__protection-header-left">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M14.3647 2.59081L8.23966 0.0477773C8.08622 -0.0159102 7.91375 -0.0159414 7.76034 0.0477773L1.63534 2.59081C1.40206 2.68768 1.25 2.91543 1.25 3.16803V6.25943C1.25 10.5161 3.82278 14.3451 7.76381 15.9537C7.91519 16.0154 8.08478 16.0154 8.23619 15.9537C12.1772 14.3451 14.75 10.5161 14.75 6.25943V3.16803C14.75 2.91543 14.598 2.68768 14.3647 2.59081ZM13.5 6.25943C13.5 9.87803 11.375 13.2092 8 14.6961C4.71519 13.2489 2.5 9.97609 2.5 6.25943V3.58528L8 1.30171L13.5 3.58528V6.25943ZM7.30919 8.36612L9.99556 5.67978C10.2396 5.43571 10.6353 5.43568 10.8794 5.67978C11.1235 5.92387 11.1235 6.31959 10.8794 6.56365L7.75112 9.69193C7.507 9.93606 7.11128 9.93596 6.86725 9.69193L5.12056 7.94525C4.87647 7.70115 4.87647 7.30543 5.12056 7.06137C5.36466 6.81731 5.76038 6.81728 6.00444 7.06137L7.30919 8.36612Z" fill="#160000"/>
                </svg>
                <span class="kv-cart__protection-title" id="kv-protection-title">{{ active_protection_title }}</span>
              </div>
              <span class="kv-cart__protection-price" id="kv-protection-price">{{ active_protection_price | money }}</span>
            </div>
            <p class="kv-cart__protection-desc" id="kv-protection-desc">{{ active_protection_desc }}</p>
            <input type="checkbox" id="kv-protection-checkbox" class="kv-cart__protection-checkbox" checked>
          </label>
        </div>
      {%- endif -%}

      {%- liquid
        assign kv_protection_variant_id = 53581603471706
        if section.settings.protection_product != blank
          assign kv_protection_variant_id = section.settings.protection_product.selected_or_first_available_variant.id
        endif
        
        assign kv_low_cart_variant_id = ''
        if section.settings.low_cart_product != blank
          assign kv_low_cart_variant_id = section.settings.low_cart_product.selected_or_first_available_variant.id
        endif
        
        assign kv_low_cart_threshold_cents = section.settings.low_cart_threshold | default: 50 | times: 100
        assign protection_price_cents = section.settings.protection_price | times: 100
        assign low_cart_price_cents = section.settings.low_cart_product_price | times: 100
      -%}
      <div class="kv-cart__checkout-buttons" 
           data-protection-variant-id="{{ kv_protection_variant_id }}"
           data-low-cart-variant-id="{{ kv_low_cart_variant_id }}"
           data-low-cart-threshold="{{ kv_low_cart_threshold_cents }}"
           data-protection-price="{{ protection_price_cents }}"
           data-low-cart-price="{{ low_cart_price_cents }}"
           data-protection-title="{{ section.settings.protection_title | escape }}"
           data-low-cart-title="{{ section.settings.low_cart_product_title | escape }}"
           data-protection-desc="{{ section.settings.protection_description | escape }}"
           data-low-cart-desc="{{ section.settings.low_cart_product_description | escape }}">
        {%- if section.settings.show_checkout_button -%}
          {%- comment -%}Calculate total with appropriate protection price{%- endcomment -%}
          {%- if cart.total_price < kv_low_cart_threshold_cents and section.settings.low_cart_product != blank -%}
            {%- assign total_with_protection = cart.total_price | plus: low_cart_price_cents -%}
            {%- assign original_total_with_protection = cart.original_total_price | plus: low_cart_price_cents -%}
          {%- else -%}
            {%- assign total_with_protection = cart.total_price | plus: protection_price_cents -%}
            {%- assign original_total_with_protection = cart.original_total_price | plus: protection_price_cents -%}
          {%- endif -%}
          
          <button type="button" class="kv-cart__checkout-btn kv-cart__checkout-btn--primary" id="kv-checkout-secure">
            <span>{{ section.settings.secure_checkout_text | default: 'Secure Checkout' }}</span>
            <span class="kv-cart__checkout-separator"><svg xmlns="http://www.w3.org/2000/svg" width="3" height="3" viewBox="0 0 3 3" fill="none"><path d="M0 3V0H3V3H0Z" fill="white"/></svg></span>
            <span class="kv-cart__checkout-prices">
              {%- if cart.total_discount > 0 -%}
                <span class="kv-cart__checkout-original-price" id="kv-original-price-with-protection">{{ original_total_with_protection | money }}</span>
              {%- endif -%}
              <span id="kv-price-with-protection">{{ total_with_protection | money }}</span>
            </span>
          </button>
        {%- endif -%}

        {%- if section.settings.show_protection -%}
          <button type="button" class="kv-cart__checkout-btn kv-cart__checkout-btn--secondary" id="kv-checkout-without">
            <span>{{ section.settings.without_protection_text | default: 'Checkout Without Protection' }}</span>
            <span class="kv-cart__checkout-separator"><svg xmlns="http://www.w3.org/2000/svg" width="3" height="3" viewBox="0 0 3 3" fill="none"><path d="M0 3V0H3V3H0Z" fill="currentColor"/></svg></span>
            <span class="kv-cart__checkout-prices">
              <span>{{ cart.total_price | money }}</span>
            </span>
          </button>
        {%- endif -%}
      </div>

      {%- liquid
        assign has_date_out_of_stock = false
        assign has_date_with_stock = false
        assign latest_stock_epoch = 0
        assign latest_stock_date_raw = ''
        assign preorder_items_list = ''
        assign today_epoch = 'now' | date: '%Y-%m-%d' | date: '%s' | plus: 0

        for line_item in cart.items
          assign item_inv_qty = line_item.variant.inventory_quantity | default: 0
          if item_inv_qty > 0
            assign has_date_with_stock = true
          endif
          if line_item.product.metafields.custom.inventory_stock_date != blank
            assign item_stock_epoch = line_item.product.metafields.custom.inventory_stock_date | date: '%s' | plus: 0
            if item_stock_epoch >= today_epoch
              if item_inv_qty <= 0
                assign has_date_out_of_stock = true
                if item_stock_epoch > latest_stock_epoch
                  assign latest_stock_epoch = item_stock_epoch
                  assign latest_stock_date_raw = line_item.product.metafields.custom.inventory_stock_date
                endif
                assign item_entry = line_item.quantity | append: 'x ' | append: line_item.product.title
                if preorder_items_list == ''
                  assign preorder_items_list = item_entry
                else
                  assign preorder_items_list = preorder_items_list | append: '|||' | append: item_entry
                endif
              endif
            endif
          endif
        endfor
      -%}

      {%- if has_date_out_of_stock -%}
        <div class="kv-cart__preorder-notice" data-preorder-stock-date="{{ latest_stock_date_raw }}">
          <div class="kv-cart__preorder-notice-row">
            <span class="kv-cart__preorder-notice-label">{{ section.settings.text_expected_delivery | default: "Expected delivery:" }}</span>
            <span class="kv-cart__preorder-notice-dates" id="kv-cart-preorder-dates"></span>
          </div>
          <div class="kv-cart__preorder-notice-info">
            <span class="kv-cart__preorder-collapsed">{{ section.settings.text_preorder_collapsed | default: "There are pre-order items in the cart." }} <a href="javascript:void(0)" class="kv-cart__preorder-toggle" data-action="expand">Read more</a></span>
            <span class="kv-cart__preorder-expanded" style="display: none;">{{ section.settings.text_preorder_expanded | default: "There are pre-order items in the cart. Due to this your order will be sent out slightly later, when the scents have reached our warehouse." }}<br><br>{{ section.settings.text_preorder_affected_label | default: "The affected products in your cart are:" }}
              {%- assign preorder_items_arr = preorder_items_list | split: '|||' -%}
              {%- for item in preorder_items_arr -%}
                <br><strong>{{ item }}</strong>
              {%- endfor -%}
              <br><br>{{ section.settings.text_preorder_contact | default: "For any questions or concerns please reach out to our team." }} <a href="javascript:void(0)" class="kv-cart__preorder-toggle" data-action="collapse">Read less</a>
            </span>
          </div>
        </div>
      {%- elsif has_date_with_stock -%}
        <div class="kv-cart__preorder-notice" id="kv-cart-instock-notice">
          <div class="kv-cart__preorder-notice-row">
            <span class="kv-cart__preorder-notice-label">{{ section.settings.text_expected_delivery | default: "Expected delivery:" }}</span>
            <span class="kv-cart__preorder-notice-dates" id="kv-cart-instock-dates"></span>
          </div>
          <div class="kv-cart__preorder-notice-info">
            <span class="kv-cart__preorder-collapsed">{{ section.settings.text_instock_collapsed | default: "Your order ships out today from the Netherlands." }} <a href="javascript:void(0)" class="kv-cart__preorder-toggle" data-action="expand">Read more</a></span>
            <span class="kv-cart__preorder-expanded" style="display: none;">{{ section.settings.text_instock_expanded | default: "Your order ships out today from the Netherlands. These items are in stock at our warehouse in Gorinchem and are shipped by our reliable delivery partners." }}<br><br>{{ section.settings.text_preorder_contact | default: "For any questions or concerns please reach out to our team." }} <a href="javascript:void(0)" class="kv-cart__preorder-toggle" data-action="collapse">Read less</a></span>
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</cart-drawer>

<!-- Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<style>
  .cart-drawer{
    --drawer-footer-padding:0px !important;
  }
  @media screen and (min-width: 700px) {
    .drawer--lg {
        width: 430px !important;
    }
  }
  .drawer{
    padding:0px !important;
  }
  .drawer::part(body){
    padding:0px !important;
  }

  /* ==============================
     EMPTY CART STATE
     ============================== */
  .cart-empty {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
  }

  /* -- Header -- */
  .cart-empty__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    align-self: stretch;
    padding: 7px 20px;
    height: 60px;
    border: 1px solid #e1dede;
  }
  .cart-empty__header-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cart-empty__header-title {
    color: #160000;
    font-family: "Bai Jamjuree";
    font-size: 16px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
  }
  .cart-empty__count {
    display: flex;
    width: 27px;
    height: 27px;
    /* padding: 6px 12px; */
    justify-content: center;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    opacity: 1 !important;
  }
  .cart-empty__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cart-empty__close svg {
    width: 20px;
    height: 20px;
  }

  /* -- Body (scrollable) -- */
  .cart-empty__body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 24px 20px 24px 20px;
  }

  /* -- Intro text -- */
  .cart-empty__intro {
    text-align: center;
    margin-bottom: 28px;
  }
  .cart-empty__title {
    color: #160000;
    font-family: "Bai Jamjuree";
    font-size: 24px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
    padding-bottom: 16px;
  }
  .cart-empty__description {
    color: #162518;
    text-align: center;
    font-family: "Bai Jamjuree";
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    max-width: 320px;
    margin: 0 auto;
    opacity: 0.6;
    padding-bottom: 24px;
  }

  /* -- Cards grid -- */
  .cart-empty__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .cart-empty__card {
    border-radius: 8px;
    overflow: hidden;
    background: #F9F6F3;
    backdrop-filter: blur(2px);
    display: flex;
    flex-direction: column;
  }
  .cart-empty__card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .cart-empty__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cart-empty__card-body {
    padding: 0 12px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .cart-empty__card-title {
    color: #160000;
    text-align: left;
    leading-trim: both;
    text-edge: cap;
    font-family: "Bai Jamjuree";
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    margin-top: 10px;
  }
  .cart-empty__card-desc {
    color: rgba(22, 0, 0, 0.80);
    leading-trim: both;
    text-edge: cap;
    font-family: "Bai Jamjuree";
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }
  .cart-empty__card-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 12px 16px;
    margin-top: 8px;
    border-radius: 6px;
    background: #160000;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: opacity 0.2s;
    font-family: "Bai Jamjuree";
    font-size: 14px;
    font-style: normal;
    line-height: normal;
  }
  .cart-empty__card-btn:hover {
    opacity: 0.85;
  }

  /* -- Footer CTA -- */
  .cart-empty__footer {
    padding: 20px;
    margin-top: auto;
    flex-shrink: 0;
    background: #F6F5F1;
  }
  .cart-empty__footer-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    width: 100%;
    padding: 16px 0;
    border-radius: 8px;
    background: #160000;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: opacity 0.2s;
  }
  .cart-empty__footer-btn:hover {
    opacity: 0.85;
  }
  .cart-empty__footer-btn svg {
    width: 23px;
    height: 24px;
    aspect-ratio: 16 / 13;
    flex-shrink: 0;
  }

  /* ==============================
     FILLED CART STATE
     ============================== */
  .kv-cart {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    min-width: 0;
    overflow: hidden;
  }

  /* -- Header -- */
  .kv-cart__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 7px 20px;
    border-bottom: 1px solid #e1dede;
    height: 60px;
  }
  .kv-cart__header-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .kv-cart__header-title {
    color: #160000;
    font-family: "Bai Jamjuree";
    font-size: 16px;
    font-weight: 600;
    line-height: normal;
  }
  .kv-cart__count {
    background: #160000;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    min-width: 27px;
    height: 27px;
    padding: 0 6px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .kv-cart__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #160000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .kv-cart__close svg {
    width: 20px;
    height: 20px;
  }

  /* -- Free shipping bar -- */
  .kv-cart__shipping-bar {
    flex-shrink: 0;
  }

  /* -- Items scrollable area -- */
  .kv-cart__items {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 0;
  }

  /* -- Accordion -- */
  .kv-cart__accordion {
    /* border-bottom: 1px solid #e8e5e1; */
  }
  .kv-cart__accordion-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 24px 20px 8px 20px;
      cursor: pointer;
      list-style: none;
      user-select: none;
      position: relative;
    }
    .kv-cart__accordion-header::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 20px;
      right: 20px;
      height: 1px;
      background: rgba(22, 37, 24, 0.20);
    }
  .kv-cart__accordion-header::-webkit-details-marker,
  .kv-cart__accordion-header::marker {
    display: none;
    content: '';
  }
  .kv-cart__accordion-title {
    color: #160000;
    font-family: "Bai Jamjuree";
    font-size: 16px;
    font-weight: 600;
    line-height: normal;
  }
  .kv-cart__accordion-chevron {
    transition: transform 0.25s ease;
    color: #888;
    flex-shrink: 0;
  }
  .kv-cart__accordion[open] > .kv-cart__accordion-header .kv-cart__accordion-chevron {
