{"sections":{"main":{"type":"main-product","blocks":{"liquid_YHLNLk":{"type":"liquid","settings":{"liquid":"<div style=\"display: flex; align-items: center; gap: 12px;\">\n\n  {% if product.metafields.custom.important_product_detail %}\n    <div class=\"meta-box\">\n      {{ product.metafields.custom.important_product_detail.value }}\n    <\/div>\n  {% endif %}\n\n  <div class=\"info-wrapper\">\n    <span>± 2 maanden per geurtje<\/span>\n    <div class=\"info-icon\" onclick=\"toggleTooltip(this)\">\n      <span class=\"info-i\">i<\/span>\n    <\/div>\n    <div class=\"info-tooltip\">\n      Bij een gemiddelde geurintensiteit verbruikt onze Smart Aroma Diffuser <b>0,08 ml per uur<\/b>. \n      Eén ScentPod van 50 ml gaat dan <b>625 uur mee<\/b> – dat is ruim 2 maanden bij 10 uur gebruik per dag.\n    <\/div>\n  <\/div>\n\n<\/div>\n\n\n<style>\n  \/* ✦ Uniforme kleine tekstgrootte *\/\n  .meta-box,\n  .info-wrapper span,\n  .info-wrapper {\n    font-size: 14px !important;   \/* kleiner + uniform *\/\n  }\n\n  \/* ✦ Stijl voor Metafield box *\/\n  .meta-box {\n    background-color: #162518;\n    color: #ffffff;\n    font-weight: 500;\n    padding: 6px 10px;\n    border-radius: 4px;\n    display: inline-flex;\n    align-items: center;\n  }\n\n  \/* ✦ Info wrapper *\/\n  .info-wrapper {\n    display: inline-flex;\n    align-items: center;\n    margin: 0;\n    position: relative;\n    border-radius: 4px;\n    padding: 6px 10px;\n    background-color: #162518;\n    color: #ffffff;\n    font-weight: 500;\n  }\n\n  .info-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    margin-left: 8px;\n    width: 16px;\n    height: 16px;\n    border: 1px solid white;\n    border-radius: 50%;\n    cursor: pointer;\n  }\n\n  .info-i {\n    color: white !important;\n    font-size: 11px !important;\n    font-weight: 600 !important;\n  }\n\n  \/* ✦ Tooltip blijft licht *\/\n  .info-tooltip {\n    display: none;\n    position: absolute;\n    top: 42px;\n    left: 0;\n    background-color: #fff;\n    color: #333;\n    border: 1px solid #ddd;\n    padding: 10px;\n    border-radius: 6px;\n    width: 240px;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n\n    \/* Fix: niet meer de grote tekst *\/\n    font-size: 14px !important;\n    line-height: 1.4;\n    z-index: 10;\n  }\n\n  .info-tooltip::before {\n    content: \"\";\n    position: absolute;\n    top: -6px;\n    left: 16px;\n    border-left: 6px solid transparent;\n    border-right: 6px solid transparent;\n    border-bottom: 6px solid #fff;\n  }\n\n  .info-tooltip::after {\n    content: \"\";\n    position: absolute;\n    top: -7px;\n    left: 15px;\n    border-left: 7px solid transparent;\n    border-right: 7px solid transparent;\n    border-bottom: 7px solid #ddd;\n  }\n\n  .info-icon:hover + .info-tooltip {\n    display: block;\n  }\n\n  .info-icon.active + .info-tooltip {\n    display: block;\n  }\n<\/style>\n\n\n<script>\n  function toggleTooltip(el) {\n    document.querySelectorAll('.info-icon').forEach(function(icon) {\n      if (icon !== el) icon.classList.remove('active');\n    });\n    el.classList.toggle('active');\n  }\n\n  document.addEventListener('click', function (e) {\n    if (!e.target.closest('.info-icon')) {\n      document.querySelectorAll('.info-icon').forEach(function(icon) {\n        icon.classList.remove('active');\n      });\n    }\n  });\n<\/script>"}},"klaviyo_reviews_average_rating_mCyUYN":{"type":"shopify:\/\/apps\/klaviyo-reviews\/blocks\/average-rating\/db20e365-d984-4ac4-9655-e1588d951ca9","settings":{"product":"{{product}}"}},"title":{"type":"title","settings":{"heading_tag":"h3"}},"price":{"type":"price","settings":{"show_taxes_notice":false}},"liquid_UzAGnb":{"type":"liquid","settings":{"liquid":"{%- comment -%}\n  Section: Scent Pod Details Table\n  Displays fragrance family, key notes, and mood in a clean table format.\n{%- endcomment -%}\n\n<div class=\"scent-pod-table-container\">\n  <table class=\"scent-pod-table\">\n    <tbody>\n      {% if product.metafields.custom.scent_family.value != blank %}\n      <tr>\n        <td><strong>Fragrance Family<\/strong><\/td>\n        <td>{{ product.metafields.custom.scent_family.value }}<\/td>\n      <\/tr>\n      {% endif %}\n\n      {% if product.metafields.custom.key_notes.value != blank %}\n      <tr>\n        <td><strong>Key Notes<\/strong><\/td>\n        <td>{{ product.metafields.custom.key_notes.value }}<\/td>\n      <\/tr>\n      {% endif %}\n\n      {% if product.metafields.custom.mood.value != blank %}\n      <tr>\n        <td><strong>Mood<\/strong><\/td>\n        <td>{{ product.metafields.custom.mood.value }}<\/td>\n      <\/tr>\n      {% endif %}\n    <\/tbody>\n  <\/table>\n<\/div>\n\n<style>\n  .scent-pod-table-container {\n    margin: 15px 0;\n    width: 100%;\n    max-width: 500px; \/* Houdt de tabel compact *\/\n  }\n\n  .scent-pod-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: var(--font-body-size);\n    color: var(--color-foreground);\n    line-height: 1.5;\n  }\n\n  .scent-pod-table tr {\n    border-bottom: 1px solid rgba(var(--color-foreground), 0.1); \/* Subtiele scheidingslijn *\/\n  }\n\n  .scent-pod-table tr:last-child {\n    border-bottom: none;\n  }\n\n  .scent-pod-table td {\n    padding: 10px 0;\n    vertical-align: top;\n  }\n\n  \/* De linker kolom (labels) *\/\n  .scent-pod-table td:first-child {\n    width: 35%;\n    font-weight: 600;\n    padding-right: 15px;\n  }\n\n  \/* De rechter kolom (waarden) *\/\n  .scent-pod-table td:last-child {\n    width: 65%;\n  }\n<\/style>"}},"liquid_NDDzcc":{"type":"liquid","settings":{"liquid":"<div class=\"shipping-info\" style=\"display: flex; align-items: center; gap: 8px; margin-top: 0px; margin-bottom: 4px;\">\n  <!-- Icon -->\n  <svg role=\"presentation\" fill=\"none\" focusable=\"false\" stroke-width=\"2\" width=\"20\" height=\"20\" class=\"icon icon-picto-truck\" viewBox=\"0 0 24 24\">\n    <path d=\"M19 17.798h1.868a1.714 1.714 0 0 0 1.715-