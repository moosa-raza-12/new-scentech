                    </div>
                </div>

              </div>
            </div>
          </div>
        </div>
    </div>

    {%- comment -%} Promotional Banner {%- endcomment -%}
    {% if section.settings.promo_banner_enabled %}
    <div class="kv-promo-banner" {% if section.settings.promo_banner_image %}style="background-image: url({{ section.settings.promo_banner_image | image_url: width: 1920 }});"{% endif %}>
      <div class="kv-promo-banner-inner">
        <p class="kv-promo-banner-text">
          {% if section.settings.promo_banner_bold_text != blank %}
            <strong>{{ section.settings.promo_banner_bold_text }}</strong>
          {% endif %}
         {{ section.settings.promo_banner_text }}
        </p>
      </div>
      <div class="kv-promo-banner-discount" data-discount-template="{{ section.settings.promo_banner_discount_text | strip_html | escape }}" style="background-color: {{ section.settings.promo_banner_discount_bg_color }}; display: none;">
          <svg style="min-width: 16px; min-height: 16px;" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
