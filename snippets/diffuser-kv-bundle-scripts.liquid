<script>
    const isOverflowV1 = {{ template.suffix | json }} === 'diffuser-overflow-v1';

    function getAmsterdamToday() {
      const now = new Date();
      const ams = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
      if (ams.getHours() > 22 || (ams.getHours() === 22 && ams.getMinutes() >= 59)) {
        ams.setDate(ams.getDate() + 1);
      }
      ams.setHours(0, 0, 0, 0);
      return ams;
    }
  
    function getShippingDate() {
      const today = getAmsterdamToday();
      const day = today.getDay();
      if (day === 0) today.setDate(today.getDate() + 1);
      if (day === 6) today.setDate(today.getDate() + 2);
      return today;
    }
  
    // Selected products tracker
    let selectedProducts = [];
    
    // Get Shopify money format from theme settings
    const moneyFormat = '{{ shop.money_format }}' || '${{amount}}';
  
    const kvCountryCode = '{{ localization.country.iso_code }}';
    const kvCountryName = '{{ localization.country.name }}';
  
    const kvDeliveryDays = {
      nl: {{ settings.delivery_days_nl | default: 1 }},
      be: {{ settings.delivery_days_be | default: 1 }},
      de: {{ settings.delivery_days_de | default: 2 }},
      euMin: {{ settings.delivery_days_eu_min | default: 3 }},
      euMax: {{ settings.delivery_days_eu_max | default: 4 }},
      rowMin: {{ settings.delivery_days_row_min | default: 6 }},
      rowMax: {{ settings.delivery_days_row_max | default: 10 }}
    };
  
    function getInstockCollapsedMessage() {
      return 'Your order ships out today from the Netherlands.';
    }
  
    function getInstockDeliveryDateRange() {
      const euCountries = ['AT','BG','HR','CY','CZ','DK','EE','FI','FR','GR','HU','IE','IT','LV','LT','LU','MT','PL','PT','RO','SK','SI','ES','SE'];
      const monthNames = ["January","February","March","April","May","June","July","August","September","October","November","December"];
      const shipDate = getShippingDate();
      let minDays, maxDays;
  
      switch (kvCountryCode) {
        case 'NL': minDays = kvDeliveryDays.nl; maxDays = kvDeliveryDays.nl; break;
        case 'BE': minDays = kvDeliveryDays.be; maxDays = kvDeliveryDays.be; break;
        case 'DE': minDays = kvDeliveryDays.de; maxDays = kvDeliveryDays.de; break;
        default:
          if (euCountries.includes(kvCountryCode)) {
            minDays = kvDeliveryDays.euMin;
            maxDays = kvDeliveryDays.euMax;
          } else {
            minDays = kvDeliveryDays.rowMin;
            maxDays = kvDeliveryDays.rowMax;
          }
      }
  
      const startDate = new Date(shipDate);
      startDate.setDate(startDate.getDate() + minDays);
      const endDate = new Date(shipDate);
      endDate.setDate(endDate.getDate() + maxDays);
  
      if (minDays === maxDays) {
        return `${startDate.getDate()} ${monthNames[startDate.getMonth()]}`;
      } else if (startDate.getMonth() === endDate.getMonth()) {
        return `${startDate.getDate()} - ${endDate.getDate()} ${monthNames[endDate.getMonth()]}`;
      } else {
        return `${startDate.getDate()} ${monthNames[startDate.getMonth()]} - ${endDate.getDate()} ${monthNames[endDate.getMonth()]}`;
      }
    }
  
    // Progress bar milestones (product counts)
    const textLabels = {
      free: '{{ section.settings.text_free | default: "FREE" }}',
      freeGift: '{{ section.settings.text_free_gift | default: "Free Gift" }}',
      addScents: '{{ section.settings.text_add_scents | default: "Add Scents" }}',
      continue: '{{ section.settings.text_continue | default: "Continue" }}',
      addToCart: '{{ section.settings.text_add_to_cart | default: "Add to Cart" }}',
      noItems: '{{ section.settings.text_no_items | default: "No items selected" }}',
      save: '{{ section.settings.text_save | default: "SAVE" }}',
      preOrderShips: '{{ section.settings.text_preorder_ships | default: "Pre-Order: Ships by" }}',
      giftPreOrderPrefix: '{{ section.settings.text_gift_preorder_prefix | default: "The" }}',
      giftPreOrderSuffix: '{{ section.settings.text_gift_preorder_suffix | default: "is on Pre-Order. Delivers on" }}'
    };
  
    function parseMilestonePrice(priceStr) {
      if (!priceStr) return 0;
      const cleaned = priceStr.replace(/[^\d,\.]/g, '').replace(',', '.');
      return Math.round(parseFloat(cleaned) * 100) || 0;
    }

    const milestones = {
      milestone1: {{ section.settings.milestone_1_count | default: 0 }},
      milestone2: {{ section.settings.milestone_2_count | default: 0 }},
      milestone3: {{ section.settings.milestone_3_count | default: 0 }},
      milestone4: {{ section.settings.milestone_4_count | default: 0 }},
      milestone1Price: parseMilestonePrice('{{ section.settings.milestone_1_price }}'),
      milestone2Price: parseMilestonePrice('{{ section.settings.milestone_2_price }}'),
      milestone3Price: parseMilestonePrice('{{ section.settings.milestone_3_price }}'),
      milestone4Price: parseMilestonePrice('{{ section.settings.milestone_4_price }}'),
      milestone1Text: '{{ section.settings.milestone_1_text | default: "Add [count] more scents for a FREE gift!" }}',
      milestone2Text: '{{ section.settings.milestone_2_text | default: "Add [count] more scents for a FREE gift!" }}',
      milestone3Text: '{{ section.settings.milestone_3_text | default: "Add [count] more scents for a FREE gift!" }}',
      milestone4Text: '{{ section.settings.milestone_4_text | default: "Add [count] more scents for a FREE gift!" }}',
      startText: '{{ section.settings.progress_start_text | default: "Start building your bundle!" }}',
      completeText: '{{ section.settings.progress_complete_text | default: "ðŸŽ‰ Congratulations! All rewards unlocked!" }}'
    };

    function getMilestonePricePerScent(scentCount) {
      if (milestones.milestone4 > 0 && scentCount >= milestones.milestone4) {
        return milestones.milestone4Price;
      } else if (milestones.milestone3 > 0 && scentCount >= milestones.milestone3) {
        return milestones.milestone3Price;
      } else if (milestones.milestone2 > 0 && scentCount >= milestones.milestone2) {
        return milestones.milestone2Price;
      }
      return milestones.milestone1Price;
    }
  
    const milestoneGifts = [];
  
    document.addEventListener('DOMContentLoaded', function() {
      // Hide preloader after page load
      const preloader = document.getElementById('kv-page-preloader');
      if (preloader) {
        setTimeout(() => {
          preloader.classList.add('hidden');
          setTimeout(() => {
            preloader.style.display = 'none';
          }, 500);
        }, 300);
      }
  
      // Init interrupter CTA buttons: hide if no products configured
      (function initInterrupterButtons() {
        var intrData = window.__kvInterrupterProducts || {};
        document.querySelectorAll('.kv-interrupter-add-to-cart').forEach(function(btn) {
          var blockId = btn.getAttribute('data-block-id');
          var products = intrData[blockId] || [];
          if (products.length === 0) {
            btn.style.display = 'none';
            return;
          }
          btn.setAttribute('data-original-label', btn.textContent.trim());
        });
      })();

      // Diffuser cards stay selectable from page load; the kv-bundle-continue-btn
      // is the only thing gated by the 2-scent minimum.
      document.querySelectorAll('.cds-cards.cds-locked').forEach(function(c) {
        c.classList.remove('cds-locked');
      });

      // Update total count - count of all products across all tabs
      const totalCountElement = document.getElementById('kv-total-count');
      if (totalCountElement) {
        const allProductsGrid = document.querySelector('[data-content="all"] .kv-bundle-products-grid');
        const productCount = allProductsGrid ? allProductsGrid.querySelectorAll('.kv-bundle-product-card').length : 0;
        totalCountElement.textContent = productCount;
      }
  
      // Toggle sticky class when hero section scrolls out of view
      const heroSection = document.querySelector('.kv-bundle-hero-section');
      const bundleCollection = document.querySelector('.kv-bundle-collection');
      const announcementBar = document.querySelector('body .announcement-bar');
      const headerSection = document.querySelector('body .shopify-section--header');
  
      function updateHeroOffset() {
        if (!heroSection) return;
        let offset = 0;
        if (announcementBar) offset += announcementBar.offsetHeight || 0;
        if (headerSection) offset += headerSection.offsetHeight || 0;
        heroSection.style.setProperty('--kv-hero-offset', `${offset}px`);
        document.documentElement.style.setProperty('--kv-hero-offset', `${offset}px`);
      }
  
      updateHeroOffset();
  
      if (window.ResizeObserver) {
        const resizeObserver = new ResizeObserver(() => {
          updateHeroOffset();
          calcStickyTrigger();
        });
        if (announcementBar) resizeObserver.observe(announcementBar);
        if (headerSection) resizeObserver.observe(headerSection);
      } else {
        window.addEventListener('resize', () => { updateHeroOffset(); calcStickyTrigger(); });
        window.addEventListener('load', () => { updateHeroOffset(); calcStickyTrigger(); });
      }
  
      const bundleCollectionEl = document.querySelector('.kv-bundle-collection');

      function updateCollectionPadding() {
        if (!bundleCollectionEl) return;

        const isMobile = window.innerWidth < 768; // adjust breakpoint if needed
        const paddingValue = isMobile ? '250px' : '170px';

        if (heroSection && heroSection.classList.contains('sticky')) {
          bundleCollectionEl.style.paddingTop = paddingValue;
        } else {
          bundleCollectionEl.style.paddingTop = '';
        }
      }
  
      const step1Section = document.querySelector('.custom-diffuser-selector');
      const scentHeader = document.querySelector('.scent-header');
      let stickyTriggerPoint = 0;
      function calcStickyTrigger() {
        const el = step1Section || scentHeader;
        if (!el) return;
        const rect = el.getBoundingClientRect();
        const scrollY = window.pageYOffset || document.documentElement.scrollTop;
        stickyTriggerPoint = rect.bottom + scrollY;
      }
      calcStickyTrigger();

      function handleHeroSticky() {
        const scentSelector = document.querySelector('.scent-selector');
        const progresFooter = document.querySelector('.kv-progress-footer2');
        if (!heroSection) return;
        const scrollY = window.pageYOffset || document.documentElement.scrollTop;
        const wasSticky = heroSection.classList.contains('sticky');
        const shouldBeSticky = scrollY > stickyTriggerPoint;

        if (shouldBeSticky !== wasSticky) {
          if (shouldBeSticky) {
            heroSection.classList.add('sticky');
            if (scentSelector) scentSelector.style.display = 'none';
            if (progresFooter) progresFooter.style.display = 'block';
          } else {
            heroSection.classList.remove('sticky');
            if (scentSelector) scentSelector.style.display = 'block';
            if (progresFooter) progresFooter.style.display = 'none';
          }
          updateCollectionPadding();
        }
      }
  
      handleHeroSticky();
      window.addEventListener('scroll', handleHeroSticky, { passive: true });
  
      function updateProgressFooterScrollVisibility() {
        const progressFooter = document.getElementById('kv-progress-footer-empty');
        if (!progressFooter) return;
  
        const stickyTarget = document.querySelector('.kv-bundle-items-sticky');
        const triggerPoint = stickyTarget
          ? stickyTarget.getBoundingClientRect().top + window.scrollY
          : 600;
        const hasPassedTrigger = window.scrollY >= triggerPoint;
  
        progressFooter.style.display = hasPassedTrigger ? 'block' : 'none';
      }
  
      updateProgressFooterScrollVisibility();
      window.addEventListener('scroll', updateProgressFooterScrollVisibility, { passive: true });
      window.addEventListener('resize', updateProgressFooterScrollVisibility);
  
      if (window.ResizeObserver) {
        const heroResizeObserver = new ResizeObserver(() => {
          updateCollectionPadding();
        });
        heroResizeObserver.observe(heroSection);
      } else {
        window.addEventListener('resize', updateCollectionPadding);
      }
  
      // Tab switching
      const tabs = document.querySelectorAll('.kv-bundle-tab');
      const tabContents = document.querySelectorAll('.kv-bundle-tab-content');
  
      tabs.forEach(tab => {
        tab.addEventListener('click', function() {
          const tabId = this.getAttribute('data-tab');
          
          // Remove active class from all tabs and contents
          tabs.forEach(t => t.classList.remove('active'));
          tabContents.forEach(tc => tc.classList.remove('active'));
          
          // Add active class to clicked tab and corresponding content
          this.classList.add('active');
          document.querySelector(`[data-content="${tabId}"]`).classList.add('active');
        });
      });
  
      // Activate the first collection tab on page load
      const firstCollectionTab = document.querySelector('.kv-bundle-tab:not([data-tab="all"])');
      if (firstCollectionTab) {
        const firstTabId = firstCollectionTab.getAttribute('data-tab');
        tabs.forEach(t => t.classList.remove('active'));
        tabContents.forEach(tc => tc.classList.remove('active'));
        firstCollectionTab.classList.add('active');
        const firstTabContent = document.querySelector(`[data-content="${firstTabId}"]`);
        if (firstTabContent) firstTabContent.classList.add('active');
      }
  
      // Handle diffuser selector cards (cds-cards) as selected bundle products
      document.addEventListener('kv:selector-product-selected', function(e) {
        const data = e.detail || {};
        if (!data.productId || !data.variantId) return;

        const selectorProduct = {
          productId: data.productId,
          productHandle: data.productHandle || '',
          variantId: data.variantId,
          quantity: 1,
          image: data.image || '',
          title: data.title || '',
          price: parseInt(data.variantPrice, 10) || 0,
          compareAtPrice: parseInt(data.variantCompareAtPrice, 10) || 0,
          inventoryDate: '',
          inventoryQuantity: 0,
          selectionSource: 'cds-selector'
        };

        selectedProducts = selectedProducts.filter(product => product.selectionSource !== 'cds-selector');
        selectedProducts.push(selectorProduct);

        syncProductState(selectorProduct.productId, 'add');
        syncProductQuantity(selectorProduct.productId, 1);

        updateThumbnailCarousel();
        if (document.getElementById('kv-minicart').classList.contains('active')) {
          updateMiniCart();
        }
      });

      // Second diffuser selection (from accordion)
      document.addEventListener('kv:second-selector-product-selected', function(e) {
        const data = e.detail || {};
        if (!data.productId || !data.variantId) return;

        const selectorProduct = {
          productId: data.productId + '-second',
          productHandle: data.productHandle || '',
          variantId: data.variantId,
          quantity: 1,
          image: data.image || '',
          title: data.title || '',
          price: parseInt(data.variantPrice, 10) || 0,
          compareAtPrice: parseInt(data.variantCompareAtPrice, 10) || 0,
          inventoryDate: '',
          inventoryQuantity: 0,
          selectionSource: 'cds-selector-2'
        };

        selectedProducts = selectedProducts.filter(product => product.selectionSource !== 'cds-selector-2');
        selectedProducts.push(selectorProduct);

        updateThumbnailCarousel();
        if (document.getElementById('kv-minicart').classList.contains('active')) {
          updateMiniCart();
        }
      });
  
      // Handle Add button click - show quantity controls
      document.addEventListener('click', function(e) {
        if (e.target.classList.contains('kv-bundle-add-to-cart') || e.target.closest('.kv-bundle-add-to-cart')) {
          const button = e.target.classList.contains('kv-bundle-add-to-cart') ? e.target : e.target.closest('.kv-bundle-add-to-cart');
          const card = button.closest('.kv-bundle-product-card');
          const productId = card.getAttribute('data-product-id');
          const productHandle = card.getAttribute('data-product-handle');
          const variantId = button.getAttribute('data-variant-id');
          const variantPrice = button.getAttribute('data-variant-price');
          const variantCompareAtPrice = button.getAttribute('data-variant-compare-at-price');
          const inventoryDate = card.getAttribute('data-inventory-date');
          const inventoryQuantity = parseInt(card.getAttribute('data-inventory-quantity')) || 0;
          const productImage = card.querySelector('.kv-bundle-product-image');
          const productTitle = card.querySelector('.kv-bundle-product-title').textContent.trim();
          
          // Show quantity controls on ALL instances of this product
          syncProductState(productId, 'add');
          
          // Add to selected products with price from data attribute
          const productData = {
            productId: productId,
            productHandle: productHandle,
            variantId: variantId,
            quantity: 1,
            image: productImage.src,
            title: productTitle,
            price: parseInt(variantPrice) || 0,
            compareAtPrice: parseInt(variantCompareAtPrice) || 0,
            inventoryDate: inventoryDate || '',
            inventoryQuantity: inventoryQuantity
          };
          
          // Check if product already exists
          const existingIndex = selectedProducts.findIndex(p => p.productId === productId);
          if (existingIndex === -1) {
            selectedProducts.push(productData);
          } else {
            selectedProducts[existingIndex] = productData;
          }
          
          updateThumbnailCarousel();
        }
      });
  
      // Quantity controls
      document.addEventListener('click', function(e) {
        // Check if clicked element or its parent is the decrease button
        const decreaseBtn = e.target.classList.contains('kv-bundle-qty-decrease') ? e.target : e.target.closest('.kv-bundle-qty-decrease');
        if (decreaseBtn) {
          const input = decreaseBtn.nextElementSibling;
          const card = decreaseBtn.closest('.kv-bundle-product-card');
          if (!card) return;
          
          const productId = card.getAttribute('data-product-id');
          const currentValue = parseInt(input.value);
          
          if (currentValue > 1) {
            const newValue = currentValue - 1;
            // Update all instances of this product
            syncProductQuantity(productId, newValue);
            updateProductQuantity(productId, newValue);
          } else {
            // Remove product if quantity is 0
            syncProductState(productId, 'remove');
            removeSelectedProduct(productId);
          }
          return;
        }
  
        // Check if clicked element or its parent is the increase button
        const increaseBtn = e.target.classList.contains('kv-bundle-qty-increase') ? e.target : e.target.closest('.kv-bundle-qty-increase');
        if (increaseBtn) {
          const input = increaseBtn.previousElementSibling;
          const card = increaseBtn.closest('.kv-bundle-product-card');
          if (!card) return;
          
          const productId = card.getAttribute('data-product-id');
          const currentValue = parseInt(input.value);
          const newValue = currentValue + 1;
          // Update all instances of this product
          syncProductQuantity(productId, newValue);
          updateProductQuantity(productId, newValue);
        }
      });
  
      // Interrupter card add-to-cart (multi-product): adds all products, shows qty controls
      document.addEventListener('click', function(e) {
        var intrAddToCartBtn = e.target.classList.contains('kv-interrupter-add-to-cart') ? e.target : e.target.closest('.kv-interrupter-add-to-cart');
        if (!intrAddToCartBtn) return;

        var blockId = intrAddToCartBtn.getAttribute('data-block-id');
        var productsData = (window.__kvInterrupterProducts || {})[blockId] || [];
        if (productsData.length === 0) return;

        addInterrupterProducts(blockId);
        var qty = getInterrupterQty(blockId);
        syncInterrupterQtyUI(blockId, qty);
      });

      // Interrupter quantity controls (decrease / increase)
      document.addEventListener('click', function(e) {
        var decreaseBtn = e.target.classList.contains('kv-intr-qty-decrease') ? e.target : e.target.closest('.kv-intr-qty-decrease');
        if (decreaseBtn) {
          var wrapper = decreaseBtn.closest('.kv-interrupter-qty-wrapper');
          if (!wrapper) return;
          var blockId = wrapper.getAttribute('data-block-id');
          if (!blockId) return;
          decreaseInterrupterProducts(blockId);
          var qty = getInterrupterQty(blockId);
          syncInterrupterQtyUI(blockId, qty);
          return;
        }

        var increaseBtn = e.target.classList.contains('kv-intr-qty-increase') ? e.target : e.target.closest('.kv-intr-qty-increase');
        if (increaseBtn) {
          var wrapper = increaseBtn.closest('.kv-interrupter-qty-wrapper');
          if (!wrapper) return;
          var blockId = wrapper.getAttribute('data-block-id');
          if (!blockId) return;
          addInterrupterProducts(blockId);
          var qty = getInterrupterQty(blockId);
          syncInterrupterQtyUI(blockId, qty);
        }
      });
  
      // Variant selection
      document.addEventListener('click', function(e) {
        if (e.target.classList.contains('kv-bundle-variant-image')) {
          const card = e.target.closest('.kv-bundle-product-card');
          const productId = card.getAttribute('data-product-id');
          const variantId = e.target.getAttribute('data-variant-id');
          const variantPrice = e.target.getAttribute('data-variant-price');
          const variantCompareAtPrice = e.target.getAttribute('data-variant-compare-at-price');
          const variantImageSrc = e.target.src;
          
          // Update ALL instances of this product across all tabs
          const allCards = document.querySelectorAll(`[data-product-id="${productId}"]`);
          allCards.forEach(productCard => {
            if (!productCard.classList.contains('kv-bundle-product-card')) return;
            
            const variantImages = productCard.querySelectorAll('.kv-bundle-variant-image');
            const mainImage = productCard.querySelector('.kv-bundle-product-image');
            const addToCartBtn = productCard.querySelector('.kv-bundle-add-to-cart');
            
            // Update active state on variant images
            variantImages.forEach(img => {
              if (img.getAttribute('data-variant-id') === variantId) {
                img.classList.add('active');
              } else {
                img.classList.remove('active');
              }
            });
            
            // Update main image
            if (mainImage) {
              mainImage.src = variantImageSrc.replace('width=100', 'width=600');
            }
            
            // Update variant ID, price and compare-at price in add to cart button
            if (addToCartBtn && variantId) {
              addToCartBtn.setAttribute('data-variant-id', variantId);
              addToCartBtn.setAttribute('data-variant-price', variantPrice);
              addToCartBtn.setAttribute('data-variant-compare-at-price', variantCompareAtPrice);
            }
          });
  
          // Update variant in selected products
          const product = selectedProducts.find(p => p.productId === productId);
          if (product) {
            product.variantId = variantId;
            product.image = variantImageSrc.replace('width=100', 'width=160');
            product.price = parseInt(variantPrice) || product.price;
            product.compareAtPrice = parseInt(variantCompareAtPrice) || 0;
            updateThumbnailCarousel();
            if (document.getElementById('kv-minicart').classList.contains('active')) {
              updateMiniCart();
            }
          }
        }
      });
  
      // Mini cart controls
      const openMiniCartBtn = document.getElementById('kv-open-minicart');
      const closeMiniCartBtn = document.getElementById('kv-close-minicart');
      const miniCartOverlay = document.getElementById('kv-minicart-overlay');
      const miniCart = document.getElementById('kv-minicart');
      const checkoutBtn = document.getElementById('kv-checkout-btn');
  
      function openMiniCart() {
        if (selectedProducts.length === 0) {
          return;
        }
        // Don't open if scent modal is open
        if (document.getElementById('kv-scent-modal').classList.contains('active')) {
          return;
        }
        miniCartOverlay.classList.add('active');
        miniCart.classList.add('active');
        document.body.style.overflow = 'hidden';
        updateMiniCart();
      }
  
      function closeMiniCart() {
        miniCartOverlay.classList.remove('active');
        miniCart.classList.remove('active');
        document.body.style.overflow = '';
      }
  
      closeMiniCartBtn.addEventListener('click', closeMiniCart);
      miniCartOverlay.addEventListener('click', closeMiniCart);

      // Mini trigger to open mini cart
      const miniTrigger = document.querySelector('.kv-bundle-items-mini-trigger');
      if (miniTrigger) {
        miniTrigger.addEventListener('click', function() { addBundleToCart(openMiniCartBtn); });
      }

      // Shared add-to-cart logic used by both the continue button and checkout button
      function addBundleToCart(triggerBtn) {
        if (selectedProducts.length === 0) return;

        const originalButtonHTML = triggerBtn.innerHTML;
        triggerBtn.disabled = true;
        triggerBtn.innerHTML = 'Adding to cart...';

        const items = selectedProducts.map(product => ({
          id: product.variantId,
          quantity: product.quantity
        }));

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ items: items })
        })
        .then(response => response.json())
        .then(data => {
          triggerBtn.innerHTML = '✓ Added to Cart!';

          const cartPromises = [
            fetch('/cart.js').then(resp => {
              if (!resp.ok) throw new Error('Failed to fetch cart data');
              return resp.json();
            }),
            fetch(`${window.location.pathname}?section_id=cart-drawer`).then(resp => {
              if (!resp.ok) throw new Error('Failed to fetch cart drawer section');
              return resp.text();
            })
          ];

          Promise.all(cartPromises)
            .then(([cartData, sectionsHtml]) => {
              const tempDiv = document.createElement('div');
              tempDiv.innerHTML = sectionsHtml;
              const cartDrawerContent = tempDiv.querySelector('#cart-drawer');
              const cartDrawer = document.querySelector('cart-drawer');

              if (cartDrawer && cartDrawerContent) {
                cartDrawer.innerHTML = cartDrawerContent.innerHTML;
              }

              const cartCountElements = document.querySelectorAll('cart-count');
              cartCountElements.forEach(counter => {
                counter.itemCount = cartData.item_count;
              });

              if (cartDrawer && typeof cartDrawer.show === 'function') {
                cartDrawer.show();
              } else {
                document.dispatchEvent(new CustomEvent('drawer:show', {
                  bubbles: true,
                  detail: { drawer: cartDrawer }
                }));
              }

              document.dispatchEvent(new CustomEvent('cart:change', {
                bubbles: true,
                detail: {
                  baseEvent: 'variant:add',
                  cart: cartData,
                  sections: { 'cart-drawer': sectionsHtml }
                }
              }));

              document.dispatchEvent(new CustomEvent('variant:add', {
                bubbles: true,
                detail: { cart: cartData }
              }));

              document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));

              closeMiniCart();
              selectedProducts.forEach(product => {
                syncProductState(product.productId, 'remove');
              });
              selectedProducts = [];
              resetInterrupterBundleUI();
              updateThumbnailCarousel();

              // Mini-cart checkout only: restore label/HTML after success.
              // Continue button (#kv-open-minicart) must stay managed by updateThumbnailCarousel
              // (disabled until 2+ scents again — same as initial load).
              if (triggerBtn.id === 'kv-checkout-btn') {
                triggerBtn.disabled = false;
                setTimeout(() => {
                  triggerBtn.innerHTML = originalButtonHTML;
                }, 1500);
              }
            })
            .catch(error => {
              console.error('Error updating cart drawer:', error);
              triggerBtn.disabled = false;
              triggerBtn.innerHTML = originalButtonHTML;
              window.location.href = '/cart';
            });
        })
        .catch(error => {
          triggerBtn.disabled = false;
          triggerBtn.innerHTML = originalButtonHTML;
          alert('Error adding to cart. Please try again.');
          console.error('Error:', error);
        });
      }

      // Continue button directly adds to cart (no mini cart)
      openMiniCartBtn.addEventListener('click', function() {
        addBundleToCart(openMiniCartBtn);
      });

      // Checkout button in mini cart also adds to cart
      checkoutBtn.addEventListener('click', function() {
        addBundleToCart(checkoutBtn);
      });
  
      // Initialize progress bar on page load
      updateProgressBar();
  
      // Scent info modal functionality
      const scentModal = document.getElementById('kv-scent-modal');
      const scentModalOverlay = document.getElementById('kv-scent-modal-overlay');
      const scentModalClose = scentModal.querySelector('.kv-scent-modal-close');
      const scentModalImg = document.getElementById('kv-scent-modal-img');
      const scentModalTitle = document.getElementById('kv-scent-modal-title');
      const scentModalDescription = document.getElementById('kv-scent-modal-description');
      const scentModalDetails = document.getElementById('kv-scent-modal-details');
      const scentModalVariant = document.getElementById('kv-scent-modal-variant');
      const scentModalBadge = document.getElementById('kv-scent-modal-badge');
      const scentModalAdd = document.getElementById('kv-scent-modal-add');
      let currentModalProductId = null;
  
      function openScentModal(productData) {
        // Don't open if minicart is open
        if (document.getElementById('kv-minicart').classList.contains('active')) {
          return;
        }
        
        currentModalProductId = productData.productId;
        
        // Set content
        scentModalTitle.textContent = productData.title;
        scentModalDescription.textContent = productData.description || 'Porduct Description will come here';
        scentModalVariant.textContent = productData.variant;
        
        // Set badge
        if (productData.badge) {
          scentModalBadge.textContent = productData.badge;
          scentModalBadge.style.display = '';
        } else {
          scentModalBadge.style.display = 'none';
        }
        
        // Set image
        if (productData.image) {
          scentModalImg.src = productData.image;
          scentModalImg.alt = productData.title;
          scentModal.querySelector('.kv-scent-modal-image').style.display = 'block';
        } else {
          scentModal.querySelector('.kv-scent-modal-image').style.display = 'none';
        }
        
        // Set details
        if (productData.details) {
          scentModalDetails.innerHTML = productData.details.replace(/\n/g, '<br>');
        } else {
          scentModalDetails.innerHTML = 'This is dummy text fill data in product metafields';
        }
        
        // Show modal and overlay
        scentModalOverlay.classList.add('active');
        scentModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
  
      function closeScentModal() {
        scentModalOverlay.classList.remove('active');
        scentModal.classList.remove('active');
        document.body.style.overflow = '';
        currentModalProductId = null;
      }
  
      // Handle info icon clicks and product image clicks
      document.addEventListener('click', function(e) {
        const infoBtn = e.target.closest('.kv-scent-info-btn');
        const productImage = e.target.closest('.kv-bundle-product-image');
        
        if (infoBtn) {
          e.preventDefault();
          e.stopPropagation();
          
          const productData = {
            productId: infoBtn.getAttribute('data-product-id'),
            title: infoBtn.getAttribute('data-product-title'),
            description: infoBtn.getAttribute('data-product-description'),
            details: infoBtn.getAttribute('data-product-details'),
            image: infoBtn.getAttribute('data-product-image'),
            variant: infoBtn.getAttribute('data-product-variant'),
            badge: infoBtn.getAttribute('data-product-badge')
          };
          
          openScentModal(productData);
        } else if (productImage) {
          e.preventDefault();
          e.stopPropagation();
          
          // Find parent product card to get data attributes
          const productCard = productImage.closest('.kv-bundle-product-card');
          if (productCard) {
            const infoButton = productCard.querySelector('.kv-scent-info-btn');
            if (infoButton) {
              const productData = {
                productId: infoButton.getAttribute('data-product-id'),
                title: infoButton.getAttribute('data-product-title'),
                description: infoButton.getAttribute('data-product-description'),
                details: infoButton.getAttribute('data-product-details'),
                image: infoButton.getAttribute('data-product-image'),
                variant: infoButton.getAttribute('data-product-variant'),
                badge: infoButton.getAttribute('data-product-badge')
              };
              
              openScentModal(productData);
            }
          }
        }
      });
  
      // Close modal handlers
      scentModalClose.addEventListener('click', closeScentModal);
      scentModalOverlay.addEventListener('click', closeScentModal);
  
      // Modal Add button - find and click the product's Add button
      scentModalAdd.addEventListener('click', function() {
        if (currentModalProductId) {
          const productCard = document.querySelector(`[data-product-id="${currentModalProductId}"]`);
          if (productCard) {
            const addBtn = productCard.querySelector('.kv-bundle-add-to-cart');
            if (addBtn && !addBtn.disabled) {
              addBtn.click();
              closeScentModal();
            }
          }
        }
      });
  
      // Close on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && scentModal.classList.contains('active')) {
          closeScentModal();
        }
      });
  
      // Info popup modal - disabled (scent modal kept as-is)
  
      // Open modals when clicking on milestone gifts
      document.addEventListener('click', function(e) {
        const milestoneGift = e.target.closest('.kv-milestone-gift');
        if (milestoneGift) {
          const milestone = milestoneGift.closest('.kv-progress-milestone');
          if (milestone) {
            const milestoneNumber = milestone.getAttribute('data-milestone');
            e.preventDefault();
            
            // Open scent modal for milestone 1 (first milestone gift)
            if (milestoneNumber === '1') {
              const productData = {
                productId: milestoneGift.getAttribute('data-product-id'),
                title: milestoneGift.getAttribute('data-product-title'),
                description: milestoneGift.getAttribute('data-product-description'),
                details: milestoneGift.getAttribute('data-product-details'),
                image: milestoneGift.getAttribute('data-product-image'),
                variant: milestoneGift.getAttribute('data-product-variant'),
                badge: milestoneGift.getAttribute('data-product-badge')
              };
              openScentModal(productData);
            }
            // Info modal disabled for milestones 2, 3, 4
          }
        }
      });
    });
  
    // Sync product state across all tabs
    function syncProductState(productId, action) {
      const allCards = document.querySelectorAll(`[data-product-id="${productId}"]`);
      
      allCards.forEach(card => {
        if (!card.classList.contains('kv-bundle-product-card')) return;
        
        const quantitySelector = card.querySelector('.kv-bundle-quantity-selector');
        const qtyInput = card.querySelector('.kv-bundle-qty-input');
        
        if (action === 'add') {
          card.classList.add('has-quantity');
          if (quantitySelector) quantitySelector.classList.add('active');
          if (qtyInput) qtyInput.value = 1;
        } else if (action === 'remove') {
          card.classList.remove('has-quantity');
          if (quantitySelector) quantitySelector.classList.remove('active');
          if (qtyInput) qtyInput.value = 1;
        }
      });
    }
  
    // Sync product quantity across all tabs
    function syncProductQuantity(productId, quantity) {
      const allCards = document.querySelectorAll(`[data-product-id="${productId}"]`);
      
      allCards.forEach(card => {
        if (!card.classList.contains('kv-bundle-product-card')) return;
        
        const qtyInput = card.querySelector('.kv-bundle-qty-input');
        if (qtyInput) {
          qtyInput.value = quantity;
        }
      });
    }
  
    // Update product quantity in selected products
    function updateProductQuantity(productId, quantity) {
      const product = selectedProducts.find(p => p.productId === productId);
      if (product) {
        product.quantity = quantity;
        updateThumbnailCarousel();
        if (document.getElementById('kv-minicart').classList.contains('active')) {
          updateMiniCart();
        }
      }
    }
  
    // --- Interrupter multi-product helpers ---

    function addInterrupterProducts(blockId) {
      var productsData = (window.__kvInterrupterProducts || {})[blockId] || [];
      productsData.forEach(function(p) {
        var pid = String(p.id);
        var existing = selectedProducts.find(function(sp) { return sp.productId === pid; });
        if (existing) {
          existing.quantity += 1;
          syncProductQuantity(pid, existing.quantity);
        } else {
          selectedProducts.push({
            productId: pid,
            productHandle: p.handle,
            variantId: String(p.variantId),
            quantity: 1,
            image: p.image,
            title: p.title,
            price: parseInt(p.variantPrice) || 0,
            compareAtPrice: parseInt(p.compareAtPrice) || 0,
            inventoryDate: p.inventoryDate || '',
            inventoryQuantity: parseInt(p.inventoryQty) || 0
          });
          syncProductState(pid, 'add');
        }
      });
      updateThumbnailCarousel();
    }

    function decreaseInterrupterProducts(blockId) {
      var productsData = (window.__kvInterrupterProducts || {})[blockId] || [];
      productsData.forEach(function(p) {
        var pid = String(p.id);
        var existing = selectedProducts.find(function(sp) { return sp.productId === pid; });
        if (existing) {
          if (existing.quantity > 1) {
            existing.quantity -= 1;
            syncProductQuantity(pid, existing.quantity);
          } else {
            syncProductState(pid, 'remove');
            removeSelectedProduct(pid);
          }
        }
      });
      updateThumbnailCarousel();
    }

    function getInterrupterQty(blockId) {
      var productsData = (window.__kvInterrupterProducts || {})[blockId] || [];
      if (productsData.length === 0) return 0;
      var minQty = Infinity;
      productsData.forEach(function(p) {
        var existing = selectedProducts.find(function(sp) { return sp.productId === String(p.id); });
        minQty = Math.min(minQty, existing ? existing.quantity : 0);
      });
      return minQty === Infinity ? 0 : minQty;
    }

    function syncInterrupterQtyUI(blockId, qty) {
      document.querySelectorAll('.kv-interrupter-add-to-cart[data-block-id="' + blockId + '"]').forEach(function(btn) {
        var wrapper = btn.parentElement.querySelector('.kv-interrupter-qty-wrapper[data-block-id="' + blockId + '"]');
        if (qty > 0) {
          btn.style.display = 'none';
          if (!wrapper) {
            wrapper = document.createElement('div');
            wrapper.className = 'kv-interrupter-qty-wrapper kv-bundle-quantity-selector active';
            wrapper.setAttribute('data-block-id', blockId);
            wrapper.innerHTML =
              '<button class="kv-bundle-qty-btn kv-intr-qty-decrease" type="button" aria-label="Decrease quantity">' +
                '<svg width="4" height="2" viewBox="0 0 4 2" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 0H3.77051V1.49805H0V0Z" fill="white"/></svg>' +
              '</button>' +
              '<input type="number" class="kv-bundle-qty-input" value="' + qty + '" min="0" readonly aria-label="Quantity">' +
              '<button class="kv-bundle-qty-btn kv-intr-qty-increase" type="button" aria-label="Increase quantity">' +
                '<svg width="7" height="7" viewBox="0 0 7 7" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 2.34229H2.33594V0H3.68799V2.34229H6.03027V3.69434H3.68799V6.03662H2.33594V3.69434H0V2.34229Z" fill="white"/></svg>' +
              '</button>';
            btn.insertAdjacentElement('afterend', wrapper);
          } else {
            wrapper.querySelector('.kv-bundle-qty-input').value = qty;
            wrapper.style.display = '';
          }
        } else {
          btn.style.display = '';
          if (wrapper) wrapper.style.display = 'none';
        }
      });
    }

    function checkInterrupterBlockState() {
      var intrData = window.__kvInterrupterProducts || {};
      var checkedBlocks = {};
      document.querySelectorAll('.kv-interrupter-qty-wrapper[data-block-id]').forEach(function(wrapper) {
        var blockId = wrapper.getAttribute('data-block-id');
        if (checkedBlocks[blockId]) return;
        checkedBlocks[blockId] = true;
        var productsData = intrData[blockId] || [];
        var allRemoved = productsData.every(function(p) {
          return !selectedProducts.some(function(sp) { return sp.productId === String(p.id); });
        });
        if (allRemoved) {
          syncInterrupterQtyUI(blockId, 0);
        } else {
          var minQty = Infinity;
          productsData.forEach(function(p) {
            var existing = selectedProducts.find(function(sp) { return sp.productId === String(p.id); });
            minQty = Math.min(minQty, existing ? existing.quantity : 0);
          });
          if (minQty !== Infinity && minQty >= 0) {
            syncInterrupterQtyUI(blockId, minQty);
          }
        }
      });
    }

    // After bundle checkout: restore interrupter buttons (same “fresh” state as product cards)
    function resetInterrupterBundleUI() {
      document.querySelectorAll('.kv-interrupter-qty-wrapper').forEach(function(w) {
        w.remove();
      });
      var intrData = window.__kvInterrupterProducts || {};
      document.querySelectorAll('.kv-interrupter-add-to-cart').forEach(function(btn) {
        var blockId = btn.getAttribute('data-block-id');
        var products = intrData[blockId] || [];
        if (products.length === 0) {
          btn.style.display = 'none';
          return;
        }
        btn.style.display = '';
        btn.disabled = false;
        btn.classList.remove('loading', 'kv-interrupter-added');
        var orig = btn.getAttribute('data-original-label');
        if (orig) btn.textContent = orig;
      });
    }

    // Remove product from selected products
    function removeSelectedProduct(productId) {
      selectedProducts = selectedProducts.filter(p => p.productId !== productId);
      updateThumbnailCarousel();
      checkInterrupterBlockState();
      if (document.getElementById('kv-minicart').classList.contains('active')) {
        updateMiniCart();
        
        // Close mini cart if no products left
        if (selectedProducts.length === 0) {
          setTimeout(() => {
            document.getElementById('kv-minicart-overlay').classList.remove('active');
            document.getElementById('kv-minicart').classList.remove('active');
            document.body.style.overflow = '';
          }, 300);
        }
      }
    }
  
    // Update thumbnail carousel with selected products
    function updateThumbnailCarousel() {
      const carousel = document.getElementById('kv-selected-products');
      const continueBtn = document.getElementById('kv-open-minicart');
      const miniTrigger = document.querySelector('.kv-bundle-items-mini-trigger');
      const skeletons = Array.from(carousel.querySelectorAll('.kv-skeleton-placeholder'));
  
      const nonSelectorItemCount = selectedProducts
        .filter(product => product.selectionSource !== 'cds-selector' && product.selectionSource !== 'cds-selector-2')
        .reduce((sum, product) => sum + (product.quantity || 0), 0);
  
      // Below the 2-scent threshold, just update messaging. The diffuser stays
      // selected and the cds-cards remain unlocked so the customer can pick a
      // diffuser at any time; the kv-bundle-continue-btn gating below handles
      // the actual lock.
      if (nonSelectorItemCount < 2) {
        const badgeText=document.querySelector('.text-update')
        const badgeTextEmpty=document.getElementById('kv-progress-footer-message-empty')
        if (badgeTextEmpty) {
          badgeTextEmpty.textContent = 'Choose at least 2 scents';
        }
        if (badgeText) {
          badgeText.textContent = 'Choose at least 2 scents';
        }
      }

      // Auto-select the first diffuser card when 2 scents are reached and none is selected yet
      if (nonSelectorItemCount >= 2) {

        document.querySelectorAll('.cds-cards').forEach(c => c.classList.remove('cds-locked'));
        
        const badgeText=document.querySelector('.text-update')
        const badgeTextEmpty=document.getElementById('kv-progress-footer-message-empty')
        const sectionEl = document.querySelector('.kv-bundle-section');
        const addMoreOrderText = sectionEl?.dataset.textAddMoreOrder || 'Add more or place your order!';
        if (badgeTextEmpty) {
          badgeTextEmpty.textContent = addMoreOrderText;
        }
        if (badgeText) {
          badgeText.textContent = addMoreOrderText;
        }
        const hasSelectorProduct = selectedProducts.some(p => p.selectionSource === 'cds-selector');
        if (!hasSelectorProduct) {
          const firstCard = document.querySelector('.cds-cards[data-diffuser-group="primary"]');
          if (firstCard && firstCard.getAttribute('data-product-id')) {
            document.querySelectorAll('.cds-cards[data-diffuser-group="primary"]').forEach(c => c.classList.remove('active'));
            firstCard.classList.add('active');
            const highlight = firstCard.querySelector('.cds-highlight');
            if (highlight) highlight.style.display = '';

            // Dispatch selection event so the diffuser gets added to selectedProducts
            const autoSelected = {
              productId: firstCard.getAttribute('data-product-id'),
              productHandle: firstCard.getAttribute('data-product-handle'),
              variantId: firstCard.getAttribute('data-variant-id'),
              variantPrice: parseInt(firstCard.getAttribute('data-variant-price') || '0', 10),
              variantCompareAtPrice: parseInt(firstCard.getAttribute('data-variant-compare-at-price') || '0', 10),
              title: firstCard.getAttribute('data-product-title') || '',
              image: firstCard.getAttribute('data-product-image') || ''
            };
            document.dispatchEvent(new CustomEvent('kv:selector-product-selected', { detail: autoSelected }));
          }
        }
      }
      
      // Remove existing product thumbnails (keep skeleton placeholders)
      const existingProducts = carousel.querySelectorAll('.kv-bundle-thumbnail-wrapper:not(.kv-skeleton-placeholder)');
      existingProducts.forEach(el => el.remove());
  
      const totalSelectedCount = selectedProducts.reduce((sum, product) => {
        return sum + (product.quantity || 0);
      }, 0);
  
      // Build CTA pricing using milestone-based per-scent pricing
      const scentCount = selectedProducts
        .filter(product => product.selectionSource !== 'cds-selector' && product.selectionSource !== 'cds-selector-2')
        .reduce((sum, product) => sum + (product.quantity || 0), 0);

      const pricePerScent = getMilestonePricePerScent(scentCount);
      let runningTotal = (scentCount * pricePerScent) / 100;

      // Add primary diffuser at 50% price when 2+ scents are selected
      const diffuserProduct = selectedProducts.find(p => p.selectionSource === 'cds-selector');
      if (diffuserProduct && scentCount >= 2) {
        const diffuserPrice = (diffuserProduct.price || 0) / 100;
        runningTotal += diffuserPrice * 0.5;
      }

      // Add second diffuser at 50% price when 2+ scents are selected
      const secondDiffuserProduct = selectedProducts.find(p => p.selectionSource === 'cds-selector-2');
      if (secondDiffuserProduct && scentCount >= 2) {
        const secondDiffuserPrice = (secondDiffuserProduct.price || 0) / 100;
        runningTotal += secondDiffuserPrice * 0.5;
      }

      // Calculate original total for compare-at / savings display
      let runningCompareAtTotal = 0;
      selectedProducts.forEach(product => {
        if (product.selectionSource === 'cds-selector' || product.selectionSource === 'cds-selector-2') {
          runningCompareAtTotal += ((product.price || 0) / 100) * (product.quantity || 0);
        } else if (product.compareAtPrice && product.compareAtPrice > product.price) {
          runningCompareAtTotal += ((product.compareAtPrice || 0) / 100) * (product.quantity || 0);
        } else {
          runningCompareAtTotal += ((product.price || 0) / 100) * (product.quantity || 0);
        }
      });

      let runningGiftTotal = 0;
      milestoneGifts
        .filter(gift => totalSelectedCount >= gift.count)
        .filter(gift => {
          if (gift.count === milestones.milestone1) return true;
          if (gift.count === milestones.milestone2 && milestones.milestone3 > 0 && totalSelectedCount >= milestones.milestone3) return false;
          if (gift.count === milestones.milestone3 && milestones.milestone4 > 0 && totalSelectedCount >= milestones.milestone4) return false;
          return true;
        })
        .forEach(gift => {
          if (gift.price && gift.price > 0) {
            runningGiftTotal += gift.price / 100;
          }
        });

      const baseCompareAt = (runningCompareAtTotal > runningTotal) ? runningCompareAtTotal : runningTotal;
      const compareAtWithGifts = baseCompareAt + runningGiftTotal;
      const savings = Math.max(0, compareAtWithGifts - runningTotal);
      const totalFormatted = formatMoney(runningTotal * 100);
      const savingsFormatted = formatMoney(savings * 100);
      const badgeText=document.querySelector('.kv-progress-footer-message-empty')  
  
      // Update continue button state and text. Gate strictly on scent count so a
      // diffuser-only or single-scent + diffuser selection keeps the CTA disabled.
      if (scentCount < 2) {
        continueBtn.disabled = true;
        continueBtn.textContent = scentCount === 1 ? 'Add 1 more scent' : textLabels.addScents;

        // Hide mini trigger until minimum scent count is reached
        if (miniTrigger) {
          miniTrigger.style.display = 'none';
        }
      } else {
        continueBtn.disabled = false;
        continueBtn.innerHTML = `${textLabels.addToCart}<span style="margin:0 8px;">·</span>${totalFormatted}`;
        // Show mini trigger when minimum scent count is reached
        if (miniTrigger) {
          miniTrigger.style.display = 'flex';
        }
      }
      
      // Show all skeletons first
      skeletons.forEach(skeleton => skeleton.classList.remove('hidden'));
  
      const displayItems = [];
  
      // Build product thumbnail nodes
      selectedProducts.forEach(product => {
        const wrapper = document.createElement('div');
        wrapper.className = 'kv-bundle-thumbnail-wrapper';
        wrapper.setAttribute('data-product-id', product.productId);
        
        const img = document.createElement('img');
        img.src = product.image.replace('width=600', 'width=160');
        img.alt = product.title;
        img.className = 'kv-bundle-thumbnail';
        
        const removeBtn = document.createElement('div');
        removeBtn.className = 'kv-bundle-thumbnail-remove';
        removeBtn.innerHTML = '&times;';
        removeBtn.setAttribute('data-product-id', product.productId);
        removeBtn.setAttribute('title', 'Remove');
        
        wrapper.appendChild(img);
        wrapper.appendChild(removeBtn);
        
        if (product.quantity > 1) {
          const qtyBadge = document.createElement('div');
          qtyBadge.className = 'kv-bundle-thumbnail-qty';
          qtyBadge.textContent = product.quantity;
          wrapper.appendChild(qtyBadge);
        }
        
        displayItems.push(wrapper);
      });
  
      const unlockedGifts = milestoneGifts
        .filter(gift => totalSelectedCount >= gift.count)
        .filter(gift => {
          if (gift.count === milestones.milestone1) {
            return true;
          }
          if (gift.count === milestones.milestone2 && milestones.milestone3 > 0 && totalSelectedCount >= milestones.milestone3) {
            return false;
          }
          if (gift.count === milestones.milestone3 && milestones.milestone4 > 0 && totalSelectedCount >= milestones.milestone4) {
            return false;
          }
          return true;
        })
        .sort((a, b) => a.count - b.count);
  
      unlockedGifts.forEach(gift => {
        const giftWrapper = document.createElement('div');
        giftWrapper.className = 'kv-bundle-thumbnail-wrapper kv-bundle-thumbnail-gift';
        giftWrapper.setAttribute('data-gift-count', gift.count);
  
        const giftInner = document.createElement('div');
        giftInner.className = 'kv-bundle-thumbnail-gift-inner';
  
        if (gift.image) {
          const giftImageWrapper = document.createElement('div');
          giftImageWrapper.className = 'kv-bundle-thumbnail-gift-image';
  
          const giftImage = document.createElement('img');
          giftImage.src = gift.image;
          giftImage.alt = gift.title || 'Gift';
          giftImage.loading = 'lazy';
  
          giftImageWrapper.appendChild(giftImage);
          giftInner.appendChild(giftImageWrapper);
        }
  
        if (gift.text) {
          const giftText = document.createElement('div');
          giftText.className = 'kv-bundle-thumbnail-gift-text';
          giftText.innerHTML = gift.text;
          giftInner.appendChild(giftText);
        }
  
        giftWrapper.appendChild(giftInner);
  
        // Insert gift after the threshold position
        // For example, if gift.count is 5, insert after the 5th product (at index 5)
        // Count how many actual products (not gifts) we have so far
        let productCount = 0;
        let insertIndex = 0;
        for (let i = 0; i < displayItems.length; i++) {
          if (!displayItems[i].classList.contains('kv-bundle-thumbnail-gift')) {
            productCount++;
          }
          if (productCount >= gift.count) {
            insertIndex = i + 1;
            break;
          }
        }
        
        // If we haven't reached the threshold yet, append at the end
        if (productCount < gift.count) {
          insertIndex = displayItems.length;
        }
        
        displayItems.splice(insertIndex, 0, giftWrapper);
      });
  
      // Render items into carousel, keeping skeleton order
      let lastInserted = null;
      displayItems.forEach((item, index) => {
        if (skeletons[index]) {
          carousel.insertBefore(item, skeletons[index]);
          skeletons[index].classList.add('hidden');
        } else if (skeletons.length) {
          carousel.insertBefore(item, skeletons[skeletons.length - 1]);
        } else {
          carousel.appendChild(item);
        }
        lastInserted = item;
      });
  
      // Auto-scroll carousel to last inserted element
      if (lastInserted && typeof lastInserted.scrollIntoView === 'function') {
        lastInserted.scrollIntoView({ behavior: 'smooth', inline: 'end', block: 'nearest' });
      }
      
      // Update progress bar
      updateProgressBar();
    }
  
    // Update progress bar based on product count
    function updateProgressBar() {
      const progressFill = document.getElementById('kv-progress-fill');
      const progressFooterMessage = document.getElementById('kv-progress-footer-message');
      const progressMilestones = document.querySelectorAll('.kv-progress-milestone');
      const progressFooterNormal = document.getElementById('kv-progress-footer-normal');
      const progressFooterEmpty = document.getElementById('kv-progress-footer-empty');
      
      if (!progressFill) return;
      
      // Calculate current product count (scents only, exclude diffuser / cds-cards)
      let currentCount = 0;
      selectedProducts.forEach(product => {
        if (product.selectionSource !== 'cds-selector' && product.selectionSource !== 'cds-selector-2') {
          currentCount += product.quantity;
        }
      });
      
      // Toggle footer visibility based on product selection
      if (selectedProducts.length === 0) {
        // No products selected - show empty footer
        if (progressFooterNormal) progressFooterNormal.style.display = 'none';
        if (progressFooterEmpty) progressFooterEmpty.style.display = 'block';
      } else {
        // Products are selected - show normal footer
        if (progressFooterNormal) progressFooterNormal.style.display = 'block';
        if (progressFooterEmpty) progressFooterEmpty.style.display = 'none';
      }
      
      // Calculate progress percentage based on milestone segments
      let progressPercent = 0;
      
      // Define milestone positions (matching the visual layout)
      if (currentCount === 0) {
        progressPercent = 0;
      } else if (milestones.milestone4 > 0 && currentCount >= milestones.milestone4) {
        progressPercent = 100;
      } else if (milestones.milestone3 > 0 && currentCount >= milestones.milestone3) {
        // Between milestone 3 and 4
        const denom = (milestones.milestone4 - milestones.milestone3) || 1;
        const segmentProgress = (currentCount - milestones.milestone3) / denom;
        progressPercent = 66.66 + (segmentProgress * 33.34);
      } else if (milestones.milestone2 > 0 && currentCount >= milestones.milestone2) {
        // Between milestone 2 and 3
        const denom = (milestones.milestone3 - milestones.milestone2) || 1;
        const segmentProgress = (currentCount - milestones.milestone2) / denom;
        progressPercent = 33.33 + (segmentProgress * 33.33);
      } else {
        // Between 0 and milestone 2
        const denom = milestones.milestone2 || 1;
        const segmentProgress = currentCount / denom;
        progressPercent = segmentProgress * 33.33;
      }
      
      // Update progress bar fill
      progressFill.style.width = progressPercent + '%';
      
      // Update message based on progress
      let messageText = '';
      if (currentCount === 0) {
        messageText = milestones.startText;
      } else if (milestones.milestone4 > 0 && currentCount >= milestones.milestone4) {
        messageText = milestones.completeText;
      } else if (currentCount < milestones.milestone1) {
        const remaining = milestones.milestone1 - currentCount;
        messageText = milestones.milestone1Text.replace('[count]', remaining);
      } else if (currentCount < milestones.milestone2 && milestones.milestone2 > 0) {
        const remaining = milestones.milestone2 - currentCount;
        messageText = milestones.milestone2Text.replace('[count]', remaining);
      } else if (currentCount < milestones.milestone3 && milestones.milestone3 > 0) {
        const remaining = milestones.milestone3 - currentCount;
        messageText = milestones.milestone3Text.replace('[count]', remaining);
      } else if (currentCount < milestones.milestone4 && milestones.milestone4 > 0) {
        const remaining = milestones.milestone4 - currentCount;
        messageText = milestones.milestone4Text.replace('[count]', remaining);
      }
      
      // Update footer message
      if (progressFooterMessage) {
        const span = progressFooterMessage.querySelector('span');
        if (span) {
          span.innerHTML = messageText;
        }
        
        // Make footer message clickable when count >= 3
        if (currentCount >= 3) {
          progressFooterMessage.classList.add('clickable');
        } else {
          progressFooterMessage.classList.remove('clickable');
        }
      }
      
      // Update milestone states
      progressMilestones.forEach(milestone => {
        const milestoneCount = parseInt(milestone.getAttribute('data-count'));
        if (currentCount >= milestoneCount) {
          milestone.classList.add('unlocked');
        } else {
          milestone.classList.remove('unlocked');
        }
      });
    }
  
    // Handle thumbnail remove button clicks
    document.addEventListener('click', function(e) {
      if (e.target.classList.contains('kv-bundle-thumbnail-remove')) {
        const productId = e.target.getAttribute('data-product-id');
        
        // Reset ALL instances of this product card across all tabs
        syncProductState(productId, 'remove');
        
        // Remove from selected products
        removeSelectedProduct(productId);
      }
    });
  
