            "liquid": "<!-- Pay safe with link, icon, and styling -->\n<div style=\"text-align: center; margin-top: -10px; margin-bottom: 10px;\">\n  <div style=\"display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; background-color: #f7f7f7; border-radius: 8px;\">\n\n    <!-- Lock Icon (Adjusted Size) -->\n    <svg role=\"presentation\" fill=\"none\" focusable=\"false\" stroke-width=\"2\" width=\"20\" height=\"20\" class=\"icon icon-picto-lock\" viewBox=\"0 0 24 24\">\n      <path d=\"M3.236 18.182a5.071 5.071 0 0 0 4.831 4.465 114.098 114.098 0 0 0 7.865-.001 5.07 5.07 0 0 0 4.831-4.464 23.03 23.03 0 0 0 .165-2.611c0-.881-.067-1.752-.165-2.61a5.07 5.07 0 0 0-4.83-4.465c-1.311-.046-2.622-.07-3.933-.069a109.9 109.9 0 0 0-3.933.069 5.07 5.07 0 0 0-4.83 4.466 23.158 23.158 0 0 0-.165 2.609c0 .883.067 1.754.164 2.61Z\" fill=\"currentColor\" fill-opacity=\".12\" stroke=\"currentColor\"></path>\n      <path d=\"M17 8.43V6.285A5 5 0 0 0 7 6.286V8.43\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n      <path d=\"M12 17.714a2.143 2.143 0 1 0 0-4.286 2.143 2.143 0 0 0 0 4.286Z\" stroke=\"currentColor\"></path>\n    </svg>\n\n    <!-- Text and Bold Link (2px Smaller) -->\n    <span style=\"font-size: 12px; color: var(--color-foreground);\">\n      {{ product.metafields.custom.payment_method_text_1 }}\n      <a href=\"#\" id=\"show-payment-options\" class=\"link\" style=\"color: var(--color-foreground); font-weight: bold;\">\n        {{ product.metafields.custom.payment_method_text_2 }}\n      </a>\n    </span>\n\n  </div>\n</div>\n\n\n<!-- Hidden pop-up container -->\n<div id=\"payment-popup\" style=\"\n  display: none;\n  position: fixed;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  background-color: #fff;\n  padding: 20px;\n  border: 1px solid #ccc;\n  border-radius: 12px;\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);\n  z-index: 1000;\n  max-width: 90%;\n  width: 400px;\n  text-align: center;\n\">\n  <h3 style=\"margin-top: 0; margin-bottom: 15px;\">{{ product.metafields.custom.payment_method_text_3 }}</h3>\n  <div id=\"dynamic-payment-icons\" style=\"\n    display: flex;\n    justify-content: center;\n    flex-wrap: wrap;\n    gap: 8px;\n    margin-bottom: 20px;\n  \">\n    <!-- Payment icons will be dynamically inserted here -->\n  </div>\n  <button id=\"close-popup\" class=\"button button--primary\">\n    Close\n  </button>\n</div>\n\n<!-- Overlay to darken background -->\n<div id=\"overlay\" style=\"\n  display: none;\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-color: rgba(0, 0, 0, 0.5);\n  z-index: 999;\n\"></div>\n\n<!-- JavaScript for handling pop-up functionality -->\n<script>\n  document.getElementById('show-payment-options').addEventListener('click', function(event) {\n    event.preventDefault();\n\n    // Find the payment icons in the footer\n    const footerIcons = document.querySelector('.footer__payment-icons');\n    const popupIconsContainer = document.getElementById('dynamic-payment-icons');\n\n    if (footerIcons) {\n      // Clear existing icons in the pop-up\n      popupIconsContainer.innerHTML = '';\n\n      // Clone the footer icons and append them to the pop-up container\n      const clonedIcons = footerIcons.cloneNode(true);\n      clonedIcons.classList.remove('footer__payment-icons'); // Optional: remove footer-specific styling\n      popupIconsContainer.appendChild(clonedIcons);\n    }\n\n    // Show the pop-up and overlay\n    document.getElementById('payment-popup').style.display = 'block';\n    document.getElementById('overlay').style.display = 'block';\n  });\n\n  // Close button functionality\n  document.getElementById('close-popup').addEventListener('click', function() {\n    document.getElementById('payment-popup').style.display = 'none';\n    document.getElementById('overlay').style.display = 'none';\n  });\n\n  // Overlay click to close pop-up\n  document.getElementById('overlay').addEventListener('click', function() {\n    document.getElementById('payment-popup').style.display = 'none';\n    this.style.display = 'none';\n  });\n</script>"
