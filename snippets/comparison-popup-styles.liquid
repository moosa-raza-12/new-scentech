    max-width: 800px;
    margin: auto;
    border-radius: 16px 16px 0 0;
    background: #fff;
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .cmp-scent-modal.active {
    transform: translateY(0);
  }

  .cmp-scent-modal__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
