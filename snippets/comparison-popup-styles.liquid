    z-index: 10;
    transition: background 0.2s;
    border-radius: 99px;
    background: #160000;
  }

.cmp-scent-modal__image {
    width: 100%;
    height: 420px;
    overflow: hidden;
}

.cmp-scent-modal__image img {
