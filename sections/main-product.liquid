          <buy-buttons template="{{ product.template_suffix }}" form="{{ product_form_id }}">
            {%- render 'button', type: 'submit', content: sticky_button_label, form: product_form_id, background: buy_buttons_block.settings.atc_button_background, text_color: buy_buttons_block.settings.atc_button_text_color, secondary: true, stretch: true, size: 'lg' -%}
          </buy-buttons>

          {%- if sticky_promo_enabled -%}
            <a href="{{ sp_link }}" class="sticky-promo-banner sticky-promo-banner--mobile">
