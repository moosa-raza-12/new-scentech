        function formatPreorderDateRange(stockDate) {
          const euCountries = ['AT','BG','HR','CY','CZ','DK','EE','FI','FR','GR','HU','IE','IT','LV','LT','LU','MT','PL','PT','RO','SK','SI','ES','SE'];
          let minDays, maxDays;
          switch (kvCountryCode) {
            case 'NL': minDays = kvDeliveryDays.nl; maxDays = kvDeliveryDays.nl; break;
            case 'BE': minDays = kvDeliveryDays.be; maxDays = kvDeliveryDays.be; break;
            case 'DE': minDays = kvDeliveryDays.de; maxDays = kvDeliveryDays.de; break;
            default:
              if (euCountries.includes(kvCountryCode)) {
                minDays = kvDeliveryDays.euMin;
                maxDays = kvDeliveryDays.euMax;
              } else {
                minDays = kvDeliveryDays.rowMin;
                maxDays = kvDeliveryDays.rowMax;
              }
          }
          const startDate = new Date(stockDate);
          startDate.setDate(startDate.getDate() + minDays);
          const endDate = new Date(stockDate);
          endDate.setDate(endDate.getDate() + maxDays);
          if (minDays === maxDays) {
            return `${startDate.getDate()} ${monthNames[startDate.getMonth()]}`;
          } else if (startDate.getMonth() === endDate.getMonth()) {
            return `${startDate.getDate()} - ${endDate.getDate()} ${monthNames[endDate.getMonth()]}`;
          } else {
            return `${startDate.getDate()} ${monthNames[startDate.getMonth()]} - ${endDate.getDate()} ${monthNames[endDate.getMonth()]}`;
          }
        }
  
        if (hasDateOutOfStock && latestPreorderDate) {
          console.log('DEBUG preorder:', { latestPreorderDate, kvCountryCode, kvDeliveryDays });
          preorderDatesEl.textContent = formatPreorderDateRange(latestPreorderDate);
  
          if (affectedProductsEl) {
            const itemsList = affectedItems.map(item => `${item.quantity}x ${item.title}`).join('<br>');
            affectedProductsEl.innerHTML = '<br>' + itemsList;
          }
  
          deliveryRow.style.display = '';
          infoPreorder.style.display = '';
          infoInstock.style.display = 'none';
          preorderNotice.style.display = '';
        } else if (hasDateWithStock && !hasDateOutOfStock) {
          preorderDatesEl.textContent = getInstockDeliveryDateRange();
  
          const instockCollapsed = infoInstock.querySelector('.kv-preorder-notice-collapsed');
          if (instockCollapsed) {
            const toggleLink = instockCollapsed.querySelector('.kv-preorder-toggle');
            const toggleHtml = toggleLink ? ' ' + toggleLink.outerHTML : '';
            instockCollapsed.innerHTML = getInstockCollapsedMessage() + toggleHtml;
          }
  
          deliveryRow.style.display = '';
          infoPreorder.style.display = 'none';
          infoInstock.style.display = '';
          preorderNotice.style.display = '';
        } else {
          preorderNotice.style.display = 'none';
        }
      }
    }
  
    // Format money function - dynamic currency, no hardcoded symbols
    function formatMoney(cents) {
      if (typeof cents === 'undefined' || cents === null || isNaN(cents)) {
        return '';
      }
      
      // Convert cents to amount
      const dollars = cents / 100;
      const amount = dollars.toFixed(2);
      const amountNoDecimals = Math.floor(dollars).toString();
      const amountWithCommaSeparator = dollars.toFixed(2).replace('.', ',');
      
      // Use Shopify's formatMoney if available
      if (typeof Shopify !== 'undefined' && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, moneyFormat);
      }
      
      {% raw %}
      // Fallback: manually format using the money format template
      if (moneyFormat && moneyFormat.includes('{{')) {
        let formatted = moneyFormat;
        
        // Replace placeholders in order (most specific first)
        if (formatted.includes('{{amount_with_comma_separator}}')) {
          formatted = formatted.split('{{amount_with_comma_separator}}').join(amountWithCommaSeparator);
        }
        if (formatted.includes('{{amount_no_decimals}}')) {
          formatted = formatted.split('{{amount_no_decimals}}').join(amountNoDecimals);
        }
        if (formatted.includes('{{amount}}')) {
          formatted = formatted.split('{{amount}}').join(amount);
        }
        
        return formatted;
      }
      {% endraw %}
      
      // Final fallback: return amount with currency symbol
      return `$${amount}`;
    }
  
    // Handle quantity changes in mini cart
    document.addEventListener('click', function(e) {
      // Check if clicked element or its parent is the decrease button
      const decreaseBtn = e.target.classList.contains('kv-mini-cart-qty-decrease') ? e.target : e.target.closest('.kv-mini-cart-qty-decrease');
      if (decreaseBtn) {
        const index = parseInt(decreaseBtn.getAttribute('data-index'));
        const product = selectedProducts[index];
        
        if (!product) return;
        
        if (product.quantity > 1) {
          product.quantity--;
          // Update ALL instances of this product across all tabs
          syncProductQuantity(product.productId, product.quantity);
          updateThumbnailCarousel();
          updateMiniCart();
        } else {
          // Remove product - sync across all tabs
          syncProductState(product.productId, 'remove');
          selectedProducts.splice(index, 1);
          updateThumbnailCarousel();
          updateMiniCart();
          
          // Close mini cart if no products left
          if (selectedProducts.length === 0) {
            setTimeout(() => {
              document.getElementById('kv-minicart-overlay').classList.remove('active');
              document.getElementById('kv-minicart').classList.remove('active');
              document.body.style.overflow = '';
            }, 300);
          }
        }
        return;
      }
  
      // Check if clicked element or its parent is the increase button
      const increaseBtn = e.target.classList.contains('kv-mini-cart-qty-increase') ? e.target : e.target.closest('.kv-mini-cart-qty-increase');
      if (increaseBtn) {
        const index = parseInt(increaseBtn.getAttribute('data-index'));
        const product = selectedProducts[index];
        
        if (!product) return;
        
        product.quantity++;
        // Update ALL instances of this product across all tabs
        syncProductQuantity(product.productId, product.quantity);
        updateThumbnailCarousel();
        updateMiniCart();
      }
    });
  
    // Read more / Read less toggle for pre-order notice
    document.addEventListener('click', function(e) {
      const toggle = e.target.closest('.kv-preorder-toggle');
      if (!toggle) return;
      e.preventDefault();
      const infoBlock = toggle.closest('.kv-preorder-notice-info');
      if (!infoBlock) return;
      const collapsed = infoBlock.querySelector('.kv-preorder-notice-collapsed');
      const expanded = infoBlock.querySelector('.kv-preorder-notice-expanded');
      if (toggle.dataset.action === 'expand') {
        collapsed.style.display = 'none';
        expanded.style.display = '';
        const notice = toggle.closest('.kv-mini-cart-preorder-notice');
        if (notice) {
          setTimeout(function() {
            notice.scrollIntoView({ behavior: 'smooth', block: 'end' });
          }, 50);
        }
      } else {
        collapsed.style.display = '';
        expanded.style.display = 'none';
      }
    });
</script>