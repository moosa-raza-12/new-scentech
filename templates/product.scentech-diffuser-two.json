olor":"","heading_gradient":"","product_card_background":"","product_card_text_color":""}},"image_with_text_overlay_HWKQqV":{"type":"image-with-text-overlay","blocks":{"heading_aPz8GD":{"type":"heading","settings":{"text":"Find a scent that fits your personality.","heading_tag":"h3"}},"richtext_cBiRRQ":{"type":"richtext","settings":{"content":"<p>Discover a fragrance crafted to match your unique essence and elevate your space.<\/p>"}},"button_pXhVQk":{"type":"button","settings":{"style":"fill","size":"lg","text":"Take the quiz","url":"#open-quiz-tools\/perfect-product-finder\/find-a-fragrance-that-fits-your-personality","background":"#162518","text_color":"#ffffff"}}},"block_order":["heading_aPz8GD","richtext_cBiRRQ","button_pXhVQk"],"settings":{"full_width":true,"allow_transparent_header":false,"enable_parallax":false,"image_size":"sm","image":"shopify:\/\/shop_images\/All_Scents.png","mobile_image":"shopify:\/\/shop_images\/Ontwerp_zonder_titel_75.png","mobile_text_position":"place-self-end-start text-start","desktop_text_position":"sm:place-self-end-start sm:text-start","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":30}},"testimonials_VYU7Lg":{"type":"testimonials","blocks":{"testimonial_PzExi8":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/11.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Sarah K.","title":"Finally something that works","content":"<p>I've tried some many fragrance products like scented cndles, scent sticks, mini diffusers but nothing really worked. This thing just WORKS and i'm getting lots of compliments from guests as well. My place smells amazing now<\/p>"}},"testimonial_rJiM47":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/5_bd43493d-98bc-44fb-a830-a55d05d202be.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Quint S.","title":"Bought it for my sister","content":"<p>I've never used it but my sister says this was the best gift she got all year. Uses it everyday. <\/p>"}},"testimonial_dBWF3Y":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/10_144b58fb-f06f-47c5-b27c-326eb5b2f44c.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Mari U.","title":"WOW","content":"<p>My home smells incredible after installing this diffuser. I absolutely LOVE the Endless Path fragrance. Would really recommend.<\/p>"}},"testimonial_wnyfAX":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/4_43a197de-596d-45f6-a07e-095726db5d21.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Joshua A.","title":"I don't smell my cats anymore","content":"<p>I really hated the smell of my litter box everythime i got home. This machine made my home smell incredibel so its a gamechanger for me. <\/p>"}},"testimonial_JVPp7r":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/9_b3b02d0d-29b8-4151-a346-c1fec9a3db87.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Britney V.","title":"","content":"<p>It does what is should do. Makes my place smell great!<\/p>"}},"testimonial_tR4WaR":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/6_4e7918b2-552d-4eec-8631-37ce320e9ab6.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Marian G.","title":"Adjustable intensity is great","content":"<p>I really like that I can adjust intensity. I don't really like the overpowering smell you have certain stores but with this machine I can have the same smell but adjust intensity to fit my preference. When I have guests I usually set it higher since I like it when they complement me ;)<\/p>"}},"testimonial_HVqkLa":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/7_141037e2-8f9e-49ab-8018-3f7b6a7bd92f.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Jill B.","title":"Very strong machine","content":"<p>My house is pretty open-plan, and I was skeptical about how well this would work. But honestly, it fills the whole space! I can smell it in the living room, dining area, and even the hallway.<\/p>"}},"testimonial_KwgGnP":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/3_162a5bd1-91ed-4f16-ba63-15ccb20d5024.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Sil V.","title":"Intensity feature is great","content":"<p>I didn’t think I’d use the intensity feature much, but now I can’t live without it. Some mornings I just want a light, refreshing scent, and other times I crank it up for guests. It’s so convenient!<\/p>"}},"testimonial_wyfNVj":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/8_60eabedf-5511-47e3-bd1e-8ea1a2fcd8e8.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Emma H.","title":"Cheaper than the alternatives","content":"<p>Honestly, I was spending way too much on candles and sprays that didn’t last. With this, the pod lasts me a full month, and the scents are way more luxurious. Good value for money. <\/p>"}},"testimonial_ymtr94":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/1_ebff2af6-a817-400a-96bc-8dd0e1244b83.png","round_avatar":true,"show_rating":true,"rating":5,"author":"Max S.","title":"My mom really liked the gift","content":"<p>Bought this thing for my mom and she's in love with it. She got herself 2 more for upstairs.<\/p>"}}},"block_order":["testimonial_PzExi8","testimonial_rJiM47","testimonial_dBWF3Y","testimonial_wnyfAX","testimonial_JVPp7r","testimonial_tR4WaR","testimonial_HVqkLa","testimonial_KwgGnP","testimonial_wyfNVj","testimonial_ymtr94"],"custom_css":[".h2 {font-size: 25px; \/* mobile *\/}","@media (min-width: 768px) {.h1 {font-size: 40px; \/* desktop *\/ }}"],"settings":{"full_width":true,"stack_testimonials":false,"subheading":"","title":"Join 5000+ happy customers.","content":"","link_url":"","link_text":"","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","testimonial_card_background":"","testimonial_card_text_color":""}},"faq_URc397":{"type":"faq","blocks":{"item_ahiQ9j":{"type":"item","settings":{"title":"How does the smart aroma diffuser work?","content":"<p>The diffuser uses advanced nebulizing technology to disperse pure fragrance oil into the air without water. Simply attach a ScentPod, adjust the settings via the app, and enjoy a consistent, evenly distributed scent throughout your space.<\/p>"}},"item_jJjBhV":{"type":"item","settings":{"title":"Do I need water to use this diffuser?","content":"<p>No, the diffuser is water-free. It uses pure fragrance oils, eliminating the need for water and ensuring long-lasting, potent aromas.<\/p>"}},"item_xEY7N6":{"type":"item","settings":{"title":"Can I use the diffuser in a child’s room or near pets?","content":"<p>Yes, our fragrance oils are safe when used as directed. However, we recommend keeping the diffuser out of reach of children and ensuring good ventilation in areas with pets.<\/p>"}},"item_9LjMJg":{"type":"item","settings":{"title":" Can I use the diffuser while sleeping?","content":"<p>Absolutely! You can set a timer via the app to turn the diffuser off after a set duration or reduce the intensity for nighttime use.<\/p>"}},"item_JTXxdt":{"type":"item","settings":{"title":"How large of an area does the diffuser cover?","content":"<p>The diffuser is designed to evenly scent areas up to 50 square meters, making it perfect for living rooms, bedrooms, and office spaces.<\/p>"}},"item_Ueccra":{"type":"item","settings":{"title":"How do I adjust the scent intensity and schedule?","content":"<p>You can easily control the scent intensity and schedule through the app, allowing you to customize your experience to fit your lifestyle.<\/p>"}},"item_ztixcR":{"type":"item","settings":{"title":"How long does each 50ml fragrance pod last?","content":"<p>Each 50ml pod is designed to last for one month of intensive use.<\/p>"}},"item_G9eQxb":{"type":"item","settings":{"title":"Is the diffuser covered by a warranty?","content":"<p>Yes, the scentech diffuser comes with a life-time warranty, covering any manufacturing defects. If it breaks, you'll get a new one in a matter of days. <\/p>"}},"item_zmmnCX":{"type":"item","settings":{"title":"What kind of oils can I use with this diffuser?","content":"<p>Our diffuser is specifically designed to work seamlessly with our ScentPods, which feature premium-grade fragrance oils optimized for the device. Using oils from other sources may cause clogging due to variations in oil viscosity and concentration, which can impair performance. Additionally, using non-ScentPod oils will void the product warranty.<\/p>"}}},"block_order":["item_ahiQ9j","item_jJjBhV","item_xEY7N6","item_9LjMJg","item_JTXxdt","item_Ueccra","item_ztixcR","item_G9eQxb","item_zmmnCX"],"settings":{"full_width":true,"subheading":"","title":"FAQ","content":"","team_avatar_width":160,"support_hours":"","answer_time":"","button_text":"Any more questions?","button_url":"shopify:\/\/pages\/faq","text_position":"end","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","button_background":"","button_text_color":"","accordion_background":"","accordion_text_color":""}},"173270383137dc2679":{"type":"apps","blocks":{"klaviyo_reviews_all_reviews_yCqxkA":{"type":"shopify:\/\/apps\/klaviyo-reviews\/blocks\/all-reviews\/db20e365-d984-4ac4-9655-e1588d951ca9","settings":{}},"okendo_reviews_widget_yLzRf3":{"type":"shopify:\/\/apps\/okendo\/blocks\/reviews-widget\/bb689e69-ea70-4661-8fb7-ad24a2e23c29","disabled":true,"settings":{"product":"{{product}}","widget_type":"combined_widget"}}},"block_order":["klaviyo_reviews_all_reviews_yCqxkA","okendo_reviews_widget_yLzRf3"],"settings":{"full_width":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false,"background":"","background_gradient":"","text_color":""}}},"order":["main","instant_n923s_gcpkw2_pz_pfq_UGdBVN","images_with_text_scrolling_9V68HJ","scentech_benefits_zjrKPg","image_link_blocks_dtptpf","featured_collection_3VGaxc","image_with_text_overlay_HWKQqV","testimonials_VYU7Lg","faq_URc397","173270383137dc2679"]}